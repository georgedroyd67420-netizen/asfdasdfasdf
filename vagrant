track(RunService.RenderStepped:Connect(function(dt)
    if not alive() then return end
    dt = tonumber(dt) or 0.016
    local char = LocalPlayer and LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if State.movement.NoClip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
    if hum then
        hum.WalkSpeed = State.movement.WalkSpeed
        hum.UseJumpPower = true
        hum.JumpPower = State.movement.JumpPower
    end
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if State.movement.Fly and myHrp and hum then
        hum.PlatformStand = true
        local wish = hum.MoveDirection
        local up = 0
        pcall(function()
            if UISvc:IsKeyDown(Enum.KeyCode.Space) then up = up + 1 end
            if UISvc:IsKeyDown(Enum.KeyCode.LeftShift) then up = up - 1 end
        end)
        local vel = wish * State.movement.FlySpeed + Vector3.new(0, up * State.movement.FlySpeed * 0.8, 0)
        myHrp.CFrame = myHrp.CFrame + vel * dt
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero
    elseif hum and hum.PlatformStand and not State.movement.Fly then
        hum.PlatformStand = false
    end
end))

