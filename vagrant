local crosshairFn = function(dt)
    if not alive() then
        pcall(function() RunService:UnbindFromRenderStep("DW_Crosshair") end)
        return
    end
    if not State.aim.Crosshair or not State.aim.Lock then return end
    if not botTarget or not botTarget.Parent then return end
    local part = botTarget:FindFirstChild(State.aim.AimPart)
    if not part then
        part = botTarget:FindFirstChild("Head")
            or botTarget:FindFirstChild("HumanoidRootPart")
            or botTarget:FindFirstChildWhichIsA("BasePart")
    end
    if not part then return end
    if State.aim.VisCheck then
        local myChar = LocalPlayer and LocalPlayer.Character
        local from = (myChar and myChar:FindFirstChild("Head") and myChar.Head.Position)
            or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
        if not from or not losClear(from, part) then return end
    end
    local aimPos = part.Position
    if State.aim.Lead > 0 then
        local root = botTarget:FindFirstChild("HumanoidRootPart")
        if root then
            aimPos = aimPos + (root.AssemblyLinearVelocity * State.aim.Lead)
        end
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    if State.aim.Deadzone > 0 then
        local delta = aimPos - cam.CFrame.Position
        if delta.Magnitude >= 0.01 then
            local off = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(delta.Unit), -1, 1)))
            if off < State.aim.Deadzone then return end
        end
    end
    local desired = CFrame.lookAt(cam.CFrame.Position, aimPos)
    cam.CFrame = cam.CFrame:Lerp(desired, math.clamp(dt * State.aim.Smooth, 0, 0.5))
end
