local pickTarget = function(fovDeg, maxDist, useFov, mode)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local camPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    if not (LocalPlayer and LocalPlayer.Character) then return nil end
    mode = (mode == "Lowest HP") and "Lowest HP" or "Closest"
    local function hpOf(char)
        local h = char and char:FindFirstChildOfClass("Humanoid")
        return (h and h.Health) or math.huge
    end
    if useFov == false then
        local mouse = UISvc:GetMouseLocation()
        local ok, inset = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
        if ok and inset then
            mouse = mouse - Vector2.new(inset.X, inset.Y)
        else
            mouse = mouse - Vector2.new(0, 36)
        end
        local closest, closestPx, lowestHp = nil, math.huge, math.huge
        for i, v in characters do
            if v == LocalPlayer then continue end
            local char = v
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local delta = hrp.Position - camPos
                local dist = delta.Magnitude
                if dist >= 0.01 and dist <= maxDist then
                    local vp, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    if onScreen and vp.Z > 0 then
                        if mode == "Lowest HP" then
                            local hp = hpOf(char)
                            if hp < lowestHp then
                                closest = char
                                lowestHp = hp
                            end
                        else
                            local px = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
                            if px < closestPx then
                                closest = char
                                closestPx = px
                            end
                        end
                    end
                end
            end
        end
        return closest
    end
    local closest, closestAngle, lowestHp = nil, math.huge, math.huge
    for i, v in characters do
        if v == LocalPlayer then continue end
        local char = v
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local delta = hrp.Position - camPos
            local dist = delta.Magnitude
            if dist >= 0.01 and dist <= maxDist then
                local ang = math.deg(math.acos(math.clamp(look:Dot(delta.Unit), -1, 1)))
                if ang <= fovDeg then
                    if mode == "Lowest HP" then
                        local hp = hpOf(char)
                        if hp < lowestHp then
                            closest = char
                            lowestHp = hp
                        end
                    elseif ang < closestAngle then
                        closest = char
                        closestAngle = ang
                    end
                end
            end
        end
    end
    return closest
end

local function pickStillValid(char, fovDeg, maxDist, useFov)
    if not char or not char.Parent then return false end
    local found = false
    for _, c in ipairs(characters) do if c == char then found = true break end end
    if not found then return false end
    local cam = workspace.CurrentCamera
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not cam or not hrp then return false end
    local delta = hrp.Position - cam.CFrame.Position
    if delta.Magnitude < 0.01 or delta.Magnitude > maxDist then return false end
    if useFov == false then
        local vp, onScreen = cam:WorldToViewportPoint(hrp.Position)
        return onScreen and vp.Z > 0
    end
    local ang = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(delta.Unit), -1, 1)))
    return ang <= fovDeg * 1.15
end

