local function fetchLib(url)
    local ok, body = pcall(game.HttpGet, game, url)
    return (ok and type(body) == "string" and #body > 0) and body or nil
end
-- Cache-buster: some executors cache HttpGet, which pins a stale lib.
local function bust(url)
    local sep = string.find(url, "?", 1, true) and "&" or "?"
    return url .. sep .. "t=" .. tostring(math.floor(tick() * 1000))
end
