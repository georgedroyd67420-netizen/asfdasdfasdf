local function paintBase()
    local want = {}
    if State.baseESP.TowersEnabled then
        for _, entry in ipairs(collectBaseItems("tower")) do
            if not want[entry.item] then
                want[entry.item] = { color = State.baseESP.TowersColor, tag = entry.tag }
            end
        end
    end
    if State.baseESP.WorkbenchEnabled then
        for _, entry in ipairs(collectBaseItems("bench")) do
            if not want[entry.item] then
                want[entry.item] = { color = State.baseESP.WorkbenchColor, tag = entry.tag }
            end
        end
    end
    if State.baseESP.StorageEnabled then
        for _, entry in ipairs(collectBaseItems("storage")) do
            if not want[entry.item] then
                want[entry.item] = { color = State.baseESP.StorageColor, tag = entry.tag }
            end
        end
    end
    if State.baseESP.VaultEnabled then
        for _, entry in ipairs(collectBaseItems("vault")) do
            if not want[entry.item] then
                want[entry.item] = { color = State.baseESP.VaultColor, tag = entry.tag }
            end
        end
    end
    local cam = workspace.CurrentCamera
    if not cam then return want end
    local camPos = cam.CFrame.Position
    for item, info in pairs(want) do
        local base = baseAnchor(item)
        if base then
            local hl = item:FindFirstChild("DWBaseHL")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "DWBaseHL"
                hl.Adornee = item:IsA("Model") and item or nil
                hl.FillColor = info.color
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.6
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Enabled = true
                hl.Parent = item
                track(hl)
            else
                hl.FillColor = info.color
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
            local dist = (base.Position - camPos).Magnitude
            local vp = cam:WorldToViewportPoint(base.Position)
            if dist <= State.baseESP.MaxDist and vp.Z > 0 then
                local d = baseLabels[item]
                if not d then
                    d = Drawing.new("Text")
                    d.Size = 13
                    d.Center = true
                    d.Outline = true
                    baseLabels[item] = d
                end
                d.Text = string.format("%s [%s] [%d]", item.Name, info.tag, dist)
                d.Position = Vector2.new(vp.X, vp.Y - 14)
                d.Color = info.color
                d.Visible = true
                hl.Enabled = true
            else
                local d = baseLabels[item]
                if d then d.Visible = false end
                hl.Enabled = false
            end
        end
    end
    return want
end

