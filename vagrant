    if Rock then
        for i, v in destructiblefolder:GetChildren() do
            if v.Name == "Rock" then
                table.insert(Rock, v)
                return Rock
            end
        end
    end
    if FoodCrate then
        for i, v in destructiblefolder:GetChildren() do
            if v.Name == "FoodCrate" then
                table.insert(FoodCrate, v)
                return FoodCrate
            end
        end
