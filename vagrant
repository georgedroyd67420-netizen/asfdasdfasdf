local tracked = { conns = {}, items = {}, threads = {}, fns = {} }
local function track(what)
    local t = typeof(what)
    if t == "RBXScriptConnection" then
        table.insert(tracked.conns, what)
    elseif t == "Instance" then
        table.insert(tracked.items, what)
    elseif t == "thread" then
        table.insert(tracked.threads, what)
    elseif type(what) == "function" then
        table.insert(tracked.fns, what)
    end
    return what
end

local function refreshCharacters()
    table.clear(characters)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local pc = plr.Character
            if pc and pc.Parent then
                table.insert(characters, pc)
            end
        end
    end
    return characters
end
