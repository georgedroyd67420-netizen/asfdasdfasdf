local function baseAnchor(item)
    if item:IsA("BasePart") then return item end
    if item:IsA("Model") then
        return item.PrimaryPart
            or item:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function baseNameMatch(name, kind)
    local n = string.lower(name)
    if kind == "tower" then
        return n:find("claim") ~= nil or n == "claim tower" or n:find("tower") ~= nil
    end
    if kind == "storage" then
        return n:find("stor") ~= nil or n:find("chest") ~= nil
            or n:find("stash") ~= nil
    end
    if kind == "vault" then
        return n:find("vault") ~= nil or n:find("safe") ~= nil
    end
    return n:find("workbench") ~= nil or n:find("work bench") ~= nil or n:find("grinder") ~= nil
end

local function collectBaseItems(kind)
    local found = {}
    local pb = workspace.Spawned and workspace.Spawned:FindFirstChild("PlayersBuilds")
    if pb then
        for _, owner in ipairs(pb:GetChildren()) do
            for _, b in ipairs(owner:GetChildren()) do
                if baseNameMatch(b.Name, kind) then
                    found[#found + 1] = { item = b, tag = owner.Name }
                end
            end
        end
    end
    if kind == "bench" then
        local wb = workspace:FindFirstChild("Workbenchs")
        if wb then
            for _, b in ipairs(wb:GetChildren()) do
                if baseNameMatch(b.Name, kind) then
                    found[#found + 1] = { item = b, tag = "static" }
                end
            end
        end
        local ent = workspace:FindFirstChild("Entities")
        local wbg = ent and ent:FindFirstChild("Workbenches/Grinders")
        if wbg then
            for _, b in ipairs(wbg:GetChildren()) do
                if baseNameMatch(b.Name, kind) then
                    found[#found + 1] = { item = b, tag = "wild" }
                end
            end
        end
    end
    return found
end

