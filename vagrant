local old; old = hookmetamethod(workspace,"__namecall",function(self,...)
    if not alive() then
        return old(self, ...)
    end
    local mt = getnamecallmethod()
    local args = {...}
    if not State.SilentAimEnabled then
        return old(self, ...)
    end
    if mt == "Raycast" and debug.traceback():find("BehaviourGunClient") and target then
        if math.random(100) > State.aim.HitChance then
            return old(self, ...)
        end
        local origin = args[1]
        local direction = args[2]
        args[2] = (target.Head.Position - origin)
        return old(self,unpack(args))
    end
    return old(self,...)
end)

