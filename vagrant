local function itemTypeMatches(itemName, selectedType)
    return itemName == selectedType
        or itemName:sub(1, #selectedType + 1) == selectedType .. " "
end

local function itemTypeSelected(itemName)
    for typ in pairs(State.itemESP.Names) do
        if typeof(typ) == "string" and itemTypeMatches(itemName, typ) then
            return true
        end
    end
    return false
end

