local function charOwnerName(char)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == char then
            if plr.DisplayName ~= plr.Name then
                return plr.DisplayName .. " (@" .. plr.Name .. ")"
            end
            return plr.Name
        end
    end
    return char.Name
end

local function ensurePlayerSet(char)
    local set = playerDraws[char]
    if not set then
        local name = Drawing.new("Text")
        name.Size = 13
        name.Center = true
        name.Outline = true
        local barBg = Drawing.new("Square")
        barBg.Filled = true
        barBg.Transparency = 0.5
        barBg.Color = Color3.fromRGB(0, 0, 0)
        local barFg = Drawing.new("Square")
        barFg.Filled = true
        barFg.Transparency = 0.5
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Transparency = 0.8
        tracer.Color = Color3.fromRGB(255, 255, 255)
        local hpText = Drawing.new("Text")
        hpText.Size = 11
        hpText.Center = true
        hpText.Outline = true
        set = { name = name, barBg = barBg, barFg = barFg, tracer = tracer, hpText = hpText }
        playerDraws[char] = set
    end
    return set
end

track(RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    local cam = workspace.CurrentCamera
    local showAny = State.playerESP.Names or State.playerESP.Health or State.playerESP.Tracers
    if not showAny or not cam then
        for _, set in pairs(playerDraws) do
            for _, d in pairs(set) do d.Visible = false end
        end
        return
    end
    local camPos = cam.CFrame.Position
    local seen = {}
    for _, char in ipairs(characters) do
        if char and char.Parent then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head") or hrp
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if hrp and head then
                local dist = (hrp.Position - camPos).Magnitude
                local top, topOn = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                local mid, midOn = cam:WorldToViewportPoint(hrp.Position)
                local foot, footOn = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                if dist <= State.playerESP.MaxDist and top.Z > 0 and topOn and mid.Z > 0 and midOn and foot.Z > 0 and footOn then
                    seen[char] = true
                    local set = ensurePlayerSet(char)
                    local sx, sy = top.X, top.Y
                    if State.playerESP.Names then
                        if State.playerESP.ShowDistance then
                            set.name.Text = string.format("%s [%d]", charOwnerName(char), dist)
                        else
                            set.name.Text = charOwnerName(char)
                        end
                        set.name.Size = State.playerESP.TextSize
                        set.name.Outline = State.playerESP.TextOutline
                        set.name.Position = Vector2.new(sx, sy - 14)
                        set.name.Color = State.playerESP.NameColor
                        set.name.Visible = true
                    else
                        set.name.Visible = false
                    end
                    if State.playerESP.Health and humanoid then
                        local frac = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                        local bw = State.playerESP.HealthSize
                        -- Feet-anchored with a 30px floor: far players project a ~9px bar
                        -- (measured live: 232st -> 9.2px), which reads as "missing".
                        local bh = math.max(foot.Y - top.Y, 30)
                        local baseY = foot.Y
                        local topY = baseY - bh
                        local bx = math.min(top.X, foot.X) - 8 - bw
                        set.barBg.Position = Vector2.new(bx, topY)
                        set.barBg.Size = Vector2.new(bw, bh)
                        set.barBg.Visible = true
                        local col = frac > 0.5 and Color3.fromRGB(60, 255, 90)
                            or (frac > 0.25 and Color3.fromRGB(255, 220, 60) or Color3.fromRGB(255, 60, 60))
                        local fh = bh * frac
                        set.barFg.Color = col
                        set.barFg.Position = Vector2.new(bx, baseY - fh)
                        set.barFg.Size = Vector2.new(bw, math.max(fh, 0.1))
                        set.barFg.Visible = fh > 0.5
                        if State.playerESP.HealthText then
                            set.hpText.Text = tostring(math.floor(humanoid.Health + 0.5))
                            set.hpText.Size = math.max(9, State.playerESP.TextSize - 2)
                            set.hpText.Position = Vector2.new(bx + bw / 2, topY + bh * 0.5)
                            set.hpText.Color = col
                            set.hpText.Visible = true
                        else
                            set.hpText.Visible = false
                        end
                    else
                        set.barBg.Visible = false
                        set.barFg.Visible = false
                        set.hpText.Visible = false
                    end
                    if State.playerESP.Tracers then
                        local from = State.playerESP.TracerFrom
                        local ox, oy = cam.ViewportSize.X * 0.5, cam.ViewportSize.Y
                        if from == "Center" then
                            ox, oy = cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5
                        elseif from == "Mouse" then
                            local m = UISvc:GetMouseLocation()
                            local ok, inset = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
                            if ok and inset then
                                m = m - Vector2.new(inset.X, inset.Y)
                            else
                                m = m - Vector2.new(0, 36)
                            end
                            ox, oy = m.X, m.Y
                        end
                        set.tracer.Color = State.playerESP.TracerColor
                        set.tracer.Thickness = 1
                        set.tracer.From = Vector2.new(ox, oy)
                        set.tracer.To = Vector2.new(mid.X, mid.Y)
                        set.tracer.Visible = true
                    else
                        set.tracer.Visible = false
                    end
                end
            end
        end
    end
    for char, set in pairs(playerDraws) do
        if not seen[char] then
            local gone = char.Parent == nil
            local tracked = false
            for _, c in ipairs(characters) do if c == char then tracked = true; break end end
            for _, d in pairs(set) do d.Visible = false end
            if gone or not tracked then
                for _, d in pairs(set) do pcall(function() d:Remove() end) end
                playerDraws[char] = nil
            end
        end
    end
end))

