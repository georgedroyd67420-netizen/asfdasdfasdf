local meleeRemote, meleeMsg = nil, nil
local function ensureMelee()
    if meleeRemote and meleeRemote.Parent then return meleeRemote end
    local ok, ff = pcall(function()
        return require(game:GetService("ReplicatedStorage").FrameworkFiles.FrameworkFetcher)
    end)
    if ok and ff then
        pcall(function()
            meleeRemote = ff.EventsReplication.CommunicateMelee
                or ff.EventsReplication:WaitForChild("CommunicateMelee", 5)
        end)
        pcall(function()
            meleeMsg = require(ff.MessageHandler)()
        end)
    end
    if not meleeRemote then
        pcall(function()
            meleeRemote = game:GetService("ReplicatedStorage").Events.EventsReplication.CommunicateMelee
        end)
    end
    return meleeRemote
end

track(task.spawn(function()
    while alive() do
        task.wait()
        pcall(function()
            if not State.hitAura.Enabled then return end
            local char = LocalPlayer and LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local remote = ensureMelee()
            if not remote then return end
            local origin = hrp.Position
            local radius = tonumber(State.hitAura.Radius) or 18
            local folder = workspace.Spawned and workspace.Spawned:FindFirstChild("Destructibles")
            local swung = false
            local function swingOnce()
                if swung then return end
                swung = true
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
            local function fireHit(base)
                swingOnce()
                pcall(function()
                    remote:FireServer("Hit", base, base.Position, base.Size, meleeMsg)
                end)
            end
            local function hitSet(container)
                if not container then return end
                local kids = container:GetChildren()
                local hits = {}
                for i = 1, #kids do
                    local base = baseAnchor(kids[i])
                    if base then
                        local d = (base.Position - origin).Magnitude
                        if d <= radius then
                            hits[#hits + 1] = { base, d }
                        end
                    end
                end
                table.sort(hits, function(a, b) return a[2] < b[2] end)
                for i = 1, math.min(#hits, 12) do
                    fireHit(hits[i][1])
                end
            end
            hitSet(folder)
            local foes = workspace.Spawned and workspace.Spawned:FindFirstChild("Enemies")
            hitSet(foes)
            if State.hitAura.HitPlayers then
                for _, char in ipairs(characters) do
                    if char and char.Parent then
                        local prp = char:FindFirstChild("HumanoidRootPart")
                        if prp and (prp.Position - origin).Magnitude <= radius then
                            fireHit(prp)
                        end
                    end
                end
            end
        end)
    end
end))

