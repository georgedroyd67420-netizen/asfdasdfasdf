Library:OnUnload(function()
    for _, fn in ipairs(tracked.fns) do pcall(fn) end
    for _, c in ipairs(tracked.conns) do pcall(function() c:Disconnect() end) end
    for _, inst in ipairs(tracked.items) do pcall(function() inst:Destroy() end) end
    for _, th in ipairs(tracked.threads) do pcall(task.cancel, th) end
    table.clear(tracked.conns); table.clear(tracked.items)
    table.clear(tracked.threads); table.clear(tracked.fns)
    table.clear(characters)
end)
