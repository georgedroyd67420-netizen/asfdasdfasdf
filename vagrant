local function losClear(fromPos, toPart)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = {}
    if LocalPlayer.Character then list[#list+1] = LocalPlayer.Character end
    if target then list[#list+1] = target end
    if botTarget then list[#list+1] = botTarget end
    params.FilterDescendantsInstances = list
    params.IgnoreWater = true
    local hit = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    return hit == nil
end

