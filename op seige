local function chamsSection(name, toggleFlag, colorFlag, transpFlag, onToggle, color, transp)
    local sec = VisualsSub:AddSection({ Name = name })
    sec:AddToggle({
        Name = "Enable Chams", Flag = toggleFlag, Default = false,
        Tooltip = "Highlight " .. name,
        Callback = onToggle,
    })
    sec:AddColorpicker({
        Name = "Chams Color", Flag = colorFlag, Default = color,
        Tooltip = "Chams color",
        Callback = function(c)
            if name == "Players" then
                Settings.PlrChamsColor = c
                updateHighlightCache(plrcache, Settings.PlrEnabled, c, Settings.PlrChamsTransparency)
            elseif name == "Cameras" then
                Settings.CamChamsColor = c
                updateHighlightCache(camcache, Settings.CamEnabled, c, Settings.CamChamsTransparency)
            elseif name == "Drones" then
                Settings.DroneChamsColor = c
                updateHighlightCache(dronecache, Settings.DroneEnabled, c, Settings.DroneChamsTransparency)
            else
                Settings.GadgetChamsColor = c
                updateHighlightCache(gadgetcache, Settings.GadgetEnabled, c, Settings.GadgetChamsTransparency)
            end
        end,
    })
    sec:AddSlider({
        Name = "Chams Transparency", Flag = transpFlag,
        Min = 0, Max = 1, Default = transp, Decimals = 0.1,
        Tooltip = "Chams transparency",
        Callback = function(value)
            if name == "Players" then
                Settings.PlrChamsTransparency = value
                updateHighlightCache(plrcache, Settings.PlrEnabled, Settings.PlrChamsColor, value)
            elseif name == "Cameras" then
                Settings.CamChamsTransparency = value
                updateHighlightCache(camcache, Settings.CamEnabled, Settings.CamChamsColor, value)
            elseif name == "Drones" then
                Settings.DroneChamsTransparency = value
                updateHighlightCache(dronecache, Settings.DroneEnabled, Settings.DroneChamsColor, value)
            else
                Settings.GadgetChamsTransparency = value
                updateHighlightCache(gadgetcache, Settings.GadgetEnabled, Settings.GadgetChamsColor, value)
            end
        end,
    })
    return sec
end

