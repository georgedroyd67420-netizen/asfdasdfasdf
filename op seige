local function setupObjectFolder(
    source,
    destination,
    cache,
    enabled,
    color,
    transparency
)
    if not source then
        return
    end

    for _, obj in ipairs(source:GetChildren()) do
        genericAddEsp(
            obj,
            destination,
            cache,
            enabled,
            color,
            transparency
        )
    end

    connect(source.ChildAdded, function(obj)
        genericAddEsp(
            obj,
            destination,
            cache,
            enabled,
            color,
            transparency
        )
    end)

    connect(source.ChildRemoved, function(obj)
        destroyHighlight(cache, obj)
    end)
end

