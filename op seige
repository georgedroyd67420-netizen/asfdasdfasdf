local function rebuildCharacterCache(character)
    table.clear(characterPartCache)

    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            characterPartCache[#characterPartCache + 1] = obj
        end
    end
end

local function setCharacterTransparency(value)
    for i = #characterPartCache, 1, -1 do
        local part = characterPartCache[i]

        if part.Parent then
            part.LocalTransparencyModifier = value
        else
            table.remove(characterPartCache, i)
        end
    end
end


local function rebuildViewmodelCache()
    table.clear(viewmodelPartCache)

    for _, model in ipairs(Camera:GetChildren()) do
        if model:IsA("Model") then
            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("BasePart") then
                    viewmodelPartCache[#viewmodelPartCache + 1] = obj
                end
            end
        end
    end
end

local function setViewmodelTransparency(value)
    for i = #viewmodelPartCache, 1, -1 do
        local part = viewmodelPartCache[i]

        if part.Parent then
            part.LocalTransparencyModifier = value
        else
            table.remove(viewmodelPartCache, i)
        end
    end
end

