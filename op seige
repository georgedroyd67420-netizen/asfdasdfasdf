local function isTeammate(p)
    return p ~= player and p.Team == player.Team
end

local function shouldHighlightPlayer(p)
    if p == player then
        return false
    end

    if not Settings.PlrEnabled then
        return false
    end

    if Settings.TeamCheck and isTeammate(p) then
        return false
    end

    return true
end

local function destroyHighlight(cache, key)
    local hl = cache[key]

    if hl then
        if hl.Parent then
            hl:Destroy()
        end

        cache[key] = nil
    end
end

local function createHighlight(
    obj,
    folder,
    cache,
    enabled,
    color,
    transparency
)
    if not obj then
        return
    end

    destroyHighlight(cache, obj)

    local hl = Instance.new("Highlight")

    hl.Name = obj.Name
    hl.Adornee = obj
    hl.Enabled = enabled
    hl.FillColor = color
    hl.FillTransparency = transparency
    hl.Parent = folder

    cache[obj] = hl

    return hl
end

local function addEsp(p, character)
    if p == player or not character then
        return
    end

    if not shouldHighlightPlayer(p) then
        destroyHighlight(plrcache, character)
        return
    end

    createHighlight(
        character,
        plrfolder,
        plrcache,
        true,
        Settings.PlrChamsColor,
        Settings.PlrChamsTransparency
    )
end

local function removePlayerEsp(p)
    if p and p.Character then
        destroyHighlight(plrcache, p.Character)
    end
end

local function refreshPlayerEsp()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Character then
                addEsp(p, p.Character)
            else
                removePlayerEsp(p)
            end
        end
    end
end

local function updateHighlightCache(cache, enabled, color, transparency)
    for obj, hl in pairs(cache) do
        if not obj.Parent or not hl.Parent then
            if hl.Parent then
                hl:Destroy()
            end

            cache[obj] = nil
        else
            hl.Enabled = enabled
            hl.FillColor = color
            hl.FillTransparency = transparency
        end
    end
end

local function setupPlayer(p)
