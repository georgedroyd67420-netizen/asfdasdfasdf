local defaults = {}

local function getGun(gunmod)

    local a = require(gunmod)

    if not defaults[gunmod] then
        defaults[gunmod] = {
            camRecoil = a.camRecoil,
            gunRecoil = a.gunRecoil,

            MinRecoilPower = a.MinRecoilPower,
            MaxRecoilPower = a.MaxRecoilPower,
            RecoilPowerStepAmount = a.RecoilPowerStepAmount,
            WalkMult = a.WalkMult,
            BulletDrop = a.BulletDrop,

            MinSpread = a.MinSpread,
            MaxSpread = a.MaxSpread,
            AimInaccuracyStepAmount = a.AimInaccuracyStepAmount,
            AimInaccuracyDecrease = a.AimInaccuracyDecrease,
            AimRecoilReduction = a.AimRecoilReduction,
            AimSpreadReduction = a.AimSpreadReduction,
            CanBreachDoor = a.CanBreachDoor,

            Ammo = a.Ammo,
            StoredAmmo = a.StoredAmmo,
            MaxStoredAmmo = a.MaxStoredAmmo,

            ADS_Speed = a.ADS_Speed,

            ShootRate = a.ShootRate,
            FireMode = a.FireMode
        }
    end

    return a, defaults[gunmod]
end

local function applySettings()
    for _, gun in ipairs(guns) do
        local gunmod = gmodule:FindFirstChild(gun)

        if gunmod then
            local a, default = getGun(gunmod)
            if Settings.ChangeAtt then
                a.SightAtt = Settings.ChooseSight
            end
            if Settings.ChangeAtt then
                a.BarrelAtt = Settings.ChooseBarrel
            end
            if Settings.ChangeAtt then
                a.UnderBarrelAtt = Settings.ChooseUnderBarrel
            end
            a.AvailableSight = sightOptions
            a.AvailableBarrel = barrelOptions
            a.AvailableUB = underBarrelOptions
            if Settings.NoRecoil then

                a.camRecoil = {
                    camRecoilUp = {0, 0},
                    camRecoilTilt = {0, 0},
                    camRecoilLeft = {0, 0},
                    camRecoilRight = {0, 0}
                }

                a.gunRecoil = {
                    gunRecoilUp = {0, 0},
                    gunRecoilTilt = {0, 0},
                    gunRecoilLeft = {0, 0},
                    gunRecoilRight = {0, 0}
                }

                a.MinRecoilPower = 0.25
                a.MaxRecoilPower = 1
                a.RecoilPowerStepAmount = 0
                a.WalkMult = 0
                a.BulletDrop = 0

            else

                a.camRecoil = default.camRecoil
                a.gunRecoil = default.gunRecoil
                a.MinRecoilPower = default.MinRecoilPower
                a.MaxRecoilPower = default.MaxRecoilPower
                a.RecoilPowerStepAmount = default.RecoilPowerStepAmount
                a.WalkMult = default.WalkMult
                a.BulletDrop = default.BulletDrop

            end

            if Settings.NoSpread then

                a.MinSpread = 0
                a.MaxSpread = 0
                a.AimInaccuracyStepAmount = 0
                a.AimInaccuracyDecrease = 0
                a.AimRecoilReduction = 4
                a.AimSpreadReduction = 100
                a.CanBreachDoor = true

            else

                a.MinSpread = default.MinSpread
                a.MaxSpread = default.MaxSpread
                a.AimInaccuracyStepAmount = default.AimInaccuracyStepAmount
                a.AimInaccuracyDecrease = default.AimInaccuracyDecrease
                a.AimRecoilReduction = default.AimRecoilReduction
                a.AimSpreadReduction = default.AimSpreadReduction
                a.CanBreachDoor = default.CanBreachDoor

            end

            if Settings.InfAmmo then

                a.Ammo = math.huge
                a.StoredAmmo = math.huge
                a.MaxStoredAmmo = math.huge
                a.ShellInsert = false
            else

                a.Ammo = default.Ammo
                a.StoredAmmo = default.StoredAmmo
                a.MaxStoredAmmo = default.MaxStoredAmmo

            end

            if Settings.FastADS then

                a.ADS_Speed = 0

            else

                a.ADS_Speed = default.ADS_Speed

            end

            if Settings.RapidFire then

                a.ShootRate = 5000
                a.ShootType = 3
                a.FireMode = {
                    Auto = true,
                    Burst = false,
                    ChangeFireMode = false,
                    Semi = false
                }
                a.MuzzleVelocity = 0

            else

                a.ShootRate = default.ShootRate
                a.FireMode = default.FireMode

            end
        end
    end
end

