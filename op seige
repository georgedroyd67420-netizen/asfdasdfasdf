connect(RS.RenderStepped, function()
    if Settings.DrawFov then
        FOV.Visible = true
        FOV.Radius = Settings.FOV_Radius
        FOV.Color = Settings.FOV_Color

        FOV.Position = Vector2.new(
            Camera.ViewportSize.X * 0.5,
            Camera.ViewportSize.Y * 0.5
        )
    else
        FOV.Visible = false
    end

    line.Thickness = Settings.Line_Thickness
    line.Color = Settings.Line_Color

    if not Settings.DrawLine then
        line.Visible = false
    end

    local char = player.Character

    if char and Settings.ThirdPerson then
        local head = char:FindFirstChild("Head")

        if head then
            local rotation =
                Camera.CFrame - Camera.CFrame.Position

            local offset = rotation:VectorToWorldSpace(
                Vector3.new(
                    Settings.XOffset,
                    Settings.YOffset,
                    Settings.ZOffset
                )
            )

            local cameraPosition =
                head.Position
                - rotation.LookVector * Settings.ThirdPersonDist
                + offset

            Camera.CFrame =
                CFrame.new(cameraPosition) * rotation

            setCharacterTransparency(0)

            if #viewmodelPartCache == 0 then
                rebuildViewmodelCache()
            end

            setViewmodelTransparency(1)
        end
    else
        setViewmodelTransparency(0)
    end
end)

connect(RS.Heartbeat, function(dt)

    line.Visible = false

    if not (Settings.CanAim or Settings.SilentAim) then
        return
    end
    closestTarget = nil
    local dist = math.huge
    local myTeam = player.Team

    local mx = Camera.ViewportSize.X / 2
    local my = Camera.ViewportSize.Y / 2

    local rad = Settings.FOV_Radius
    local dfov = Settings.DrawFov

    if Settings.RandomizePart
        and Settings.RandomizeParts
        and #Settings.RandomizeParts > 0 then

        Settings.AimPart =
            Settings.RandomizeParts[
                math.random(1, #Settings.RandomizeParts)
            ]
    end

    local apart = Settings.AimPart

    for _, v in ipairs(Players:GetPlayers()) do

        if v ~= player
            and (not Settings.TeamCheck or v.Team ~= myTeam) then

            local char = v.Character

            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")

                local hum = char:FindFirstChild("Humanoid")

                local pt = char:FindFirstChild(apart)

                if hrp and hum and pt and hum.Health > 0 then

                    local ppos, isOnScreen = Camera:WorldToViewportPoint(pt.Position)

                    if isOnScreen then

                        local dx = mx - ppos.X
                        local dy = my - ppos.Y

                        local mag =
                            math.sqrt(dx * dx + dy * dy)

                        if mag < dist and (not dfov or mag <= rad) then

                            dist = mag
                            closestTarget = char

                            if Settings.DrawLine then
                                line.From = Vector2.new(
                                    Camera.ViewportSize.X / 2,
                                    Camera.ViewportSize.Y / 2
                                )

                                line.To = Vector2.new(
                                    ppos.X,
                                    ppos.Y
                                )

                                line.Visible = true
                            end
                        end
                    end
                end
            end
        end
    end

    if Settings.Aiming
        and not Settings.SilentAim
        and closestTarget then

        local tpt =
            closestTarget:FindFirstChild(apart)

        if tpt then
            local smooth =
                math.max(Settings.Smoothing, 1)

            Camera.CFrame =
                Camera.CFrame:Lerp(
                    CFrame.new(
                        Camera.CFrame.Position,
                        tpt.Position
                    ),
                    1 / smooth
                )
        end
    end

    local char = player.Character

    if not char then
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if Settings.TpWalk
        and hrp
        and hum
        and hum.MoveDirection.Magnitude > 0 then

        hrp.CFrame =
            hrp.CFrame
            + hum.MoveDirection
            * Settings.TpWalkSpeed
            * dt
            * 60
    end
end)

