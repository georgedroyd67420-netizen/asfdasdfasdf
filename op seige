        if DamageEvent then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                local args = {...}

                if not checkcaller() and method == "Raycast" then
                    if Settings.SilentAim and closestTarget and debug.traceback():find("BulletRaycast") then
                        local hitPart = closestTarget.FindFirstChild(closestTarget, Settings.AimPart) or closestTarget.FindFirstChild(closestTarget, "Head") or closestTarget.FindFirstChild(closestTarget, "UpperTorso")
                        if Settings.MagicBullet then
                            return {
                                Instance = hitPart,
                                Position = hitPart.Position + Vector3.new(0.0001, 0.0001, 0.0001),
                                Normal = Vector3.new(0.0001, 0.0001, 0.0001),
                                Material = hitPart.Material,
                                Distance = 10
                            }
                        else
                            local origin = args[1]
                            local direction = args[2]
                            args[2] = (hitPart.Position - origin)
                            return oldNamecall(self, unpack(args))
                        end
                    end

                    if self == DamageEvent and Settings.DamageBooster then
                        if type(args[5]) == "table" then
                            args[5].HeadDamage = {1000, 1000}
                            args[5].TorsoDamage = {1000, 1000}
                            args[5].LimbDamage = {1000, 1000}
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end

                return oldNamecall(self, ...)
            end)
        end
    end
end

