function AR2_safetyScanChar()
    local found = {}
    local char = AR2_LocalPlayer and AR2_LocalPlayer.Character
    if not char then return found end

    pcall(function()
        for _, d in ipairs(char:GetDescendants()) do
            if not AR2_PARKOUR_NAMES[d.Name] then
                for _, cls in ipairs(AR2_SNITCH_CLASSES) do
                    if d:IsA(cls) then
                        found[#found + 1] = {
                            class = cls,
                            name  = d.Name,
                            path  = d:GetFullName(),
                            mine  = d.Name:sub(1, 4) == "AR2_",
                        }
                        break
                    end
                end
            end
        end
    end)

    return found
end

function AR2_safetyTick()
    local now = os.clock()
    if now - AR2_safetyLastScan < 2 then return end
    AR2_safetyLastScan = now

    local found = AR2_safetyScanChar()
    AR2_safetyOffenders = found

    for _, f in ipairs(found) do
        AR2_warnOnce("snitch_" .. f.class,
            ("[DROIDWARE SAFETY] %s named '%s' is on your character -- the game "):format(f.class, f.name)
            .. "reports that class name to the server every step. Move it off the "
            .. "character or use CFrame movement instead.", 10)

        if f.mine then
            pcall(function()
                Notif.new({
                    Title   = "DROIDWARE SAFETY",
                    Content = ("A hub feature put a %s on your character. That is "):format(f.class)
                        .. "reported to the server -- turn the feature off.",
                    Duration = 9,
                })
            end)
        end
    end

    pcall(function()
        local hum = AR2_LocalPlayer.Character
            and AR2_LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed > 30 then
            if not AR2_safetyWalkFlag then
                AR2_safetyWalkFlag = true
                AR2_warnOnce("snitch_walk",
                    ("[DROIDWARE SAFETY] WalkSpeed is %.1f -- anything over 30 is "):format(hum.WalkSpeed)
                    .. "reported to the server through the 'Get Inventory Width' remote.", 10)
            end
        else
            AR2_safetyWalkFlag = false
        end
    end)
end

