AR2_CAM_SAFE_DOT = 0.995
AR2_camClamped   = 0

function AR2_cameraSafeWrite(cf)
    if not AR2_Camera then return cf end

    local prev
    pcall(function() prev = AR2_Camera.CFrame.LookVector end)

    local look = cf.LookVector
    if prev and look.Magnitude > 0 then
        local d = math.clamp(prev:Dot(look.Unit), -1, 1)
        if d < AR2_CAM_SAFE_DOT then
            local axis = prev:Cross(look.Unit)
            if axis.Magnitude > 1e-6 then
                local maxAng  = math.acos(AR2_CAM_SAFE_DOT)
                local limited = (CFrame.fromAxisAngle(axis.Unit, maxAng) * prev).Unit
                cf = CFrame.new(cf.Position, cf.Position + limited)
                AR2_camClamped = AR2_camClamped + 1
            end
        end
    end

    pcall(function() AR2_Camera.CFrame = cf end)
    return cf
end

