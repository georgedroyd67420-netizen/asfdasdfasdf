function AR2_canHitModel(model)
    if not model or not model.Parent then return false end

    local now    = os.clock()
    local cached = AR2_hitCache[model]
    if cached and (now - cached.at) < 0.35 then return cached.ok end

    if AR2_hitBudget <= 0 then
        if cached then return cached.ok end
        return false
    end
    AR2_hitBudget = AR2_hitBudget - 1

    local ok = false
    pcall(function()
        local origin = AR2_Camera and AR2_Camera.CFrame.Position
        if not origin then return end

        for _, name in ipairs(AR2_HIT_PARTS) do
            local part = model:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                if not AR2_serverPathBlocked(origin, part.Position) then
                    ok = true
                    return
                end
            end
        end
    end)

    AR2_hitCache[model] = { at = now, ok = ok }
    return ok
end

function AR2_rayBoxDist(part, origin, dir, maxLen)
    local okc, cf = pcall(function() return part.CFrame end)
    if not okc or not cf then return nil end

    local h = part.Size * 0.5

    local lo = cf:PointToObjectSpace(origin)
    local ld = cf:VectorToObjectSpace(dir)
    if ld.Magnitude < 1e-6 then return nil end
    ld = ld.Unit

    local target = Vector3.new(0, 0, 0)
    local t, lp = 0, lo
    for _ = 1, 3 do
        t  = math.clamp((target - lo):Dot(ld), 0, maxLen)
        lp = lo + ld * t
        target = Vector3.new(
            math.clamp(lp.X, -h.X, h.X),
            math.clamp(lp.Y, -h.Y, h.Y),
            math.clamp(lp.Z, -h.Z, h.Z))
    end

    local dist = (lp - target).Magnitude

    local inset = Vector3.new(
        math.clamp(target.X, -h.X + 0.05, h.X - 0.05),
        math.clamp(target.Y, -h.Y + 0.05, h.Y - 0.05),
        math.clamp(target.Z, -h.Z + 0.05, h.Z - 0.05))

    return dist, t, cf:PointToWorldSpace(inset)
end

function AR2_thickFindTarget(origin, dir, maxLen, radiusOverride)
    if typeof(dir) ~= "Vector3" or dir.Magnitude < 1e-6 then return nil end
    dir    = dir.Unit
    maxLen = maxLen or 2000

    local radius = math.clamp(
        tonumber(radiusOverride) or tonumber(AR2_CFG.weapon.hbeSize) or 4, 0.1, 12)

    local myChar  = AR2_LocalPlayer and AR2_LocalPlayer.Character
    local myName  = AR2_LocalPlayer and AR2_LocalPlayer.Name

    local bestScore, bestPart, bestPoint, bestModel = math.huge, nil, nil, nil

    local function scan(container)
        if not container then return end
        for _, model in ipairs(container:GetChildren()) do
            if model:IsA("Model") and model ~= myChar and model.Name ~= myName then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    for _, name in ipairs(AR2_HBE_PARTS) do
                        local skip = AR2_CFG.weapon.hbeHeadOnly and name ~= "Head"
                        local part = (not skip) and model:FindFirstChild(name) or nil
                        if part and part:IsA("BasePart") then
                            local d, t, pt = AR2_rayBoxDist(part, origin, dir, maxLen)
                            if d and t and t > 0 and d <= radius then
                                local score = (name == "Head") and d * 0.25 or d
                                if score < bestScore then
                                    bestScore = score
                                    bestPart  = part
                                    bestPoint = pt
                                    bestModel = model
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    scan(AR2_Workspace:FindFirstChild("Characters"))
    scan(AR2_Workspace:FindFirstChild("Zombies"))

    if not bestPart then return nil end
    return bestPart, bestPoint, bestModel
end

