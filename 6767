function AR2_cosFindWardrobe()
    if type(AR2_cosWardrobe) == "table" then return AR2_cosWardrobe end
    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "table" then
            local ok = pcall(function()
                return type(rawget(obj, "DressAccessory")) == "function"
                   and type(rawget(obj, "SetHair"))        == "function"
                   and type(rawget(obj, "SetSkinColor"))   == "function"
                   and type(rawget(obj, "DressShirt"))     == "function"
            end)
            if ok then
                local good = false
                pcall(function()
                    good = type(rawget(obj, "DressAccessory")) == "function"
                       and type(rawget(obj, "SetHair"))        == "function"
                       and type(rawget(obj, "SetSkinColor"))   == "function"
                       and type(rawget(obj, "DressShirt"))     == "function"
                end)
                if good then AR2_cosWardrobe = obj return obj end
            end
        end
    end
    return nil
end

