function AR2_spreadCompensate(desiredDir, angle, serverTime, pelletIndex)
    if not angle or angle <= 1e-9 then return desiredDir end

    local out = desiredDir
    pcall(function()
        local rng = Random.new(serverTime * 10000)

        rng:NextUnitVector()
        rng:NextUnitVector()

        local pellet = math.max(tonumber(pelletIndex) or 1, 1)

        local rx, rz = 0, 0
        for _ = 1, pellet do
            rx = rng:NextNumber(0, angle)
            rz = rng:NextNumber(-math.pi, math.pi)
        end

        local u = (CFrame.Angles(0, 0, rz) * CFrame.Angles(rx, 0, 0)).LookVector
        local want = desiredDir.Unit
        local d = want

        for _ = 1, 4 do
            local got = CFrame.new(Vector3.new(), d):VectorToWorldSpace(u)
            local dot = math.clamp(got.Unit:Dot(want), -1, 1)
            local err = math.acos(dot)
            if err < 1e-6 then break end
            local axis = got.Unit:Cross(want)
            if axis.Magnitude < 1e-9 then break end
            d = (CFrame.fromAxisAngle(axis.Unit, err) * d).Unit
        end

        out = d
        AR2_spreadCompLast = math.deg(angle)
    end)
    return out
end

