function AR2_guiIsLockThing(d)
    local n = string.lower(tostring(d.Name))
    for _, w in ipairs(AR2_GUI_LOCK_WORDS) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end

function AR2_guiWardrobeRoots()
    local roots, pg = {}, AR2_LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return roots end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") then
            local n = string.lower(g.Name)
            if string.find(n, "mainmenu", 1, true)
            or string.find(n, "wardrobe", 1, true)
            or string.find(n, "character", 1, true)
            or string.find(n, "menu", 1, true) then
                roots[#roots+1] = g
            end
        end
    end
    return roots
end

function AR2_guiItemNameOf(el)
    local node = el
    for _ = 1, 4 do
        if not node then break end
        local nm = tostring(node.Name)
        if string.find(nm, "^Accessory ") or string.find(nm, "^Hat ")
        or string.find(nm, "^Vest ") or string.find(nm, "^Shirt ")
        or string.find(nm, "^Pants ") or string.find(nm, "^Belt ")
        or string.find(nm, "^Hair%d") then
            return nm
        end
        node = node.Parent
    end
    for _, d in ipairs(el:GetDescendants()) do
        if d:IsA("TextLabel") and type(d.Text) == "string" and #d.Text > 2 then
            return d.Text
        end
    end
    return nil
end

function AR2_guiMenuOpen()
    for _, root in ipairs(AR2_guiWardrobeRoots()) do
        local on = false
        pcall(function() on = root.Enabled end)
        if on then
            local vis = false
            pcall(function()
                for _, d in ipairs(root:GetChildren()) do
                    if (d:IsA("Frame") or d:IsA("ScrollingFrame")) and d.Visible then
                        vis = true break
                    end
                end
            end)
            if vis then return true end
        end
    end
    return false
end

function AR2_guiSweep()
    AR2_guiStats = { buttons = 0, locks = 0, hooks = AR2_guiStats.hooks or 0 }

    for _, root in ipairs(AR2_guiWardrobeRoots()) do
        for _, d in ipairs(root:GetDescendants()) do
            if (d:IsA("ImageLabel") or d:IsA("Frame") or d:IsA("TextLabel"))
               and AR2_guiIsLockThing(d) then
                if d.Visible then
                    pcall(function() d.Visible = false end)
                    AR2_guiStats.locks = AR2_guiStats.locks + 1
                end
            end

            if d:IsA("ImageButton") or d:IsA("TextButton") then
                pcall(function()
                    d.Active          = true
                    d.Selectable      = true
                    d.AutoButtonColor = true
                    if d:IsA("ImageButton") and d.ImageTransparency > 0.3 then
                        d.ImageTransparency = 0
                    end
                    if d:IsA("TextButton") and d.TextTransparency > 0.3 then
                        d.TextTransparency = 0
                    end
                end)
                AR2_guiStats.buttons = AR2_guiStats.buttons + 1

                if not AR2_guiHookedBtns[d] then
                    AR2_guiHookedBtns[d] = true
                    AR2_guiStats.hooks = AR2_guiStats.hooks + 1
                    d.MouseButton1Click:Connect(function()
                        if not AR2_CFG.misc.guiUnlock then return end

                        local txt = ""
                        pcall(function()
                            txt = string.lower(tostring(d.Text or d.Name))
                        end)

                        local isEquip = false
                        for _, w in ipairs(AR2_GUI_EQUIP_WORDS) do
                            if string.find(txt, w, 1, true) then isEquip = true break end
                        end

                        local item = AR2_guiItemNameOf(d)
                        if item then AR2_guiLastItem = item end

                        task.spawn(function()
                            for _ = 1, 6 do
                                task.wait(0.05)
                                if not AR2_CFG.misc.guiUnlock then return end
                                if not AR2_guiMenuOpen() then return end
                                pcall(AR2_guiSweep)
                            end
                        end)

                        local target = (isEquip and AR2_guiLastItem) or item
                        if target and (isEquip or AR2_CFG.misc.guiDressOnClick) then
                            local slot = AR2_guiSlotFor(target)
                            local ok, why = AR2_cosDress(slot, target,
                                slot == "Accessory" and 1 or nil)
                            AR2_guiNote = (ok and "worn " or "failed ")
                                .. tostring(target) .. " -- " .. tostring(why)
                        end
                    end)
                end
            end
        end
    end
end

function AR2_cosDressTargets()
    local out = {}
    local char = AR2_LocalPlayer.Character
    if char then out[#out+1] = char end

    local function collect(root, depth)
        if not root or depth > 6 then return end
        for _, d in ipairs(root:GetChildren()) do
            if d:IsA("Model") and string.find(string.lower(d.Name), "mannequin", 1, true) then
                out[#out+1] = d
            elseif d:IsA("ViewportFrame") or d:IsA("Folder") or d:IsA("ScreenGui")
                or d:IsA("Frame") or d:IsA("ScrollingFrame") or d:IsA("WorldModel") then
                collect(d, depth + 1)
            end
        end
    end

    pcall(function() collect(AR2_LocalPlayer:FindFirstChild("PlayerGui"), 0) end)
    pcall(function() collect(AR2_Workspace.CurrentCamera, 0) end)
    pcall(function()
        for _, d in ipairs(AR2_Workspace:GetChildren()) do
            if d:IsA("Model") and string.find(string.lower(d.Name), "mannequin", 1, true) then
                out[#out+1] = d
            end
        end
    end)
    return out
end

function AR2_guiSlotFor(name)
    local n = tostring(name)
    if string.find(n, "^Hair%d")    then return "Hair"  end
    if string.find(n, "^Shirt ")    then return "Shirt" end
    if string.find(n, "^Pants ")    then return "Pants" end
    if string.find(n, "^Vest ")     then return "Vest"  end
    if string.find(n, "^Belt ")     then return "Belt"  end
    if string.find(n, "^Hat ")      then return "Hat"   end
    return "Accessory"
end

function AR2_setGuiUnlock(on)
    AR2_CFG.misc.guiUnlock = on and true or false

    if AR2_guiUnlockConn then AR2_guiUnlockConn:Disconnect() AR2_guiUnlockConn = nil end
    if not AR2_CFG.misc.guiUnlock then return true, "off" end

    local nextAt, nextCheck, menuOpen = 0, 0, false
    AR2_guiUnlockConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.misc.guiUnlock then return end
        local now = os.clock()

        if now >= nextCheck then
            nextCheck = now + 0.5
            local ok, open = pcall(AR2_guiMenuOpen)
            menuOpen = ok and open or false
        end
        if not menuOpen then return end

        if now < nextAt then return end
        nextAt = now + 0.3
        pcall(AR2_guiSweep)
    end)

    pcall(AR2_guiSweep)
    return true, ("%d buttons, %d locks hidden")
        :format(AR2_guiStats.buttons, AR2_guiStats.locks)
end

function AR2_guiDump()
    local lines = { "== WARDROBE GUI ==" }
    for _, root in ipairs(AR2_guiWardrobeRoots()) do
        lines[#lines+1] = "  ScreenGui: " .. root.Name
        local n, seen, order = 0, {}, {}
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ImageButton") or d:IsA("TextButton") then
                n = n + 1
                local txt = ""
                pcall(function() if d:IsA("TextButton") then txt = tostring(d.Text or "") end end)
                local key = d.Name .. "\t" .. d.ClassName .. "\t" .. txt
                if not seen[key] then
                    seen[key] = { count = 0, name = d.Name, cls = d.ClassName,
                                  txt = txt, path = d:GetFullName() }
                    order[#order+1] = key
                end
                seen[key].count = seen[key].count + 1
            end
        end
        table.sort(order, function(a, b) return seen[a].count < seen[b].count end)
        for _, key in ipairs(order) do
            local e = seen[key]
            lines[#lines+1] = ("    x%-5d %-24s %-12s %s")
                :format(e.count, e.name, e.cls,
                        (e.txt ~= "" and ('"' .. e.txt .. '"') or ""))
            if e.count <= 3 then
                lines[#lines+1] = ("           %s"):format(e.path)
            end
        end
        lines[#lines+1] = ("    (%d buttons, %d distinct)"):format(n, #order)
    end
    lines[#lines+1] = ("  last tile picked: %s"):format(tostring(AR2_guiLastItem))
    lines[#lines+1] = ("  last result: %s"):format(tostring(AR2_guiNote))
    local txt = table.concat(lines, "\n")
    print(txt)
    pcall(function() setclipboard(txt) end)
    return txt
end


AR2_cosWorn = {}

AR2_COS_SAVESLOTS = {
    "Hat", "Accessory1", "Accessory2", "Vest", "Top", "Belt", "Bottom",
    "Backpack", "Hair",
}

function AR2_cosRecord(slot, itemName, accIndex)
    local key = slot
    if slot == "Accessory" then key = "Accessory" .. tostring(accIndex or 1)
    elseif slot == "Shirt" then key = "Top"
    elseif slot == "Pants" then key = "Bottom" end
    AR2_cosWorn[key] = itemName
    AR2_cosSerialise()
end

function AR2_cosSerialise()
    local parts = {}
    for _, k in ipairs(AR2_COS_SAVESLOTS) do
        local v = AR2_cosWorn[k]
        if type(v) == "string" and v ~= "" then
            parts[#parts+1] = k .. "=" .. v
        end
    end
    AR2_CFG.misc.outfitSave = table.concat(parts, "|")
    return AR2_CFG.misc.outfitSave
end

function AR2_cosDeserialise()
    AR2_cosWorn = {}
    local blob = tostring(AR2_CFG.misc.outfitSave or "")
    for pair in string.gmatch(blob, "[^|]+") do
        local k, v = string.match(pair, "^(.-)=(.*)$")
        if k and v and v ~= "" then AR2_cosWorn[k] = v end
    end
    return AR2_cosWorn
end

function AR2_cosSlotArgs(key)
    if key == "Accessory1" then return "Accessory", 1 end
    if key == "Accessory2" then return "Accessory", 2 end
    if key == "Top"    then return "Shirt", nil end
    if key == "Bottom" then return "Pants", nil end
    return key, nil
