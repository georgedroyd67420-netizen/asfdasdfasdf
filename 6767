end)
AR2_originalFireFunction = nil
AR2_recoilOriginalFn     = nil
AR2_spreadOriginalFn     = nil
AR2_spreadAngleOrigFn    = nil
AR2_spreadZeroFn         = function() return 0 end
AR2_spreadThetaByAmount  = {}
AR2_spreadLastAmount     = nil
AR2_spreadLastTheta      = 0
AR2_spreadTargetDir      = nil
AR2_spreadAxis           = nil

if AR2_success and AR2_Bullets and AR2_Bullets.Fire then
    AR2_originalFireFunction = AR2_Bullets.Fire

    if AR2_CAP.getupvalue then
        pcall(function()
            AR2_recoilOriginalFn = debug.getupvalue(AR2_originalFireFunction, 6)
        end)
        pcall(function()
            AR2_spreadOriginalFn = debug.getupvalue(AR2_originalFireFunction, 3)
        end)
        pcall(function()
            AR2_spreadAngleOrigFn = debug.getupvalue(AR2_originalFireFunction, 1)
        end)
    end

    local function AR2_identitySpread(rng, dir, amount, ...)
        local base = dir.Unit
        local orig = AR2_spreadOriginalFn
        local packed = table.pack(...)
        if orig then
            pcall(function()
                local dev = orig(rng, dir, amount, table.unpack(packed, 1, packed.n))
                if typeof(dev) == "Vector3" and dev.Magnitude > 0 then
                    local theta = math.acos(math.clamp(dev.Unit:Dot(base), -1, 1))
                    if theta == theta then
                        AR2_spreadLastTheta  = theta
                        AR2_spreadLastAmount = amount
                        if type(amount) == "number" then
                            AR2_spreadThetaByAmount[amount] = theta
                        end
                    end
                end
            end)
        end
        return base
    end

    AR2_Bullets.Fire = function(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        AR2_lastFireParams = {
            self = self,
            pc   = playerController,
            wi   = weaponInstance,
            wd   = weaponData,
        }
        AR2_hasRealWD      = true
        AR2_autoSeeded     = true
        AR2_autoSeeding    = false
        AR2_tryCacheAmmoRef(weaponInstance)


        pcall(function()
            AR2_gameChar = playerController and playerController.Character or nil
        end)

        AR2_fireDidRun = false

        local ok, result = pcall(function()
            local originalOrigin    = origin
            local originalDirection = direction


            local AR2_ibSavedSpd, AR2_ibSavedGrav, AR2_ibSavedDrop = nil, nil, nil
            AR2_ibEffectiveMult = 1
            if AR2_ibEnabled and weaponData then
                pcall(AR2_warnFrozenItemData, weaponData.FireConfig)
                AR2_ibEvaluate()
                pcall(function()
                    local fc = weaponData.FireConfig
                        or (weaponInstance and weaponInstance.FireConfig)
                    if type(fc) ~= "table" then return end
                    local spd = tonumber(fc.MuzzleVelocity)
                    if not spd or spd <= 0 then return end

                    AR2_ibLastSpd    = spd
                    AR2_ibShotsFired = AR2_ibShotsFired + 1
                    pcall(function()
                        local gs = AR2_ibGunStat(spd)
                        gs.shots = gs.shots + 1
                    end)

                    local dir      = direction.Unit
                    local bestDist = AR2_IB_CFG.seedDistance or 400
                    local minLat   = 6
                    local needDist = false

                    local function scanContainer(container)
                        if not container then return end
                        for _, model in ipairs(container:GetChildren()) do
                            if model:IsA("Model") then
                                local anchor = model:FindFirstChild("HumanoidRootPart")
                                    or model:FindFirstChild("Torso")
                                    or model.PrimaryPart
                                if anchor then
                                    local toT  = anchor.Position - origin
                                    local proj = toT:Dot(dir)
                                    if proj > 0 then
                                        local lat = (toT - dir * proj).Magnitude
                                        if lat < minLat then
                                            minLat            = lat
                                            bestDist          = proj
                                            AR2_ibLastHitTime = os.clock()
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if needDist then
                        scanContainer(AR2_Workspace:FindFirstChild("Characters"))
                        scanContainer(AR2_Workspace:FindFirstChild("Zombies"))
                    end

                    if needDist and minLat >= 6 then
                        pcall(function()
                            local rp = RaycastParams.new()
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            rp.FilterDescendantsInstances = { AR2_LocalPlayer.Character, AR2_Camera }
                            local h = AR2_Workspace:Raycast(origin, dir * 3000, rp)
                            if h then bestDist = (h.Position - origin).Magnitude end
                        end)
                    end

                    AR2_ibLastDist = bestDist

                    local mult
                    if AR2_ibAdapt then
                        AR2_ibSeed()
                        mult = math.min(AR2_ibMult, AR2_ibCeiling(spd))
                    else
                        mult = tonumber(AR2_CFG.weapon.instaMaxMult) or 2
                    end
                    if mult < 1 then mult = 1 end
                    if AR2_ibAdapt then
                        AR2_ibLastCapWhy = "auto"
                    elseif mult > AR2_ibSafeMax(spd) + 0.001 then
                        AR2_ibLastCapWhy = "manual>SAFE"
                    else
                        AR2_ibLastCapWhy = "manual"
                    end

                    AR2_ibEffectiveMult = mult
                    AR2_ibBoostedSpeed  = spd * mult
                    AR2_ibSavedFC   = fc
                    AR2_ibSavedSpd  = spd
                    AR2_ibSavedMod  = fc.MuzzleVelocityMod
                    AR2_ibSavedGrav = fc.ProjectileGravity

                    if not AR2_ibSwapFireConfig(weaponData, spd * mult, false) then
                        AR2_ibSwapFail = (AR2_ibSwapFail or 0) + 1
                        AR2_ibEffectiveMult = 1
                        AR2_ibBoostedSpeed  = nil
                        AR2_ibSavedFC = nil
                    end
                end)
            end

            local aimEntity, aimPart = nil, nil
            AR2_didRedirect = false
            if AR2_CFG.magicAim.on or AR2_CFG.rageBot.on then
                aimEntity, aimPart = AR2_magicTarget()
                AR2_magicAim.target = aimEntity
            end

            local pendingOrigin = nil

            if (AR2_CFG.magicAim.on or AR2_CFG.rageBot.on) and aimEntity and aimPart then
                if AR2_CFG.magicAim.originShift then
                    if aimEntity.model then
                        local headPart = aimEntity.headCollider or aimEntity.head
                        if headPart then
                            local blocked = false
                            pcall(function()
                                local rp = RaycastParams.new()
                                rp.FilterType = Enum.RaycastFilterType.Exclude
                                rp.FilterDescendantsInstances =
                                    { AR2_LocalPlayer.Character, aimEntity.model }
                                rp.IgnoreWater = true
                                blocked = AR2_Workspace:Raycast(originalOrigin,
                                    headPart.Position - originalOrigin, rp) ~= nil
                            end)

                            local newOrigin, clear = originalOrigin, false

                            local dist   = (headPart.Position - originalOrigin).Magnitude
                            local radDeg = math.clamp(tonumber(AR2_CFG.magicAim.maxBend) or 180, 0, 89)
                            local angCap = math.tan(math.rad(radDeg)) * math.max(dist, 1)
                            local maxShift = math.clamp(math.min(
                                tonumber(AR2_CFG.magicAim.originRadius)
                                    or tonumber(AR2_CFG.magicAim.originMaxShift) or 10,
                                angCap), 0, 10)

                            if blocked and maxShift > 0.01 then
                                local nudge = math.min(AR2_autoNudge(originalOrigin,
                                    originalDirection), maxShift)
                                AR2_lastNudge = nudge
                                local startAt = originalOrigin + originalDirection.Unit * nudge
                                newOrigin, clear = AR2_findBestOrigin(startAt,
                                    originalDirection, headPart.Position, aimEntity.model)

                                local delta = newOrigin - originalOrigin
                                if delta.Magnitude > maxShift then
                                    newOrigin = originalOrigin + delta.Unit * maxShift
                                end
                            end

                            if clear then
                                pendingOrigin = newOrigin
                            end
                        end
                    end
                end
                local aimFrom  = pendingOrigin or origin
                local aimPoint = AR2_predict(aimPart, aimFrom, aimEntity.velocity)

                local bend = aimPoint - aimFrom
                if bend.Magnitude > 0.001 then
                    AR2_lastBendDeg = math.deg(math.acos(
                        math.clamp(bend.Unit:Dot(originalDirection.Unit), -1, 1)))

                    local chance = AR2_CFG.magicAim.redirectChance or 100
                    if math.random(1, 100) <= chance then
                        if pendingOrigin then
                            origin = pendingOrigin
                            AR2_lastOriginAdj = (origin - originalOrigin).Magnitude
                        end
                        direction = bend.Unit
                        AR2_lastAimPos = aimPoint
                        AR2_lastAimAt  = os.clock()
                        AR2_didRedirect = true

                        if aimEntity.name then AR2_noteDamageTarget(aimEntity.name) end
                    end
                end
            end

            AR2_penSpent = 0
            AR2_lastWallsPierced = 0
            AR2_gravPrevDirY = nil

            local rageShot = AR2_rageShotActive
                or (AR2_CFG.rageBot.on and AR2_rageShotUntil > 0 and os.clock() < AR2_rageShotUntil)

            if rageShot then
                local rpart = AR2_rageShotPart
                if rpart and rpart.Parent then
                    local tvel = Vector3.zero
                    pcall(function()
                        local m   = rpart.Parent
                        local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                        if hrp then tvel = hrp.AssemblyLinearVelocity end
                    end)
                    local okp, aimPoint = pcall(AR2_predict, rpart, origin, tvel)
                    if okp and typeof(aimPoint) == "Vector3" then
                        local bend = aimPoint - origin
                        if bend.Magnitude > 0.001 then
                            direction = bend.Unit
                            local mdl = rpart.Parent
                            if mdl and mdl.Name then AR2_noteDamageTarget(mdl.Name) end
                        end
                    end
                end
            end

            local usedComp = false
            if AR2_CFG.weapon.spreadComp and AR2_installServerTimeHook() then
                pcall(function()
                    local st = AR2_Workspace:GetServerTimeNow()
                    local angle = nil
                    if AR2_spreadAngleOrigFn then
                        local okA, a = pcall(AR2_spreadAngleOrigFn,
                            playerController, weaponInstance, weaponData)
                        if okA and type(a) == "number" then angle = a end
                    end
                    if angle and angle > 1e-9 then
                        AR2_aimDirDesired = direction
                        AR2_aimDirAt      = os.clock()
                        direction = AR2_spreadCompensate(direction, angle, st, 1)
                        AR2_stForced = st
                        usedComp = true
                        AR2_spreadCompHits = (AR2_spreadCompHits or 0) + 1
                    end
                end)
            end

            AR2_spreadTargetDir, AR2_spreadAxis = nil, nil

            if AR2_spreadAngleOrigFn and AR2_CAP.setupvalue then
                pcall(debug.setupvalue, AR2_originalFireFunction, 1, AR2_spreadAngleOrigFn)
            end

            if AR2_CFG.weapon.noRecoil and AR2_CAP.setupvalue then
                pcall(function()
                    debug.setupvalue(AR2_originalFireFunction, 6,
                        function(...) return Vector2.new(0,0), 0, 0, 0, 0 end)
                end)
            elseif AR2_CFG.weapon.recoilReduction and AR2_CFG.weapon.recoilReduction > 0 and AR2_CAP.setupvalue then
                local reduction = AR2_CFG.weapon.recoilReduction / 100
                if AR2_recoilOriginalFn then
                    local function newRecoil(...)
                        local x, y, z, a, b = AR2_recoilOriginalFn(...)
                        return Vector2.new(x.X*(1-reduction), x.Y*(1-reduction)),
                               z*(1-reduction), a*(1-reduction), b*(1-reduction), 0
                    end
                    pcall(debug.setupvalue, AR2_originalFireFunction, 6, newRecoil)
                end
            else
                if AR2_recoilOriginalFn and AR2_CAP.setupvalue then
                    pcall(debug.setupvalue, AR2_originalFireFunction, 6, AR2_recoilOriginalFn)
                end
            end

            if AR2_CFG.weapon.wallbang then
                local penFields = {
                    "Penetration","PenetrationPower","WallPenetration",
                    "WallPenetrationPower","PierceCount","Piercing",
                    "BulletPenetration","ArmorPenetration","PenPower",
                }
                for _, f in ipairs(penFields) do
                    pcall(function() weaponData[f] = 9999 end)
                end
                pcall(function() weaponData.CanPenetrate    = true end)
                pcall(function() weaponData.PenetrateWalls  = true end)
                pcall(function() weaponData.IgnoreArmor     = true end)
                pcall(function()
                    if weaponData.FireConfig then
                        weaponData.FireConfig.Penetration = 9999
                        weaponData.FireConfig.PenetrationPower = 9999
                    end
                end)
            end


            if AR2_CFG.misc.shotLogger or AR2_ibEnabled then
                pcall(function()
                    local tp = (aimPart and aimPart.Position)
                        or (AR2_rageShotPart and AR2_rageShotPart.Parent and AR2_rageShotPart.Position)
                    local dist = tp and (tp - origin).Magnitude or (AR2_ibLastDist or 0)
                    AR2_shotLogOpen(dist, AR2_lastOriginAdj or 0, 0, 0, origin)
                    AR2_lastOriginAdj = 0
                end)
            end

            AR2_bulletCastUntil = os.clock() + 1.5

            AR2_hbeCandPart, AR2_hbeCandPoint = nil, nil
            if AR2_CFG.weapon.hbeOn then
                pcall(function()
                    local radius = math.clamp(tonumber(AR2_CFG.weapon.hbeSize) or 4, 0.1, 12)
                    local pt, po = AR2_thickFindTarget(origin, direction, 3000, radius)
                    AR2_hbeCandPart, AR2_hbeCandPoint = pt, po
                end)
            end

            local fireOk, fireRes = pcall(AR2_originalFireFunction,
                self, playerController, weaponInstance, weaponData, origin, direction, shotId)
            AR2_fireDidRun = true

            AR2_stForced = nil
            pcall(AR2_ibRestoreFireConfig)
            AR2_ibSavedFC = nil

            if not fireOk then
                AR2_fireErrCount = (AR2_fireErrCount or 0) + 1
                AR2_fireErrLast  = tostring(fireRes)
                error(fireRes, 0)
            end

            local result = fireRes

            AR2_lastShotOrigin = origin
            AR2_lastShotAt     = os.clock()

            if AR2_tracersEnabled then
                local drawDir = direction
                if AR2_aimDirDesired and (os.clock() - (AR2_aimDirAt or 0)) < 0.2 then
                    drawDir = AR2_aimDirDesired
                end
                AR2_addTracer(origin, drawDir)
            end

            if AR2_CFG.hitmarker.enabled
               and not (AR2_CFG.misc.srvDrivenFX and AR2_dmgListenerOn) then
                local _rp=RaycastParams.new()
                _rp.FilterType=Enum.RaycastFilterType.Exclude
                _rp.FilterDescendantsInstances={AR2_LocalPlayer.Character}
                local _hit=AR2_Workspace:Raycast(origin,direction*2000,_rp)
                local _det=false
                if _hit and _hit.Instance then
                    local _m=_hit.Instance
                    while _m and not _m:IsA("Model") do _m=_m.Parent end
                    if _m then
                        _det=(AR2_Characters~=nil and _m.Parent==AR2_Characters)
                            or(ZombiesFolder~=nil and _m.Parent==ZombiesFolder)
                            or _m:FindFirstChildOfClass("Humanoid")~=nil
                    end
                end
                if _det then AR2_hitmarkerFlag=true end
            end

            return result
        end)
        if not ok then
            AR2_stForced = nil
            pcall(AR2_ibRestoreFireConfig)
            AR2_ibSavedFC = nil

            AR2_warnOnce("firehook", "[fire] hook error: " .. tostring(result), 5)

            if AR2_fireDidRun then return nil end
            return AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        end
        return result
    end
end


AR2_hbeVisuals     = {}
AR2_hbeHookInstalled = false
AR2_hbeReentry     = false
AR2_hbeFolder      = nil

local function AR2_getHbeFolder()
    if AR2_hbeFolder and AR2_hbeFolder.Parent then return AR2_hbeFolder end
    AR2_hbeFolder = Instance.new("Folder")
    AR2_hbeFolder.Name = "origin_hbe"
    AR2_hbeFolder.Parent = AR2_Workspace
    return AR2_hbeFolder
end

local function AR2_hbeIsLocalPlayer(character)
    if not character then return false end
    if character == AR2_LocalPlayer.Character then return true end
    if AR2_Players:GetPlayerFromCharacter(character) == AR2_LocalPlayer then return true end
    if character.Name == AR2_LocalPlayer.Name then return true end
    return false
end

local function AR2_hbeAddVisual(character)
    if not AR2_CFG.weapon.hbeVisual then return end
    if AR2_hbeVisuals[character] then return end
    if AR2_hbeIsLocalPlayer(character) then return end
    if not character:FindFirstChildOfClass("Humanoid") then return end

    local realHead = character:FindFirstChild("Head")
    if not realHead then return end

    local charRoot = character:FindFirstChild("HumanoidRootPart") or realHead
    if (charRoot.Position - AR2_localPosition()).Magnitude > 2000 then return end


    local v = Instance.new("Part")
    v.Name         = "HeadHitbox"
    v.Size         = Vector3.new(
        AR2_CFG.weapon.hbeSize,
        AR2_CFG.weapon.hbeSize,
        AR2_CFG.weapon.hbeSize)
    v.Transparency = AR2_CFG.weapon.hbeVisual and 0.75 or 1
    if AR2_CFG.weapon.hbeVisual then
        v.Material = Enum.Material.ForceField
        v.Color    = (AR2_CFG.ui and AR2_CFG.ui.accent) or Color3.fromRGB(230, 30, 40)
    end
    v.CanCollide   = false
    v.CanTouch     = false
    v.CanQuery     = false
    v.Massless     = true
    v.Anchored     = true
    v.CastShadow   = false
    v:SetAttribute("ar2_hbe", true)
    v:SetAttribute("ar2_hbe_owner", character.Name)
    pcall(function() v.CollisionGroupId = realHead.CollisionGroupId end)
    v.CFrame       = realHead.CFrame
    v.Parent       = AR2_getHbeFolder()

    AR2_hbeVisuals[character] = v


    local guardConn
    guardConn = AR2_RunService.Heartbeat:Connect(function()
        if not v or not v.Parent or not realHead or not realHead.Parent then
            if v and v.Parent then v:Destroy() end
            if guardConn then guardConn:Disconnect() end
            AR2_hbeVisuals[character] = nil
            return
        end
        v.CFrame = realHead.CFrame
        if AR2_CollectionService:HasTag(v, "Bullets Penetrate") then
            AR2_CollectionService:RemoveTag(v, "Bullets Penetrate")
        end
    end)

    character.AncestryChanged:Connect(function()
        if not character.Parent then
            if v and v.Parent then v:Destroy() end
            if guardConn then guardConn:Disconnect() end
            AR2_hbeVisuals[character] = nil
        end
    end)
end

function AR2_hbeScan()
    if not AR2_Characters then return end
    local localRoot = AR2_localPosition()
    for _, model in ipairs(AR2_Characters:GetChildren()) do
        if model:IsA("Model") and not AR2_hbeIsLocalPlayer(model) then
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if root then
                if (root.Position - localRoot).Magnitude <= 2000 then
                    AR2_hbeAddVisual(model)
                else
                    local v = AR2_hbeVisuals[model]
                    if v then v:Destroy() AR2_hbeVisuals[model] = nil end
                end
            end
        end
    end
end

function AR2_hbeRemoveAll()
    for char, v in pairs(AR2_hbeVisuals) do
        if v and v.Parent then v:Destroy() end
        AR2_hbeVisuals[char] = nil
    end
    AR2_hbeVisuals = {}
    if AR2_hbeFolder and AR2_hbeFolder.Parent then AR2_hbeFolder:Destroy() AR2_hbeFolder = nil end
end

function AR2_hbeUpdateSizes()
    for _, v in pairs(AR2_hbeVisuals) do
        if v and v.Parent then
            v.Size = Vector3.new(
                AR2_CFG.weapon.hbeSize,
                AR2_CFG.weapon.hbeSize,
                AR2_CFG.weapon.hbeSize)
            v.Transparency = AR2_CFG.weapon.hbeVisual and 0.75 or 1
        end
    end
end

function AR2_hbeInstallHook()
    if AR2_hbeHookInstalled then return end
    if not (AR2_CAP.getrawmetatable and AR2_CAP.setreadonly and AR2_CAP.getnamecallmethod) then
        AR2_logHook("HBE", false, "missing getrawmetatable/setreadonly/getnamecallmethod")
        return
    end
    AR2_hbeHookInstalled = true

    local ok, err = pcall(function()
    local mt = getrawmetatable(game)
    local originalNC = mt.__namecall
    setreadonly(mt, false)


    local rawRaycast = workspace.Raycast

    mt.__namecall = newcclosure(function(self, ...)
        -- PERF: cheapest guards first. getnamecallmethod() is a C call into the
        -- engine and this closure runs on EVERY namecall in the game, so calling
        -- it unconditionally taxed every :FindFirstChild/:IsA/:GetChildren even
        -- with HBE off. Table lookup + pointer compare short-circuit first now.
        if AR2_CFG.weapon.hbeOn and self == workspace
           and os.clock() < (AR2_bulletCastUntil or 0)
           and not AR2_hbeReentry
           and not AR2_wbInPierce
           and getnamecallmethod() == "Raycast" then
            local origin, direction, params = ...

            if typeof(origin) == "Vector3" and params and typeof(params) == "RaycastParams" then
                local filter = params.FilterDescendantsInstances
                if filter and #filter >= 1 then
                    local hasChars = false
                    for _, inst in ipairs(filter) do
                        if inst == AR2_Characters
                        or (inst.Name == "Characters" and inst.ClassName == "Folder") then
                            hasChars = true
                            break
                        end
                    end

                    if hasChars then
                        local cleaned = {}
                        for _, inst in ipairs(filter) do
                            if inst ~= AR2_Characters
                            and not (inst.Name == "Characters" and inst.ClassName == "Folder") then
                                table.insert(cleaned, inst)
                            end
                        end
                        local selfChar = AR2_LocalPlayer.Character
                        if selfChar then
                            table.insert(cleaned, selfChar)
                        end
                        params.FilterDescendantsInstances = cleaned
                    end
                end
            end

            local result = originalNC(self, ...)


            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
               and direction.Magnitude > 1e-6 then
                local okH   = true
                local hPart  = AR2_hbeCandPart
                local hPoint = AR2_hbeCandPoint

                if hPoint and (hPoint - origin).Magnitude > direction.Magnitude then
                    hPart, hPoint = nil, nil
                end

                local filtered = false
                if okH and hPart and params then
                    pcall(function()
                        for _, inst in ipairs(params.FilterDescendantsInstances) do
                            if hPart == inst or hPart:IsDescendantOf(inst) then
                                filtered = true
                                break
                            end
                        end
                    end)
                end

                if okH and hPart and hPoint and not filtered then
                    AR2_hbeSwaps = (AR2_hbeSwaps or 0) + 1
                    return {
                        Instance = hPart,
                        Position = hPoint,
                        Normal   = (result and result.Normal) or Vector3.new(0, 1, 0),
                        Material = (result and result.Material) or Enum.Material.Plastic,
                        Distance = (hPoint - origin).Magnitude,
                    }
                end
            end

            return result
        end


        return originalNC(self, ...)
    end)

    setreadonly(mt, true)
    end)
    if not ok then AR2_logHook("HBE", false, tostring(err)) return end
    AR2_logHook("HBE", true)

    if AR2_Characters then
        AR2_Characters.ChildAdded:Connect(function(model)
            if not model:IsA("Model") then return end
            if not AR2_CFG.weapon.hbeOn then return end
