function AR2_rtNote(shotEntry)
    if not AR2_rangeTest.running then return end
    if not shotEntry or shotEntry.blocked then return end
    AR2_rangeTest.shots = AR2_rangeTest.shots + 1
    if shotEntry.reg == true then AR2_rangeTest.hits = AR2_rangeTest.hits + 1 end
    if shotEntry.dist then table.insert(AR2_rangeTest.dists, shotEntry.dist) end
end

function AR2_rtStop(report)
    if not AR2_rangeTest.running then return end
    AR2_rangeTest.running = false

    if AR2_rangeTest.saved then
        local c, sv = AR2_CFG, AR2_rangeTest.saved
        c.magicAim.on          = sv.silent
        c.magicAim.originShift = sv.origin
        c.weapon.spreadComp    = sv.spread
        AR2_setWallbangAll(sv.wall)
        AR2_rangeTest.saved = nil
        pcall(AR2_refreshUI)
    end

    if not report then return end

    local lines = { "== ORIGIN AR2 RANGE TEST ==  " .. os.date(), "" }
    table.sort(AR2_rangeTest.results, function(x, y) return x.rate > y.rate end)
    for _, r in ipairs(AR2_rangeTest.results) do
        lines[#lines + 1] = string.format("  %-26s  %3d%%  (%d/%d)  avg %.0fm",
            r.name, math.floor(r.rate * 100 + 0.5), r.hits, r.shots, r.dist)
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "Highest reg rate at top. The first setup that drops sharply"
    lines[#lines + 1] = "is the feature the server is rejecting."

    local text = table.concat(lines, "\n")
    print(text)
    pcall(function() if AR2_writefile then AR2_writefile("ORIGIN_AR2_RANGETEST.txt", text) end end)
    AR2_notify("Range test done -- ORIGIN_AR2_RANGETEST.txt", 8)
end

function AR2_rtStart()
    if AR2_rangeTest.running then AR2_rtStop(false) return end

    local c = AR2_CFG
    AR2_rangeTest.saved = {
        silent = c.magicAim.on, origin = c.magicAim.originShift,
        spread = c.weapon.spreadComp, wall = c.weapon.wallbang,
    }
    AR2_rangeTest.running = true
    AR2_rangeTest.results = {}
    AR2_rangeTest.idx = 0

    local setups = AR2_rtSetups()
    local need = math.max(3, AR2_CFG.misc.rangeTestShots or 8)
    AR2_rangeTest.need = need

    task.spawn(function()
        for i, setup in ipairs(setups) do
            if not AR2_rangeTest.running then break end
            AR2_rangeTest.idx = i
            AR2_rangeTest.shots, AR2_rangeTest.hits = 0, 0
            AR2_rangeTest.dists = {}
            pcall(setup.apply, AR2_CFG)
            pcall(AR2_refreshUI)
            AR2_notify(string.format("[%d/%d] %s -- fire %d shots",
                i, #setups, setup.name, need), 4)

            local deadline = os.clock() + 90
            while AR2_rangeTest.running
              and AR2_rangeTest.shots < need
              and os.clock() < deadline do
                task.wait(0.2)
            end
            if not AR2_rangeTest.running then break end

            local shots = math.max(1, AR2_rangeTest.shots)
            local sum = 0
            for _, d in ipairs(AR2_rangeTest.dists) do sum = sum + d end
            table.insert(AR2_rangeTest.results, {
                name  = setup.name,
                hits  = AR2_rangeTest.hits,
                shots = AR2_rangeTest.shots,
                rate  = AR2_rangeTest.hits / shots,
                dist  = #AR2_rangeTest.dists > 0 and (sum / #AR2_rangeTest.dists) or 0,
            })
        end
        AR2_rtStop(true)
    end)
end

