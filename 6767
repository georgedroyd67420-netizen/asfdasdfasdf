function AR2_isDamageTarget(inst)
    if not inst then return false end
    local ok, res = pcall(function()
        local node = inst
        for _ = 1, 8 do
            if not node or node == AR2_Workspace then return false end
            local parent = node.Parent
            if parent then
                local pn = parent.Name
                if pn == "Characters" or pn == "Zombies" or pn == "Vehicles" then return true end
            end
            node = parent
        end
        return false
    end)
    return ok and res or false
end

local function AR2_penThickness(inst, hitPos, dir)
    local thick = 0.5
    pcall(function()
        local far = hitPos + dir.Unit * 80
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Include
        rp.FilterDescendantsInstances = { inst }
        local back = AR2_Workspace:Raycast(far, hitPos - far, rp)
        if back then
            local t = (back.Position - hitPos).Magnitude
            if t > 0.01 then thick = t end
        end
    end)
    return thick
end

function AR2_serverFilterSkips(part)
    local skip = false
    pcall(function()
        if not part or not part:IsA("BasePart") then skip = true return end
        if part:HasTag("Bullets Penetrate") and not part:GetAttribute("ar2_tagged") then
            skip = true return
        end
        if part:HasTag("World Mesh") then skip = true return end
        if part.CollisionGroup == "Loot" then skip = true return end
        if part.Transparency == 1 and part.CanCollide == false then skip = true return end
    end)
    return skip
end

function AR2_serverPathBlocked(origin, dest)
    local blocker = nil
    pcall(function()
        local ignore = {}
        local myChar = AR2_LocalPlayer.Character
        if myChar then ignore[#ignore + 1] = myChar end
        if AR2_hbeFolder then ignore[#ignore + 1] = AR2_hbeFolder end

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = ignore

        local from = origin
        for _ = 1, 16 do
            local seg = dest - from
            local len = seg.Magnitude
            if len <= 0.15 then return end

            local hit = AR2_Workspace:Raycast(from, seg, rp)
            if not hit then return end
            if AR2_isDamageTarget(hit.Instance) then return end
            if not AR2_serverFilterSkips(hit.Instance) then
                blocker = hit.Instance
                return
            end

            ignore[#ignore + 1] = hit.Instance
            rp.FilterDescendantsInstances = ignore
            from = hit.Position + seg.Unit * 0.05
        end
    end)
    return blocker
end

function AR2_findLegalOrigin(origin, dest)
    local blocked = AR2_serverPathBlocked(origin, dest)
    if not blocked then return origin, 0, nil end

    local c       = AR2_CFG.rageBot
    local steps   = math.clamp(math.floor(tonumber(c.originWalkSteps) or 6), 2, 12)
    local minOff  = math.clamp(tonumber(c.originWalkMin) or 2, 0.5, 50)
    local back    = origin - dest
    local total   = back.Magnitude
    if total <= minOff then return origin, 0, blocked end
    back = back.Unit

    local lo, hi, best = minOff, total, nil
    for _ = 1, steps do
        local mid  = (lo + hi) * 0.5
        local cand = dest + back * mid
        if AR2_serverPathBlocked(cand, dest) then
            hi = mid
        else
            best = cand
            lo = mid
        end
    end

    if best then return best, (origin - best).Magnitude, nil end

    local cand = dest + back * minOff
    return cand, (origin - cand).Magnitude, AR2_serverPathBlocked(cand, dest)
end

