AR2_fcOn       = false
AR2_fcConn     = nil
AR2_fcInputs   = nil
AR2_fcCF       = nil
AR2_fcSavedType, AR2_fcSavedSubject = nil, nil
AR2_fcKeys     = {}

function AR2_freecamSet(on)
    on = on and true or false
    if on == AR2_fcOn then return end
    AR2_fcOn = on

    local cam = AR2_Workspace.CurrentCamera
    if not cam then AR2_fcOn = false return end

    if not on then
        if AR2_fcConn then pcall(function() AR2_fcConn:Disconnect() end) AR2_fcConn = nil end
        if AR2_fcInputs then
            for _, c in ipairs(AR2_fcInputs) do pcall(function() c:Disconnect() end) end
            AR2_fcInputs = nil
        end
        pcall(function()
            cam.CameraType    = AR2_fcSavedType or Enum.CameraType.Custom
            cam.CameraSubject = AR2_fcSavedSubject
            AR2_UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end)
        AR2_fcKeys = {}
        return
    end

    AR2_fcSavedType    = cam.CameraType
    AR2_fcSavedSubject = cam.CameraSubject
    AR2_fcCF           = cam.CFrame

    pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)

    local yaw, pitch = 0, 0
    do
        local lv = AR2_fcCF.LookVector
        yaw   = math.atan2(-lv.X, -lv.Z)
        pitch = math.asin(math.clamp(lv.Y, -1, 1))
    end

    AR2_fcInputs = {}

    AR2_fcInputs[#AR2_fcInputs + 1] = AR2_UserInputService.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.UserInputType == Enum.UserInputType.Keyboard then
            AR2_fcKeys[i.KeyCode] = true
        end
    end)

    AR2_fcInputs[#AR2_fcInputs + 1] = AR2_UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Keyboard then
            AR2_fcKeys[i.KeyCode] = nil
        end
    end)

    AR2_fcInputs[#AR2_fcInputs + 1] = AR2_UserInputService.InputChanged:Connect(function(i, gpe)
        if gpe then return end
        if i.UserInputType == Enum.UserInputType.MouseWheel then
            local sp = (tonumber(AR2_CFG.misc.freecamSpeed) or 60) + i.Position.Z * 10
            AR2_CFG.misc.freecamSpeed = math.clamp(sp, 5, 500)
        end
    end)

    AR2_fcConn = AR2_RunService.RenderStepped:Connect(function(dt)
        if not AR2_fcOn then return end
        local c = AR2_Workspace.CurrentCamera
        if not c then return end

        pcall(function() AR2_UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition end)

        local d = AR2_UserInputService:GetMouseDelta()
        yaw   = yaw - d.X * 0.0045
        pitch = math.clamp(pitch - d.Y * 0.0045, -1.5, 1.5)

        local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)

        local speed = tonumber(AR2_CFG.misc.freecamSpeed) or 60
        if AR2_fcKeys[Enum.KeyCode.LeftShift] then speed = speed * 3 end

        local move = Vector3.new(0, 0, 0)
        if AR2_fcKeys[Enum.KeyCode.W] then move = move + Vector3.new(0, 0, -1) end
        if AR2_fcKeys[Enum.KeyCode.S] then move = move + Vector3.new(0, 0,  1) end
        if AR2_fcKeys[Enum.KeyCode.A] then move = move + Vector3.new(-1, 0, 0) end
        if AR2_fcKeys[Enum.KeyCode.D] then move = move + Vector3.new( 1, 0, 0) end

        local vert = 0
        if AR2_fcKeys[Enum.KeyCode.Space] then vert = vert + 1 end
        if AR2_fcKeys[Enum.KeyCode.LeftControl] or AR2_fcKeys[Enum.KeyCode.Q] then
            vert = vert - 1
        end

        local pos = AR2_fcCF.Position
        if move.Magnitude > 0 then
            pos = pos + (rot * move.Unit) * speed * dt
        end
        pos = pos + Vector3.new(0, vert * speed * dt, 0)

        AR2_fcCF = CFrame.new(pos) * rot
        pcall(function() c.CFrame = AR2_fcCF end)
    end)
end

