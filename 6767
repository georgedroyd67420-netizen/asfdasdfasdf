function AR2_cosSetEnabled(on)
    AR2_cosEnabled      = on and true or false
    AR2_CFG.misc.cosUnlock = AR2_cosEnabled
    AR2_cosRendering    = false

    if AR2_cosGlobalConn then AR2_cosGlobalConn:Disconnect() AR2_cosGlobalConn = nil end

    local bv = AR2_cosUnlockValue()
    if not bv then
        AR2_cosNote = "Globals.AllCosmeticsUnlocked not found"
        return false
    end

    if not AR2_cosEnabled then
        pcall(function() bv.Value = AR2_cosOrigUnlock == true end)
        AR2_cosNote = "off"
        return true
    end

    if AR2_cosOrigUnlock == nil then AR2_cosOrigUnlock = bv.Value end
    pcall(function() bv.Value = true end)

    local okG, whyG = AR2_cosSetGlobalFlag(true)
    AR2_cosGlobalNote = whyG
    task.spawn(function()
        while AR2_cosEnabled do
            pcall(AR2_cosSetGlobalFlag, true)
            task.wait(0.5)
        end
    end)

    AR2_cosGlobalConn = bv.Changed:Connect(function(v)
        if AR2_cosEnabled and v ~= true then
            pcall(function() bv.Value = true end)
        end
    end)
    task.spawn(function()
        while AR2_cosEnabled do
            pcall(function()
                if bv.Parent and bv.Value ~= true then bv.Value = true end
            end)
            task.wait(0.25)
        end
    end)

    local wr = AR2_cosFindWardrobe()
    if not wr then
        AR2_cosNote = "unlocked (wardrobe not resolved)"
        return true
    end

    if AR2_CFG.misc.cosLearn then
        pcall(AR2_installNetHook)
        local okC, whyC = AR2_cosCalibrate()
        local okI, whyI = AR2_cosLearnInbound()
        AR2_cosNote = okC and ("unlocked, learning: " .. tostring(whyC)
                               .. (okI and ("; " .. tostring(whyI)) or ""))
                           or "unlocked, no calibration"
    else
        AR2_cosNote = "unlocked (learn mode off)"
    end
    return true
end

AR2_COS_MATCH = {
    Hat       = { "^Hat ", "hat", "helmet", "cap", "ushanka", "beanie", "boonie", "hood" },
    Accessory = { "^Accessory " },
    Vest      = { "^Vest ", "plate carrier", "rig" },
    Shirt     = { "^Shirt " },
    Belt      = { "^Belt ", "pouch" },
    Backpack  = { "^Backpack ", "^Bag ", "rucksack", "duffle", "duffel" },
    Pants     = { "^Pants " },
    Hair      = { "^Hair%d" },
    Face      = { "^Face" },
}

function AR2_cosCatalogue(category)
    local pats = AR2_COS_MATCH[category]
    local list, seen = {}, {}
    pcall(function()
        local assets = AR2_ReplicatedStorage:FindFirstChild("Assets")
        for _, folder in ipairs({ "Items", "LootModels" }) do
            local f = assets and assets:FindFirstChild(folder)
            if f then
                for _, m in ipairs(f:GetChildren()) do
                    local n, hit = m.Name, false
                    if pats then
                        for _, pat in ipairs(pats) do
                            if string.sub(pat, 1, 1) == "^" then
                                if string.match(n, pat) then hit = true break end
                            elseif string.find(string.lower(n), pat, 1, true) then
                                hit = true break
                            end
                        end
                    elseif string.find(n, "^" .. tostring(category)) then
                        hit = true
                    end
                    if hit and not seen[n] then seen[n] = true list[#list+1] = n end
                end
            end
        end
    end)
    if #list == 0 then return { "(none found)" } end
    table.sort(list)
    table.insert(list, 1, "None")
    return list
end


AR2_cosEquipLog = AR2_cosEquipLog or {}
AR2_cosLearned  = {}
AR2_cosHookedWR = {}
AR2_cosEquipLog = {}

AR2_COS_FNS = { "DressAccessory", "DressShirt", "DressPants", "SetHair",
                      "DressFromLoadout", "ApplyLoadout", "UndressSlot" }

function AR2_cosLogLine(s)
    AR2_cosEquipLog[#AR2_cosEquipLog+1] = tostring(s)
    if #AR2_cosEquipLog > 60 then table.remove(AR2_cosEquipLog, 1) end
end

AR2_COS_SLOTWORDS = {
    Hat=true, Hair=true, Mask=true, Shirt=true, Pants=true, Face=true,
    Accessory=true, Top=true, Bottom=true, Vest=true, Belt=true,
}
function AR2_cosFindNameIdx(a)
    local idx = nil
    for i = 1, a.n do
        local v = a[i]
        if type(v) == "string" and v ~= "" and not AR2_COS_SLOTWORDS[v] then
            idx = i
        end
    end
    return idx
end

function AR2_cosCalibrate()
    local wr = AR2_cosFindWardrobe()
    if not wr then return false, "wardrobe not found" end

    local n = 0
    for _, name in ipairs(AR2_COS_FNS) do
        local orig = rawget(wr, name)
        if type(orig) == "function" and not AR2_cosHookedWR[name] then
            AR2_cosHookedWR[name] = orig
            local wrapped = function(...)
                local a = table.pack(...)

                if not AR2_cosLearned[name] then
                    local types = {}
                    for i = 1, a.n do types[i] = typeof(a[i]) end
                    AR2_cosLearned[name] = {
                        args    = a,
                        n       = a.n,
                        nameIdx = AR2_cosFindNameIdx(a),
                        types   = table.concat(types, ", "),
                        selfIs  = (a[1] == wr) and "self" or typeof(a[1]),
                        instName = nil,
                    }
                    for i = 1, a.n do
                        if typeof(a[i]) == "Instance" then
                            AR2_cosLearned[name].instName = a[i].Name
                            AR2_cosLearned[name].instIdx  = i
                            break
                        end
                    end
                    AR2_cosLogLine(("learned %s(%s) nameIdx=%s instance=%s")
                        :format(name,
                                AR2_cosLearned[name].types,
                                tostring(AR2_cosLearned[name].nameIdx),
                                tostring(AR2_cosLearned[name].instName)))
                end

                local res = table.pack(pcall(orig, table.unpack(a, 1, a.n)))
                if not res[1] then
                    AR2_cosLastErr = tostring(res[2])
                    AR2_cosLogLine(name .. " errored: " .. AR2_cosLastErr)
                    return nil
                end
                return table.unpack(res, 2, res.n)
            end
            pcall(function() rawset(wr, name, wrapped) end)
            n = n + 1
        end
    end
    return true, ("wrapped %d functions"):format(n)
end

AR2_COS_SLOTFN = {
    Top = "DressShirt", Shirt = "DressShirt",
    Bottom = "DressPants", Pants = "DressPants",
    Hat = "DressAccessory", Vest = "DressAccessory",
    Belt = "DressAccessory", Backpack = "DressAccessory",
    Accessory = "DressAccessory",
    Hair = "SetHair",
}
AR2_COS_SLOTKEY = {
    Shirt = "Top", Pants = "Bottom", Top = "Top", Bottom = "Bottom",
    Hat = "Hat", Vest = "Vest", Belt = "Belt", Backpack = "Backpack",
}

function AR2_cosDress(slot, itemName, accIndex)
    local wr = AR2_cosFindWardrobe()
    if not wr then return false, "wardrobe not found" end

    local char = AR2_LocalPlayer.Character
    if not char then return false, "no character" end

    local fnName = AR2_COS_SLOTFN[slot]
    if not fnName then return false, "unknown slot " .. tostring(slot) end

    local fn = (AR2_cosHookedWR and AR2_cosHookedWR[fnName]) or rawget(wr, fnName)
    if type(fn) ~= "function" then return false, fnName .. " missing" end

    if not itemName or itemName == "" or itemName == "None"
       or string.find(itemName, "^%(") then
        local key = (slot == "Accessory")
            and ("Accessory" .. tostring(accIndex or 1))
            or AR2_COS_SLOTKEY[slot]
        if key then return AR2_cosUndress(key) end
        return false, "nothing to undress for " .. tostring(slot)
    end

    local targets = AR2_CFG.misc.dressPreviews and AR2_cosDressTargets() or { char }
    local done, lastErr = 0, nil

    for _, target in ipairs(targets) do
        local ok, err
        if slot == "Accessory" then
            ok, err = pcall(fn, wr, target, itemName, "Accessory" .. tostring(accIndex or 1))
        elseif fnName == "SetHair" then
            local colour = math.floor(tonumber(AR2_CFG.misc.hairColor) or 1)
            ok, err = pcall(fn, wr, target, itemName, colour)
        else
            ok, err = pcall(fn, wr, target, itemName)
        end
        if ok then done = done + 1 else lastErr = err end
    end

    if done > 0 then
        pcall(AR2_cosRecord, slot, itemName, accIndex)
        return true, ("%s on %d rig%s%s"):format(fnName, done,
            done == 1 and "" or "s",
            slot == "Accessory" and (" [Accessory" .. tostring(accIndex or 1) .. "]") or "")
    end
    return false, tostring(lastErr)
end

function AR2_cosUndress(slotName)
    local wr = AR2_cosFindWardrobe()
    if not wr then return false, "wardrobe not found" end
    local fn = (AR2_cosHookedWR and AR2_cosHookedWR["UndressSlot"]) or rawget(wr, "UndressSlot")
    if type(fn) ~= "function" then return false, "UndressSlot missing" end

    local char = AR2_LocalPlayer.Character
    if not char then return false, "no character" end

    local L = AR2_cosLearned and AR2_cosLearned["UndressSlot"]
    local a
    if L then
        a = {}
        for i = 1, L.n do
            local v = L.args[i]
            if typeof(v) == "Instance" then a[i] = char
            elseif type(v) == "string" then a[i] = slotName
            else a[i] = v end
        end
    else
        a = { wr, char, slotName }
    end

    local ok, err = pcall(fn, table.unpack(a, 1, #a))
    if ok then return true, "undressed " .. tostring(slotName) end
    return false, tostring(err)
end

