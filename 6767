    if #found == 0 then
        lines[#lines + 1] = "movers on character : none (clean)"
    else
        lines[#lines + 1] = ("movers on character : %d REPORTED TO SERVER"):format(#found)
        for _, f in ipairs(found) do
            lines[#lines + 1] = ("   %-18s %s%s"):format(f.class, f.path, f.mine and "   <- hub" or "")
        end
    end

    pcall(function()
        local hum = AR2_LocalPlayer.Character
            and AR2_LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            lines[#lines + 1] = ("WalkSpeed           : %.1f%s")
                :format(hum.WalkSpeed, hum.WalkSpeed > 30 and "   <- REPORTED (>30)" or "")
        end
    end)

    if AR2_safetyRbCount > 0 then
        lines[#lines + 1] = ("rubberbands         : %d (last %.0fs ago)")
            :format(AR2_safetyRbCount, os.clock() - AR2_safetyRbAt)
        if AR2_safetyRbFeatures and #AR2_safetyRbFeatures > 0 then
            lines[#lines + 1] = "   active then      : " .. table.concat(AR2_safetyRbFeatures, ", ")
        end
    else
        lines[#lines + 1] = "rubberbands         : 0"
    end

    lines[#lines + 1] = ("Fire errors         : %d"):format(AR2_fireErrCount or 0)

    lines[#lines + 1] = ("lead skipped (unver): %d%s")
        :format(AR2_predictSkipped or 0,
            (AR2_speedVerified == false) and "   <- speed UNVERIFIED right now" or "")

    local known = 0
    for _ in pairs(AR2_speedByWeapon or {}) do known = known + 1 end
    lines[#lines + 1] = ("weapon speeds known : %d"):format(known)
    if AR2_CFG.misc.fly and AR2_flyDrift then
