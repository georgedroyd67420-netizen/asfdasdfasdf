    if not (part and part:IsA("BasePart")) then return false end

    local existing = nil
    pcall(function() existing = AR2_entitiesLib:Search(part) end)
    if existing then return false end

    local ent = nil
    local ok = pcall(function()
        AR2_fakeWindowN = AR2_fakeWindowN + 1
        ent = AR2_entitiesLib:Register("Window", part, "ar2_win_" .. AR2_fakeWindowN, {})
    end)
    if not ok or type(ent) ~= "table" then return false end

    local okI = pcall(function() ent.Interact = function() return true end end)
    if not okI then return false end

    AR2_fakeWindows[part] = ent
    AR2_fakeWindowOk = (AR2_fakeWindowOk or 0) + 1
    return true
end

