local function AR2_acquireBone(i)
    local l = AR2_skelPool[i]
    if not l then
        l = Drawing.new("Line")
        l.Thickness, l.Transparency, l.Visible = 1, 1, false
        AR2_skelPool[i] = l
    end
    return l
