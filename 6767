function AR2_getBulletGravity()
    if AR2_CFG.weapon.noDrop then return 0 end
    if AR2_ibEnabled and AR2_ibFlatten then return 0 end

    local g = nil

    pcall(function()
        local fw = require(AR2_ReplicatedFirst:WaitForChild("Framework", 10))
        local G  = fw.require("Configs", "Globals") or fw.Configs.Globals
        if type(G) == "table" and type(G.ProjectileGravity) == "number" then
            g = math.abs(G.ProjectileGravity)
        end
    end)

    if not g or g <= 0 then
        if AR2_measuredGravity and AR2_measuredGravity > 0.5 then
            g = AR2_measuredGravity
        end
    end

    if not g or g <= 0 then
        local okUv = pcall(function()
            local cfg = AR2_resolveGravTable and AR2_resolveGravTable() or nil
            if cfg and type(cfg.ProjectileGravity) == "number" then
                g = math.abs(cfg.ProjectileGravity)
            end
        end)
        if not okUv then g = nil end
    end

    if not g or g <= 0 then g = 31.392 end

    AR2_gravUsed = g
    return g
end

function AR2_predict(part, origin, velocity)
    if not part then return origin end
    local speed = AR2_getBulletSpeed()
    if not speed or speed <= 0 then return part.Position end

    if AR2_speedVerified == false then
        AR2_predictSkipped = (AR2_predictSkipped or 0) + 1
        return part.Position
    end
    velocity = velocity or Vector3.zero
    local c = AR2_CFG.magicAim


    local g = 0
    if c.dropComp then
        g = AR2_getBulletGravity()
    end


    local vy = velocity.Y
    if math.abs(vy) < 12 then vy = 0 end


    local hx, hz = velocity.X, velocity.Z
    if math.sqrt(hx * hx + hz * hz) < 2 then hx, hz = 0, 0 end

    local vLead = Vector3.new(hx, vy, hz)

    local maxSpeed = tonumber(AR2_CFG.magicAim.maxLeadSpeed) or 120
    if vLead.Magnitude > maxSpeed then
        vLead = vLead.Unit * maxSpeed
    end

    local base   = part.Position
    local point  = base
    local flight = (point - origin).Magnitude / speed
    local drop   = Vector3.new(0, 0, 0)

    for _ = 1, 8 do
        drop  = (g > 0) and Vector3.new(0, g * flight * flight, 0)
                        or Vector3.new(0, 0, 0)
        point = base + vLead * flight + drop

        local newFlight = (point - origin).Magnitude / speed
        if math.abs(newFlight - flight) < 0.001 then break end
        flight = newFlight
    end

    local leadVec = vLead * flight
    local leadCap = tonumber(AR2_CFG.magicAim.maxLeadStuds) or 60
    if leadVec.Magnitude > leadCap then
        leadVec = leadVec.Unit * leadCap
    end

    return base + leadVec + drop
end

AR2_lastNudge = 0

function AR2_autoNudge(origin, direction)
    local MAXN = 5
    local n = 0
    pcall(function()
        local dir = direction.Unit

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        rp.FilterDescendantsInstances = {
            AR2_LocalPlayer.Character,
            AR2_Workspace:FindFirstChild("Characters"),
            AR2_Workspace:FindFirstChild("Zombies"),
            AR2_Workspace:FindFirstChild("Effects"),
        }

        local hit = AR2_Workspace:Raycast(origin, dir * MAXN, rp)
        if not hit then return end

        local far  = origin + dir * (MAXN + 2)
        local back = RaycastParams.new()
        back.FilterType = Enum.RaycastFilterType.Include
        back.FilterDescendantsInstances = { hit.Instance }

        local exit = AR2_Workspace:Raycast(far, origin - far, back)
        if not exit then return end

        local d = (exit.Position - origin).Magnitude + 0.15
        if d <= MAXN then n = d end
    end)
    return n
end

-- PERF: the direction table is built ONCE at load instead of allocating 28
-- Vector3s + running a 27-iteration triple loop on every single shot.
-- Order is byte-identical to the original so the chosen origin never changes.
local AR2_ORIGIN_DIRS = (function()
    local d = {
        Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,1,0), Vector3.new(0,-1,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1)
    }
    for x=-1,1 do for y=-1,1 do for z=-1,1 do
        if math.abs(x)+math.abs(y)+math.abs(z) > 1 then d[#d+1] = Vector3.new(x,y,z).Unit end
    end end end
    return d
end)()
-- reused across calls; only the filter list changes
local AR2_originRayParams = RaycastParams.new()
AR2_originRayParams.FilterType = Enum.RaycastFilterType.Exclude

-- PERF (the actual win, with zero reg cost): the 840-ray worst case only happens
-- when NOTHING is clear. Successful shifts early-out in the first few steps.
-- Firing at 600 RPM re-ran that same hopeless search 10x/sec from nearly the
-- same spot at the same target, and the answer doesn't change in 100ms. So we
-- memo the result briefly instead of shortening the search. Full search range,
-- full step resolution, identical result -- just not recomputed every bullet.
-- TTL must exceed the fire interval or every shot lands in a fresh window and
-- the memo never hits (600 RPM = a shot every 0.100s). 0.25s covers ~2-3 shots.
-- Set to 0 from the UI to disable memoisation entirely (max freshness).
AR2_originMemo = { key = nil, at = 0, origin = nil, ok = false }
AR2_lastOriginRays = 0

function AR2_findBestOrigin(origin, direction, targetPos, targetChar)
    local maxRadius = math.clamp(
        tonumber(AR2_CFG.magicAim.originRadius)
            or tonumber(AR2_CFG.magicBullet.searchRadius) or 10, 0, 10)
    if maxRadius <= 0 then return origin, false end

    local ttl = tonumber(AR2_CFG.magicAim.originMemo)
    if ttl == nil then ttl = 0.25 end
    local memo = AR2_originMemo
    local key
    if ttl > 0 then
        -- 1-stud buckets so the memo survives small movement; move (or the
        -- target moves) a stud and we re-search at full resolution.
        key = ("%d_%d_%d|%d_%d_%d|%s"):format(
            origin.X//1, origin.Y//1, origin.Z//1,
            targetPos.X//1, targetPos.Y//1, targetPos.Z//1,
            tostring(targetChar))
        if memo.key == key and (os.clock() - memo.at) < ttl then
            AR2_lastOriginRays = 0
            if memo.ok then return memo.origin, true end
            return origin, false
        end
    end

    local rayParams = AR2_originRayParams
    rayParams.FilterDescendantsInstances = { AR2_LocalPlayer.Character, targetChar }

    local dirs  = AR2_ORIGIN_DIRS
    local nDirs = #dirs
    local fwd, back = direction.Unit, -direction.Unit

    -- SAME step resolution and SAME full range as the original. No truncation.
    local stepSize = math.max(0.3, maxRadius/30)
    local used = 0

    for step = stepSize, maxRadius, stepSize do
        for i = 1, nDirs + 2 do
            local dir = (i <= nDirs) and dirs[i] or (i == nDirs+1 and fwd or back)
            local newOrigin = origin + dir*step
            local delta = targetPos - newOrigin
            if delta.Magnitude > 1e-4 then
                used += 1
                if not AR2_Workspace:Raycast(newOrigin, delta, rayParams) then
                    AR2_lastOriginRays = used
                    if key then memo.key, memo.at, memo.origin, memo.ok = key, os.clock(), newOrigin, true end
                    return newOrigin, true
                end
            end
        end
    end

    AR2_lastOriginRays = used
    if key then memo.key, memo.at, memo.origin, memo.ok = key, os.clock(), nil, false end
    return origin, false
end

function AR2_magicTarget()
    local cam = Workspace.CurrentCamera
    local c = AR2_CFG.magicAim
    local camCF  = cam.CFrame
    local camPos = camCF.Position
    local aimDir = camCF.LookVector

    local limit = c.ignoreFov and 180 or (tonumber(c.maxBend) or 180)
    local best, bestPart, bestScore = nil, nil, limit
    local pool = {}
    if c.players then
        for _, e in ipairs(AR2_api.players()) do
            local isTeammate = false
            if c.noTeammate and e.player then
                if AR2_isSquadmate(e.player) then isTeammate = true end
            end
            if not isTeammate then pool[#pool+1] = e end
        end
    end
    if c.zombies then for _, e in ipairs(AR2_api.zombies()) do pool[#pool+1] = e end end
    for _, entity in ipairs(pool) do
        if entity.distance <= c.maxDist then
            local part = AR2_aimPartOf(entity, c.part)
            if part then
                local to = part.Position - camPos
                if to.Magnitude > 1e-4 then
                    local angle = math.deg(math.acos(
                        math.clamp(aimDir:Dot(to.Unit), -1, 1)))

                    if angle <= bestScore then
                        if not c.visCheck or AR2_isVisible(entity.model, part) then
                            best, bestPart, bestScore = entity, part, angle
                        end
                    end
                end
            end
        end
    end
    return best, bestPart
end

function AR2_magicUpdate()
    pcall(function() if AR2_applyServerSync then AR2_applyServerSync() end end)
    local shouldRun = AR2_CFG.magicAim.on and (AR2_CFG.magicAim.showFov or AR2_CFG.magicAim.showLockLine)
    if shouldRun and not AR2_magicConn then
        if not AR2_hasDrawing then return end
        AR2_magicCircle = Drawing.new("Circle")
        AR2_magicCircle.Thickness, AR2_magicCircle.Filled, AR2_magicCircle.Transparency = 1, false, 1
        AR2_magicCircle.NumSides, AR2_magicCircle.Visible = 64, true
        AR2_magicLockLine = Drawing.new("Line")
        AR2_magicLockLine.Thickness, AR2_magicLockLine.Transparency, AR2_magicLockLine.Visible = 1, 1, false
        AR2_magicConn = AR2_RunService.RenderStepped:Connect(function()
            local cam = Workspace.CurrentCamera
            local centre = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
            local entity, part = AR2_magicTarget()
            AR2_magicAim.target = entity
            if AR2_CFG.magicAim.showFov then
                AR2_magicCircle.Position = centre
                local degPerPx = cam.FieldOfView / math.max(cam.ViewportSize.Y, 1)
                local deg      = tonumber(AR2_CFG.magicAim.maxBend) or 180
                AR2_magicCircle.Radius = math.clamp(
                    deg / math.max(degPerPx, 1e-6), 4, cam.ViewportSize.Y)
                AR2_magicCircle.Color = AR2_magicAim.target and Color3.fromRGB(255,80,90) or Color3.fromRGB(150,90,200)
                AR2_magicCircle.Visible = true
            else AR2_magicCircle.Visible = false end
            if AR2_CFG.magicAim.showLockLine then
                if part then
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and screenPos.Z > 0 then
                        AR2_magicLockLine.From = centre
                        AR2_magicLockLine.To = Vector2.new(screenPos.X, screenPos.Y)
                        AR2_magicLockLine.Color = Color3.fromRGB(255,80,90)
                        AR2_magicLockLine.Visible = true
                    else AR2_magicLockLine.Visible = false end
                else AR2_magicLockLine.Visible = false end
            else AR2_magicLockLine.Visible = false end
        end)
    elseif not shouldRun and AR2_magicConn then
        AR2_magicConn:Disconnect()
        AR2_magicConn = nil
        if AR2_magicCircle then AR2_magicCircle.Visible = false end
        if AR2_magicLockLine then AR2_magicLockLine.Visible = false end
    end
end

function AR2_toggleWorldwide(enabled)
    AR2_CFG.magicAim.ignoreFov = enabled
    AR2_magicUpdate()
end


local AR2_antiAimConn   = nil
local AR2_antiAimCenter = nil
local AR2_antiAimAngle  = 0

function AR2_startAntiAim()
    if AR2_antiAimConn then return end
    local root = AR2_tpRoot()
    if not root then return end
    AR2_antiAimCenter = root.Position
    AR2_antiAimAngle  = 0
    AR2_antiAimConn = AR2_RunService.Heartbeat:Connect(function(dt)
        if not AR2_CFG.misc.antiAim.enabled then AR2_stopAntiAim() return end
        local r = AR2_tpRoot()
        if not r then return end
        local c = AR2_CFG.misc.antiAim
        local offset
        if c.mode == "Jitter" then
            local angle = math.random() * math.pi * 2
            local dist  = math.random() * c.radius
            offset = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
        else
            AR2_antiAimAngle = (AR2_antiAimAngle + dt * c.speed * (math.pi * 2)) % (math.pi * 2)
            offset = Vector3.new(math.cos(AR2_antiAimAngle) * c.radius, 0, math.sin(AR2_antiAimAngle) * c.radius)
        end
        r.CFrame                   = CFrame.new(AR2_antiAimCenter + offset)
        r.AssemblyLinearVelocity   = Vector3.zero
        r.AssemblyAngularVelocity  = Vector3.zero
    end)
end

function AR2_stopAntiAim()
    AR2_CFG.misc.antiAim.enabled = false
    if AR2_antiAimConn then AR2_antiAimConn:Disconnect() AR2_antiAimConn = nil end
    local r = AR2_tpRoot()
    if r and AR2_antiAimCenter then
        r.CFrame = CFrame.new(AR2_antiAimCenter)
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    AR2_antiAimCenter = nil
end

function AR2_toggleAntiAim(enabled)
    AR2_CFG.misc.antiAim.enabled = enabled
    if enabled then AR2_startAntiAim() else AR2_stopAntiAim() end
end


