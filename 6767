AR2_tpTravel = { active = false, dest = nil, note = "idle" }

function AR2_tpTravelTo(destPos, label)
    if typeof(destPos) ~= "Vector3" then return false, "no destination" end
    local char = AR2_LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false, "no character" end

    AR2_tpTravel.dest   = destPos
    AR2_tpTravel.note   = "travelling to " .. tostring(label or "target")
    AR2_tpTravel.active = true

    task.spawn(function()
        local wasFly = AR2_CFG.misc.fly
        if AR2_CFG.tp.travelFly and not wasFly then pcall(AR2_setFly, true) end

        local anchored = false
        local maxStep  = math.clamp(tonumber(AR2_CFG.tp.travelStep) or 120, 5, 800)
        local speed    = math.clamp(tonumber(AR2_CFG.tp.travelSpeed) or 4000, 100, 30000)
        local deadline = os.clock() + 20

        while AR2_tpTravel.active and os.clock() < deadline do
            local dt = AR2_RunService.Heartbeat:Wait()
            local c  = AR2_LocalPlayer.Character
            local r  = c and c:FindFirstChild("HumanoidRootPart")
            if not r then break end

            local delta = AR2_tpTravel.dest - r.Position
            local dist  = delta.Magnitude
            if dist <= 4 then break end

            if AR2_CFG.tp.travelAnchor and not r.Anchored then
                pcall(function() r.Anchored = true end)
                anchored = true
            end

            local step    = math.min(speed * dt, maxStep, dist)
            local nextPos = r.Position + delta.Unit * step
            pcall(function()
                r.CFrame = CFrame.new(nextPos, nextPos + delta.Unit)
                r.AssemblyLinearVelocity = (dt > 0) and (delta.Unit * (step / dt)) or Vector3.zero
            end)
        end

        if anchored then
            pcall(function()
                local c = AR2_LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then r.Anchored = false end
            end)
            if AR2_CFG.misc.autoResume then pcall(AR2_legalResume, 0.4) end
        end

        if AR2_CFG.tp.travelFly and not wasFly then pcall(AR2_setFly, false) end

        AR2_tpTravel.active = false
        AR2_tpTravel.note   = "arrived"
    end)

    return true, AR2_tpTravel.note
end

function AR2_tpStopTravel()
    AR2_tpTravel.active = false
    AR2_tpTravel.note   = "stopped"
    pcall(function()
        local c = AR2_LocalPlayer.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then r.Anchored = false end
    end)
    return true, "stopped"
end

function AR2_tpWalkToPlayer()
    local wanted = AR2_CFG.tp.target
    if not wanted or wanted == "-" or wanted == "None" then
        return false, "pick a player first"
    end

    local plr = AR2_Players:FindFirstChild(wanted)
    local char = plr and plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false, wanted .. " has no character" end

    local cf = root.CFrame
    local dest = (cf * CFrame.new(
        tonumber(AR2_CFG.tp.side)   or 0,
        tonumber(AR2_CFG.tp.above)  or 0,
        tonumber(AR2_CFG.tp.behind) or 0
    )).Position

    return AR2_tpTravelTo(dest, wanted)
end





