function AR2_sightDump()
    local lines = { "== SIGHT RECON ==" }

    if AR2_gunBuilder then
        local names = {}
        pcall(function()
            for k, v in pairs(AR2_gunBuilder) do
                if type(k) == "string" and type(v) == "function" then names[#names+1] = k end
            end
        end)
        table.sort(names)
        lines[#lines+1] = "  GunBuilder functions:"
        for _, n in ipairs(names) do
            local info
            pcall(function() info = debug.getinfo(AR2_gunBuilder[n]) end)
            lines[#lines+1] = ("    %-22s params=%s")
                :format(n, tostring(info and info.numparams or "?"))
        end
    else
        lines[#lines+1] = "  GunBuilder NOT resolved"
    end

    local gc = AR2_resolveGameCharacter()
    local item = gc and gc.EquippedItem
    if not item then
        lines[#lines+1] = "  nothing equipped"
    else
        lines[#lines+1] = ("  equipped: %s"):format(tostring(rawget(item, "Name") or "?"))
        local att
        pcall(function() att = item.Attachments end)
        if type(att) == "table" then
            lines[#lines+1] = "  Attachments:"
            for k, v in pairs(att) do
                lines[#lines+1] = ("    %-14s = %s  (%s)")
                    :format(tostring(k), tostring(v), typeof(v))
            end
            local okW = pcall(function() att.__ar2probe = 1 end)
            pcall(function() att.__ar2probe = nil end)
            lines[#lines+1] = ("  Attachments writable: %s"):format(tostring(okW))
        else
            lines[#lines+1] = "  item has no Attachments table"
        end

        local fc
        pcall(function() fc = item.FireConfig end)
        lines[#lines+1] = ("  FireConfig present: %s"):format(tostring(type(fc) == "table"))
    end

    local seen = {}
    lines[#lines+1] = "  attachment-looking assets (first 30):"
    pcall(function()
        local assets = AR2_ReplicatedStorage:FindFirstChild("Assets")
        local f = assets and assets:FindFirstChild("Items")
        local n = 0
        if f then
            for _, m in ipairs(f:GetChildren()) do
                if string.find(m.Name, "^Attachment") or string.find(m.Name, "^Sight")
                or string.find(m.Name, "^Optic") or string.find(m.Name, "^Scope") then
                    if not seen[m.Name] then
                        seen[m.Name] = true
