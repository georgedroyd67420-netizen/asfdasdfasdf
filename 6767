        pcall(function() AR2_sightModel:Destroy() end)
        AR2_sightModel = nil
    end
end

function AR2_sightGunAnchor(gun)
    local best, bestVol = nil, -1
    for _, p in ipairs(gun:GetDescendants()) do
        if p:IsA("BasePart") then
            local v = p.Size.X * p.Size.Y * p.Size.Z
            if v > bestVol then bestVol, best = v, p end
        end
    end
    if not best and gun:IsA("BasePart") then best = gun end
    return best
end

function AR2_sightWeld()
    AR2_sightClear()
    if not AR2_CFG.weapon.forceSight then return true, "off" end

    local name = tostring(AR2_CFG.weapon.sightName or "")
    if name == "" or name == "None" or string.find(name, "^%(") then
        return false, "pick a sight first"
    end

    local guns = AR2_equippedGunModels()
    if #guns == 0 then return false, "no gun equipped" end

    local src = AR2_sightSource(name)
    if not src then return false, "model not found: " .. name end

    local welded = 0
    for _, gun in ipairs(guns) do
        local anchorPart = AR2_sightGunAnchor(gun)
        if anchorPart then
            local clone = src:Clone()

            local keep = {}
            if clone:IsA("BasePart") then
                keep[1] = clone
            else
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") then keep[#keep+1] = d end
                end
                for _, pt in ipairs(keep) do pcall(function() pt.Parent = clone end) end
                for _, d in ipairs(clone:GetDescendants()) do
                    if not d:IsA("BasePart") and not d:IsA("SpecialMesh")
                       and not d:IsA("BlockMesh") and not d:IsA("Decal")
                       and not d:IsA("Texture") and not d:IsA("SurfaceAppearance") then
                        pcall(function() d:Destroy() end)
                    end
                end
            end

            local root, bestVol = nil, -1
            for _, pt in ipairs(keep) do
                if pt.Parent then
                    local v = pt.Size.X * pt.Size.Y * pt.Size.Z
                    if v > bestVol then bestVol, root = v, pt end
                end
            end

            if root then
                local scale = math.clamp(tonumber(AR2_CFG.weapon.sightScale) or 1, 0.2, 3)
                if math.abs(scale - 1) > 0.001 then
                    local rcf = root.CFrame
                    for _, pt in ipairs(keep) do
                        if pt.Parent then
                            local rel = rcf:Inverse() * pt.CFrame
                            local rot = rel - rel.Position
                            pcall(function()
                                pt.Size = pt.Size * scale
                                if pt ~= root then
                                    pt.CFrame = rcf * (CFrame.new(rel.Position * scale) * rot)
                                end
                            end)
                        end
                    end
                end

                for _, pt in ipairs(keep) do
                    if pt.Parent then
                        pt.Anchored   = false
                        pt.CanCollide = false
                        pt.Massless   = true
                        pt.CanTouch   = false
                        pt.CanQuery   = false
                    end
                end

                local autoY, autoZ = 0, 0
                if AR2_CFG.weapon.sightAuto then
                    local gunH   = anchorPart.Size.Y * 0.5
                    local sightH = root.Size.Y * 0.5 * scale
                    autoY = gunH + sightH * 0.6

                    local sz = anchorPart.Size
                    local longest = math.max(sz.X, sz.Y, sz.Z)
                    autoZ = -longest * 0.15
                end

                local offset = CFrame.new(
                    (tonumber(AR2_CFG.weapon.sightX) or 0),
                    (tonumber(AR2_CFG.weapon.sightY) or 0) + autoY,
                    (tonumber(AR2_CFG.weapon.sightZ) or 0) + autoZ
                ) * CFrame.Angles(
                    math.rad(tonumber(AR2_CFG.weapon.sightPitch) or 0),
                    math.rad(tonumber(AR2_CFG.weapon.sightYaw)   or 0),
                    math.rad(tonumber(AR2_CFG.weapon.sightRoll)  or 0))

                local target  = anchorPart.CFrame * offset
                local rootOld = root.CFrame
                for _, pt in ipairs(keep) do
                    if pt.Parent and pt ~= root then
                        pcall(function() pt.CFrame = target * (rootOld:Inverse() * pt.CFrame) end)
                    end
                end
                pcall(function() root.CFrame = target end)

                for _, pt in ipairs(keep) do
                    if pt.Parent and pt ~= root then
                        local w = Instance.new("Weld")
                        w.Part0, w.Part1 = root, pt
                        w.C0 = root.CFrame:Inverse() * pt.CFrame
                        w.Parent = root
                    end
                end

                local main = Instance.new("Weld")
                main.Name, main.Part0, main.Part1 = "DroidwareSightWeld", anchorPart, root
                main.C0 = anchorPart.CFrame:Inverse() * root.CFrame
                main.Parent = root

                clone.Name = "DroidwareSight"
                clone.Parent = gun
                AR2_sightModel = clone
                welded = welded + 1
            else
                pcall(function() clone:Destroy() end)
            end
        end
    end

    if welded == 0 then return false, "could not weld" end
    AR2_sightNote = ("welded to %d model(s)"):format(welded)
    return true, AR2_sightNote
end

