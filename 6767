function AR2_applyForcedSight()
    if not AR2_gunBuilder then return false, "GunBuilder not resolved" end
    if not AR2_CFG.weapon.forceSight then return true, "off" end

    local want = tostring(AR2_CFG.weapon.sightName or "")
    if want == "" or want == "None" then
        local l = AR2_listSights()
        for _, v in ipairs(l) do
            if v ~= "None" then want = v AR2_CFG.weapon.sightName = v break end
        end
        if want == "" or want == "None" then return false, "no sights found" end
    end

    local gc = AR2_resolveGameCharacter()
    local item = gc and gc.EquippedItem
    if not item then return false, "nothing equipped" end

    local att = rawget(item, "Attachments")
    if type(att) ~= "table" then return false, "weapon has no Attachments table" end

    local okWrite, errWrite = pcall(function() att.Sight = want end)
    if not okWrite then
        local okRaw = pcall(function() rawset(att, "Sight", want) end)
        if not okRaw then
            AR2_sightNote = "Attachments frozen: " .. tostring(errWrite)
            return false, AR2_sightNote
        end
    end
    local live
    pcall(function() live = item.Attachments.Sight end)
    if live ~= want then
        AR2_sightNote = ("write did not stick (slot reads %s)"):format(tostring(live))
        return false, AR2_sightNote
    end

    local fname = AR2_sightRebuildFn()
    if not fname then return false, "no rebuild function on GunBuilder" end

    local models = AR2_equippedGunModels()
    if #models == 0 then return false, "no gun model found" end

    local built = 0
    for _, m in ipairs(models) do
        local ok = pcall(function() AR2_gunBuilder[fname](AR2_gunBuilder, m, item) end)
        if not ok then ok = pcall(function() AR2_gunBuilder[fname](m, item) end) end
        if ok then built = built + 1 end
    end

    if built == 0 then
        AR2_sightNote = fname .. " rejected every call shape"
        return false, AR2_sightNote
    end
    AR2_sightNote = ("%s via %s on %d model(s)"):format(want, fname, built)
    return true, AR2_sightNote
end

function AR2_setForceSight(on)
    AR2_CFG.weapon.forceSight = on and true or false
    if not AR2_CFG.weapon.forceSight then return true, "off" end
    return AR2_applyForcedSight()
end

