AR2_SIGHT_HINTS = { "sight", "optic", "scope", "reflex", "holo", "aimpoint", "red dot" }

function AR2_isSightEntry(name, v)
    local function hit(str)
        if type(str) ~= "string" then return false end
        local l = string.lower(str)
        for _, w in ipairs(AR2_SIGHT_HINTS) do
            if string.find(l, w, 1, true) then return true end
        end
        return false
    end
    if hit(rawget(v, "Type")) or hit(rawget(v, "EquipSlot")) then return true end
    if hit(rawget(v, "AttachmentType")) or hit(rawget(v, "Slot")) then return true end
    if string.match(name, "Sight") or string.match(name, "Optic")
    or string.match(name, "Scope") or string.match(name, "Reflex")
    or string.match(name, "Holo") then
        return true
    end
    return false
end

function AR2_listSights(force)
    if AR2_sightNames and not force then return AR2_sightNames end

    local seen, names = {}, {}
    local data = AR2_findItemData()
    if data then
        pcall(function()
            for k, v in pairs(data) do
                if type(k) == "string" and type(v) == "table" and AR2_isSightEntry(k, v) then
                    if not seen[k] then seen[k] = true names[#names+1] = k end
                end
            end
        end)
    end

    if #names == 0 then
        pcall(function()
            local assets = AR2_ReplicatedStorage:FindFirstChild("Assets")
            for _, folder in ipairs({ "Items", "LootModels" }) do
                local f = assets and assets:FindFirstChild(folder)
                if f then
                    for _, m in ipairs(f:GetChildren()) do
                        local n = m.Name
                        if (string.match(n, "Sight") or string.match(n, "Optic")
                            or string.match(n, "Scope")) and not seen[n] then
                            seen[n] = true names[#names+1] = n
                        end
                    end
                end
            end
        end)
    end

    table.sort(names)
    table.insert(names, 1, "None")
    AR2_sightNames = names
    return names
end

