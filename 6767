        local function AR2_setDropdownValues(elem, values)
            if not elem then return false end
            local applied = false
            if type(elem.SetValues) == "function" then
                applied = select(1, pcall(function() elem:SetValues(values) end))
            end
            if not applied and type(elem.Refresh) == "function" then
                applied = select(1, pcall(function() elem:Refresh(values) end))
            end
            return applied
        end

        local function AR2_setDropdownValue(elem, value)
            if not elem then return end
            if type(elem.GetValue) == "function" then
                local ok, cur = pcall(function() return elem:GetValue() end)
                if ok and cur == value then return end
            end
            if type(elem.SetValue) == "function" then
                pcall(function() elem:SetValue(value) end)
            elseif type(elem.Set) == "function" then
                pcall(function() elem:Set(value) end)
            end
        end

