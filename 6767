AR2_staffFn = nil

local function AR2_staffGetFn()
    if type(AR2_staffFn) == "function" then return AR2_staffFn end
    local fn
    pcall(function()
        local fw = require(AR2_ReplicatedFirst:WaitForChild("Framework", 10))
        fn = fw.require("Configs", "Staff")
        if type(fn) ~= "function" then fn = fw.Configs and fw.Configs.Staff end
    end)
    if type(fn) ~= "function" then
        pcall(function()
            fn = require(AR2_ReplicatedStorage.Client.Configs.Staff)
        end)
    end
    if type(fn) == "function" then AR2_staffFn = fn end
    return AR2_staffFn
end

function AR2_staffInspect(plr)
    if not plr then return nil, nil end
    local c = AR2_CFG.staff
    local name = tostring(plr.Name or "")

    for _, entry in ipairs(c.watchlist or {}) do
        if tostring(entry):lower() == name:lower() then
            return "Watchlist", "admin"
        end
    end

    local fn = AR2_staffGetFn()
    if not fn then return nil, nil end

    local role
    local ok, res = pcall(fn, plr)
    if ok and type(res) == "string" and res ~= "" then
        role = res
    else
        local ok2, res2 = pcall(fn, plr.UserId)
        if ok2 and type(res2) == "string" and res2 ~= "" then role = res2 end
    end
    if not role then return nil, nil end

    local tier = AR2_STAFF_TIER[role] or "staff"
    return role, tier
end

function AR2_staffOf(name)
    if not (AR2_CFG.staff and AR2_CFG.staff.on) then return nil end
    if not name then return nil end
    return AR2_staffNames[tostring(name):lower()]
end

local function AR2_staffRegister(plr, announce)
    if not plr or plr == AR2_LocalPlayer then return nil end
    local role, tier = AR2_staffInspect(plr)
    if not role then
        AR2_staffSeen[plr] = nil
        AR2_staffNames[tostring(plr.Name):lower()] = nil
        return nil
    end

    local had = AR2_staffSeen[plr]
    local rec = { tier = tier, role = role }
    AR2_staffSeen[plr] = rec
    AR2_staffNames[tostring(plr.Name):lower()] = rec

    if announce and AR2_CFG.staff.notify
       and not (had and had.role == role) then
        AR2_notify(("%s IN SERVER: %s"):format(role:upper(), plr.Name), 10)
        warn(("[DROIDWARE] staff: %s = %s (%s tier)")
            :format(plr.Name, role, tier))
    end
    return role
end

function AR2_staffScanAll(announce)
    if not (AR2_CFG.staff and AR2_CFG.staff.on) then return 0 end
    local n = 0
    for _, plr in ipairs(AR2_Players:GetPlayers()) do
        if AR2_staffRegister(plr, announce) then n = n + 1 end
    end
    return n
end

function AR2_staffReport()
    local out = { "---- staff watch ----" }
    local c = AR2_CFG.staff
    out[#out+1] = ("on=%s notify=%s esp=%s watchlist=%d")
        :format(tostring(c.on), tostring(c.notify), tostring(c.esp),
                #(c.watchlist or {}))
    out[#out+1] = ("Configs.Staff resolved: %s")
        :format(type(AR2_staffFn) == "function" and "yes" or "NO -- cannot detect")
    local any = false
    for plr, info in pairs(AR2_staffSeen) do
        any = true
        out[#out+1] = ("  %-22s %-20s %s")
            :format(tostring(plr.Name), info.role, info.tier)
    end
    if not any then out[#out+1] = "  nobody flagged" end
    return table.concat(out, "\n")
end

