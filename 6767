    local function AR2_wrapSection(sec)
        local S = { _j = sec, _order = 0, _pending = nil, _content = nil }
        pcall(function() S._content = sec.Items["Content"].Instance end)
        table.insert(AR2_SECTIONS, S)

        function S:_claim()
            self._order = self._order + 1
            return self._order
        end

        function S:_stamp(order, before)
            if not self._content then return end
            pcall(function()
                local kids = self._content:GetChildren()
                for i = before + 1, #kids do
                    if kids[i]:IsA("GuiObject") then kids[i].LayoutOrder = order end
                end
            end)
        end

        function S:_count()
            if not self._content then return 0 end
            local n = 0
            pcall(function() n = #self._content:GetChildren() end)
            return n
        end

        function S:_build(order, fn)
            local before = self:_count()
            local ok, res = pcall(fn)
            self:_stamp(order, before)
            if ok then return res end
            return nil
        end

        function S:_flush()
            local p = self._pending
            if not p then return end
            self._pending = nil
            p:_materialize()
        end

        function S:SetText(t) pcall(function() sec:SetText(tostring(t)) end) end

        function S:AddLabel(text)
            self:_flush()
            local order = self:_claim()
            local L = { _sec = S, _order = order, _text = tostring(text), _label = nil }

            function L:_materialize()
                if self._label then return self._label end
                local lbl = S:_build(self._order, function()
                    return sec:Label({ Name = self._text })
                end)
                self._label = lbl
                return lbl
            end

            function L:_take()
                if S._pending == self then S._pending = nil end
            end

            function L:SetText(t)
                self._text = tostring(t)
                if self._label then pcall(function() self._label:SetText(self._text) end) end
            end

            function L:SetVisibility(b)
                if self._label then pcall(function() self._label:SetVisibility(b and true or false) end) end
            end

            function L:AddToggle(o)
                o = o or {}
                self:_take()
                local t = S:_build(self._order, function()
                    return sec:Toggle({
                        Name = self._text, Flag = o.Flag,
                        Default = o.Default and true or false,
                        Callback = o.Callback or function() end,
                    })
                end)
                if not t then return AR2_wrapElem({}, o.Flag) end
                return AR2_wrapElem(t, o.Flag)
            end

            function L:AddSlider(o)
                o = o or {}
                local step = 1
                if tonumber(o.Rounding) and tonumber(o.Rounding) > 0 then
                    step = 1 / (10 ^ math.floor(tonumber(o.Rounding)))
                end
                self:_take()
                local s = S:_build(self._order, function()
                    return sec:Slider({
                        Name = self._text, Flag = o.Flag,
                        Min = o.Min or 0, Max = o.Max or 100,
                        Default = o.Default or o.Min or 0,
                        Decimals = step, Suffix = o.Suffix or "",
                        Callback = o.Callback or function() end,
                    })
                end)
                if not s then return AR2_wrapElem({}, o.Flag) end
                return AR2_wrapElem(s, o.Flag)
            end

            function L:AddDropdown(o)
                o = o or {}
                self:_take()
                local d = S:_build(self._order, function()
                    return sec:Dropdown({
                        Name = self._text, Flag = o.Flag,
                        Items = o.Values or o.Items or {},
                        Default = o.Default, Multi = o.Multi and true or false,
                        Callback = o.Callback or function() end,
                    })
                end)
                if not d then return AR2_wrapElem({}, o.Flag) end
                return AR2_wrapElem(d, o.Flag)
            end

            function L:AddInput(o)
                o = o or {}
                self:_take()
                local tb = S:_build(self._order, function()
                    return sec:Textbox({
                        Name = self._text, Flag = o.Flag,
                        Default = o.Default or "", Placeholder = o.Placeholder or "",
                        Finished = o.Finished and true or false,
                        Callback = o.Callback or function() end,
                    })
                end)
                if not tb then return AR2_wrapElem({}, o.Flag) end
                return AR2_wrapElem(tb, o.Flag)
            end

            function L:AddColorPicker(o)
                o = o or {}
                self:_take()
                local lbl = self:_materialize()
                if not lbl then return nil end
                local cp
                pcall(function()
                    cp = lbl:Colorpicker({
                        Name = self._text, Flag = o.Flag,
                        Default = o.Default, Alpha = o.Alpha or 0,
                        Callback = o.Callback or function() end,
                    })
                end)
                if not cp then return nil end
                return AR2_wrapElem(cp, o.Flag)
            end

            function L:AddKeyPicker(o)
                o = o or {}
                self:_take()
                local lbl = self:_materialize()
                if not lbl then return nil end
                local key = o.Default
                if type(key) == "string" and key ~= "" and key ~= "None" then
                    local ok, enum = pcall(function() return Enum.KeyCode[key] end)
                    key = ok and enum or nil
                end
                local kb
                pcall(function()
                    kb = lbl:Keybind({
                        Name = tostring(o.Text or self._text), Flag = o.Flag,
                        Default = key, Mode = o.Mode or "Toggle",
                        Callback = o.Callback or function() end,
                    })
                end)
                if not kb then return nil end
                return AR2_wrapElem(kb, o.Flag)
            end

            S._pending = L
            return L
        end

        function S:AddButton(o)
            self:_flush()
            o = o or {}
            local order = self:_claim()
            local b = self:_build(order, function()
                return sec:Button({
                    Name = tostring(o.Name or o.Text or "Button"),
                    Callback = o.Callback or function() end,
                })
            end)
            local W = { _j = b }
            function W:SetName(t) if b then pcall(function() b:SetText(tostring(t)) end) end end
            function W:SetText(t) return W.SetName(self, t) end
            function W:Set(t) return W.SetName(self, t) end
            function W:Press() if b then pcall(function() b:Press() end) end end
            function W:SetVisibility(v) if b then pcall(function() b:SetVisibility(v and true or false) end) end end
            return W
        end

        function S:AddToggle(o) return self:AddLabel((o and (o.Text or o.Name)) or "Toggle"):AddToggle(o) end
        function S:AddSlider(o) return self:AddLabel((o and (o.Text or o.Name)) or "Slider"):AddSlider(o) end
        function S:AddDropdown(o) return self:AddLabel((o and (o.Text or o.Name)) or "Dropdown"):AddDropdown(o) end
        function S:AddInput(o) return self:AddLabel((o and (o.Text or o.Name)) or "Input"):AddInput(o) end
        function S:AddColorPicker(o) return self:AddLabel((o and (o.Text or o.Name)) or "Color"):AddColorPicker(o) end
        function S:AddKeyPicker(o) return self:AddLabel((o and (o.Text or o.Name)) or "Keybind"):AddKeyPicker(o) end
        function S:AddDivider() end

        return S
    end

