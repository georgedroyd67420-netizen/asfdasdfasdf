        end
    end)

    lines[#lines+1] = ("  last apply result: %s"):format(tostring(AR2_sightNote or "not tried"))

    local txt = table.concat(lines, "\n")
    print(txt)
    pcall(function() setclipboard(txt) end)
    pcall(function() writefile("droidware_sights.txt", txt) end)
    return txt
end


AR2_cosKnownItems = nil
AR2_cosOwnedTbls  = {}

function AR2_cosBuildKnownSet()
    if AR2_cosKnownItems then return AR2_cosKnownItems end
    local set, n = {}, 0
    pcall(function()
        local assets = AR2_ReplicatedStorage:FindFirstChild("Assets")
        for _, folder in ipairs({ "Items", "LootModels" }) do
            local f = assets and assets:FindFirstChild(folder)
            if f then
                for _, m in ipairs(f:GetChildren()) do
                    local nm = m.Name
                    if string.find(nm, "^Accessory ") or string.find(nm, "^Hat ")
                    or string.find(nm, "^Vest ") or string.find(nm, "^Shirt ")
                    or string.find(nm, "^Pants ") or string.find(nm, "^Belt ")
                    or string.find(nm, "^Backpack ") or string.match(nm, "^Hair%d") then
                        if not set[nm] then set[nm] = true n = n + 1 end
                    end
                end
            end
        end
    end)
    AR2_cosKnownCount = n
    AR2_cosKnownItems = set
    return set
end

function AR2_cosScanOwned()
    local known = AR2_cosBuildKnownSet()
    AR2_cosOwnedTbls = {}

    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "table" then
            local keyHits, valHits, total, sample = 0, 0, 0, {}
            local ok = pcall(function()
                for k, v in pairs(obj) do
                    total = total + 1
                    if type(k) == "string" and known[k] then
                        keyHits = keyHits + 1
                        if #sample < 4 then sample[#sample+1] = k end
                    elseif type(v) == "string" and known[v] then
                        valHits = valHits + 1
                        if #sample < 4 then sample[#sample+1] = v end
                    end
                    if total > 3000 then break end
                end
            end)
            if ok and (keyHits + valHits) >= 1 then
                AR2_cosOwnedTbls[#AR2_cosOwnedTbls+1] = {
                    tbl = obj, keyHits = keyHits, valHits = valHits,
                    total = total, sample = table.concat(sample, ", "),
                }
            end
        end
    end

    table.sort(AR2_cosOwnedTbls, function(a, b)
        return (a.keyHits + a.valHits) > (b.keyHits + b.valHits)
    end)
    return AR2_cosOwnedTbls
end

function AR2_cosEntryShape(t, limit)
    local out, n = {}, 0
    local known = AR2_cosBuildKnownSet()
    pcall(function()
        for k, v in pairs(t) do
            if type(k) == "string" and known[k] then
                n = n + 1
                if type(v) == "table" then
                    local fields = {}
                    pcall(function()
                        for k2, v2 in pairs(v) do
                            fields[#fields+1] = ("%s=%s(%s)")
                                :format(tostring(k2), tostring(v2), typeof(v2))
                            if #fields >= 14 then break end
                        end
                    end)
                    out[#out+1] = ("    %s -> {%s}"):format(k, table.concat(fields, ", "))
                else
                    out[#out+1] = ("    %s -> %s (%s)"):format(k, tostring(v), typeof(v))
                end
                if n >= (limit or 3) then break end
            end
        end
    end)
    return out
end

AR2_COS_OWNFIELDS = {
    "DisplayedInCreator",
    "Owned","owned","IsOwned","Unlocked","unlocked","Locked","locked",
    "Purchased","purchased","Free","free","Price","price","Cost","cost",
    "Robux","robux","Premium","premium","Exclusive","exclusive",
}

function AR2_cosFlipCatalogue(index)
    local list = AR2_cosOwnedTbls
    if #list == 0 then list = AR2_cosScanOwned() end
    local entry = list[tonumber(index) or 1]
    if not entry then return false, "no candidate -- run Dump Owned Items first" end

    local known = AR2_cosBuildKnownSet()
    local changed, touched = 0, {}
    pcall(function()
        for k, v in pairs(entry.tbl) do
            if type(k) == "string" and known[k] and type(v) == "table" then
                for _, f in ipairs(AR2_COS_OWNFIELDS) do
                    local cur = rawget(v, f)
                    if cur ~= nil then
                        local want
                        if type(cur) == "boolean" then
                            want = not (f == "Locked" or f == "locked")
                        elseif type(cur) == "number" then
                            want = 0
                        end
                        if want ~= nil and cur ~= want then
                            local ok = pcall(function() v[f] = want end)
                            if not ok then pcall(function() rawset(v, f, want) end) end
                            changed = changed + 1
                            touched[f] = (touched[f] or 0) + 1
                        end
                    end
                end
            end
        end
    end)
    if changed == 0 then
        return false, "nothing to change -- no ownership fields, or all already set"
    end
    local parts = {}
    for f, n in pairs(touched) do parts[#parts+1] = f .. " x" .. n end
    return true, ("set %d: %s"):format(changed, table.concat(parts, ", "))
end

function AR2_cosDumpOwned()
    local list = AR2_cosScanOwned()
    local lines = {
        "== OWNED-ITEM CANDIDATES ==",
        ("  known cosmetic names in Assets: %d"):format(AR2_cosKnownCount or 0),
        "",
    }
    lines[#lines+1] = "-- CATALOGUE-LIKE (most/all known names) --"
    for i, e in ipairs(list) do
        if e.keyHits >= 400 or e.valHits >= 400 then
            lines[#lines+1] = ("  [%d] keys=%d values=%d of %d  e.g. %s")
                :format(i, e.keyHits, e.valHits, e.total, e.sample)
            if e.keyHits >= 400 then
                for _, l in ipairs(AR2_cosEntryShape(e.tbl, 3)) do lines[#lines+1] = l end
            end
        end
    end

    lines[#lines+1] = ""
    lines[#lines+1] = "-- SMALL (candidates for YOUR owned set) --"
    local small = 0
    for i, e in ipairs(list) do
        if e.keyHits < 400 and e.valHits < 400 then
            small = small + 1
            if small <= 14 then
                lines[#lines+1] = ("  [%d] keys=%d values=%d of %d  e.g. %s")
                    :format(i, e.keyHits, e.valHits, e.total, e.sample)
                for _, l in ipairs(AR2_cosEntryShape(e.tbl, 2)) do lines[#lines+1] = l end
            end
        end
    end
    if small == 0 then
        lines[#lines+1] = "  (none -- ownership is probably keyed by id, not name)"
    end
    if #list == 0 then
        lines[#lines+1] = "  (nothing matched -- the owned set may be keyed by id, not name)"
    end
    local txt = table.concat(lines, "\n")
    print(txt)
    pcall(function() setclipboard(txt) end)
    pcall(function() writefile("droidware_owned.txt", txt) end)
    return txt
end

function AR2_cosGrantAll(index)
    local list = AR2_cosOwnedTbls
    if #list == 0 then list = AR2_cosScanOwned() end
    local entry = list[tonumber(index) or 1]
    if not entry then return false, "no candidate -- run Dump Owned Items first" end

    local t = entry.tbl
    local known = AR2_cosBuildKnownSet()

    local templKey, templVal
    pcall(function()
        for k, v in pairs(t) do
            if type(k) == "string" and known[k] then templKey, templVal = k, v break end
        end
    end)

    local added = 0
    if templKey ~= nil then
        for name in pairs(known) do
            if rawget(t, name) == nil then
                local ok = pcall(function()
                    if type(templVal) == "table" then
                        local copy = {}
                        for k2, v2 in pairs(templVal) do copy[k2] = v2 end
                        t[name] = copy
                    else
                        t[name] = templVal
                    end
                end)
                if ok then added = added + 1 end
            end
        end
    else
        local have = {}
        pcall(function()
            for _, v in ipairs(t) do if type(v) == "string" then have[v] = true end end
        end)
        for name in pairs(known) do
            if not have[name] then
                local ok = pcall(function() t[#t+1] = name end)
                if ok then added = added + 1 end
            end
        end
    end

    return added > 0, ("added %d entries to candidate %d"):format(added, tonumber(index) or 1)
end


AR2_guiUnlockConn  = nil
