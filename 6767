function AR2_bagCatalogue()
    local seen, list = {}, {}
    pcall(function()
        local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
        if not assets then return end
        for _, folder in ipairs({ "Items", "LootModels" }) do
            local f = assets:FindFirstChild(folder)
            if f then
                for _, m in ipairs(f:GetChildren()) do
                    if m:IsA("Model") and AR2_bagIsBagName(m.Name) and not seen[m.Name] then
                        seen[m.Name] = true
                        list[#list+1] = m.Name
                    end
                end
            end
        end
    end)
    if #list == 0 then return { "(no bag models found)" } end
    table.sort(list)
    return list
