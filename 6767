                local s = v:gsub("#", "")
                local ok, c = pcall(Color3.fromHex, s)
                if ok and typeof(c) == "Color3" then return c end
            end
            if type(v) == "table" then
                local r = tonumber(v.r or v.R)
                local g = tonumber(v.g or v.G)
                local b = tonumber(v.b or v.B)
                if r and g and b then
                    if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
                    return Color3.new(r, g, b)
                end
            end
            return nil
        end

