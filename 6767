function AR2_ibSwapFireConfig(weaponData, newSpeed, flatten)
    local okRead, fc = pcall(function() return weaponData.FireConfig end)
    if not okRead or type(fc) ~= "table" then return nil end

    local copy = {}
    local okCopy = pcall(function()
        for k, v in pairs(fc) do copy[k] = v end
    end)
    if not okCopy then return nil end

    copy.MuzzleVelocity = newSpeed
    if flatten and copy.ProjectileGravity ~= nil then copy.ProjectileGravity = 0 end

    local okSet = pcall(function() weaponData.FireConfig = copy end)
    if not okSet then
        okSet = pcall(function() rawset(weaponData, "FireConfig", copy) end)
    end
    if not okSet then return nil end

    local okCheck, live = pcall(function() return weaponData.FireConfig.MuzzleVelocity end)
    if not okCheck or live ~= newSpeed then
        pcall(function() weaponData.FireConfig = fc end)
        pcall(function() rawset(weaponData, "FireConfig", nil) end)
        return nil
    end

    AR2_ibSwapped   = fc
    AR2_ibSwapOwner = weaponData
    AR2_ibSwapOk    = (AR2_ibSwapOk or 0) + 1
    return fc
end

function AR2_ibRestoreFireConfig()
    if AR2_ibSwapOwner then
