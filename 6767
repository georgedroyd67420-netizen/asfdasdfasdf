AR2_hpLastHit        = {}
AR2_lastSeenDamage   = nil
AR2_dmgMarkerLog     = {}
AR2_dmgMarkerLogging = false

do
    local lastHitTarget, lastHitAt = nil, 0
    local DMG_WINDOW = 1.1

    function AR2_noteDamageTarget(name)
        if not name then return end
        lastHitTarget, lastHitAt = tostring(name), os.clock()
    end

    local function maxHpFor(name)
        return AR2_clientMaxHP[name] or (AR2_CFG.style and AR2_CFG.style.hpMax) or 100
    end

    local function nearestEnemyName(worldPos)
        if not worldPos then return nil end
        local chars = AR2_Workspace:FindFirstChild("Characters")
        if not chars then return nil end
        local bestName, bestD = nil, 16
        for _, model in ipairs(chars:GetChildren()) do
            if model:IsA("Model") and model ~= AR2_LocalPlayer.Character then
                local anchor = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if anchor then
                    local d = (anchor.Position - worldPos).Magnitude
                    if d < bestD then bestD, bestName = d, model.Name end
                end
            end
        end
        return bestName
    end

    local function applyDamage(amount, who)
        if not who or not amount or amount <= 0 then return end
        if AR2_clientHP[who] == nil then AR2_clientHP[who] = maxHpFor(who) end
        AR2_clientMaxHP[who] = maxHpFor(who)
        AR2_clientHP[who]    = math.max(0, AR2_clientHP[who] - amount)
        AR2_hpLastHit[who]   = os.clock()
    end

    local function markerWorldPos(obj)
        local node = obj
        for _ = 1, 6 do
            if not node or node == game then return nil end
            if node:IsA("BillboardGui") then
                if node.Adornee and node.Adornee:IsA("BasePart") then return node.Adornee.Position end
                local par = node.Parent
                if par and par:IsA("BasePart") then return par.Position end
                if par and par:IsA("Attachment") then return par.WorldPosition end
                return nil
            end
            node = node.Parent
        end
        return nil
    end

    local function looksLikeDamage(obj)
        local node = obj
        for _ = 1, 5 do
            if not node or node == game then return false end
            local n = tostring(node.Name):lower()
            if n:find("damage") or n:find("dmg") or n:find("hitmark") or n:find("hitnum")
               or n:find("indicator") or n:find("marker") then
                return true
            end
            node = node.Parent
        end
        return false
    end

    local seen = setmetatable({}, { __mode = "k" })

    local function consider(obj, isNew)
        if seen[obj] then return end
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
        seen[obj] = true

        local tagged = looksLikeDamage(obj)
        if not (isNew or tagged) then return end

        local fired = false
        local function read()
            if fired then return end
            if AR2_CFG.style and AR2_CFG.style.hpTrack == false then return end

            local raw = tostring(obj.Text or "")
            local n = tonumber(raw:match("%-?%d+%.?%d*") or "")
            if not n then return end
            n = math.abs(n)
            if n <= 0 or n > 500 then return end
            if not tagged and not raw:match("^%s*%-?%d+%.?%d*%s*$") then return end

            local who = nearestEnemyName(markerWorldPos(obj))
            if not who then
                if os.clock() - lastHitAt > DMG_WINDOW then return end
                who = lastHitTarget
            end
            if not who then return end

            fired = true
            AR2_lastSeenDamage = n
            applyDamage(n, who)
            if not (AR2_CFG.misc.srvDamageOnly and AR2_dmgListenerOn) then
                pcall(AR2_shotLogHit, n)
            end

            if AR2_dmgMarkerLogging then
                local okp, path = pcall(function() return obj:GetFullName() end)
                table.insert(AR2_dmgMarkerLog,
                    string.format("%.1f dmg -> %s   [%s]", n, who, okp and path or obj.Name))
                if #AR2_dmgMarkerLog > 150 then table.remove(AR2_dmgMarkerLog, 1) end
            end
        end

        pcall(function() obj:GetPropertyChangedSignal("Text"):Connect(read) end)
        read()
    end

    AR2_dmgConsider = consider

    task.spawn(function()
        local PG
        while not PG do
            PG = AR2_LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if not PG then task.wait(0.5) end
        end
        for _, d in ipairs(PG:GetDescendants()) do pcall(consider, d, false) end
        PG.DescendantAdded:Connect(function(d) pcall(consider, d, true) end)
    end)

    task.spawn(function()
        local host = (typeof(gethui) == "function" and gethui()) or nil
        if not host then return end
        host.DescendantAdded:Connect(function(d)
            if d:IsA("TextLabel") then pcall(consider, d, true) end
        end)
    end)

    AR2_Workspace.DescendantAdded:Connect(function(d)
        if not (AR2_CFG.style and AR2_CFG.style.hpTrackWorld) then return end
        if d:IsA("TextLabel") or d:IsA("TextButton") then pcall(consider, d, true) end
    end)

    task.spawn(function()
        while true do
            task.wait(2)
            pcall(function()
                local chars = AR2_Workspace:FindFirstChild("Characters")
                for name, hp in pairs(AR2_clientHP) do
                    if hp ~= nil and hp <= 0 and os.clock() - (AR2_hpLastHit[name] or 0) > 5 then
                        local model = chars and chars:FindFirstChild(name)
                        local hum   = model and model:FindFirstChildWhichIsA("Humanoid")
                        if model and (not hum or hum.Health > 0) then
                            AR2_clientHP[name] = maxHpFor(name)
                        end
                    end
                end
            end)
        end
    end)
end

function AR2_normalizeKey(k)
    if not k or k == "" then return "None" end
    k = tostring(k):gsub("^%s+", ""):gsub("%s+$", "")
    if k == "" then return "None" end
    local low = k:lower()
    if low == "none" then return "None" end
    local aliases = {
        ["mouse1"]="MouseButton1", ["mouse2"]="MouseButton2", ["mouse3"]="MouseButton3",
        ["m1"]="MouseButton1", ["m2"]="MouseButton2", ["m3"]="MouseButton3",
        ["ctrl"]="LeftControl", ["control"]="LeftControl",
        ["shift"]="LeftShift", ["lshift"]="LeftShift", ["rshift"]="RightShift",
        ["alt"]="LeftAlt", ["lalt"]="LeftAlt", ["ralt"]="RightAlt",
        ["esc"]="Escape", ["enter"]="Return", ["return"]="Return",
        ["spacebar"]="Space", ["space"]="Space",
        ["pageup"]="PageUp", ["pagedown"]="PageDown",
        ["caps"]="CapsLock", ["capslock"]="CapsLock",
        ["up"]="Up", ["down"]="Down", ["left"]="Left", ["right"]="Right",
        ["home"]="Home", ["end"]="End", ["insert"]="Insert", ["delete"]="Delete",
        ["del"]="Delete", ["tab"]="Tab",
    }
    if aliases[low] then return aliases[low] end
    if #k == 1 then
        local c = k:upper()
        if c >= "A" and c <= "Z" then return c end
        if tonumber(c) then return c end
    end
    local upper = k:upper()
    if upper:match("^F%d+$") then return upper end
    return k:sub(1,1):upper() .. k:sub(2)
end


