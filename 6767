function AR2_getBulletSpeed()
    local c = AR2_CFG.magicAim
    local base

    if not c.autoSpeed and c.bulletSpeed and c.bulletSpeed > 0 then
        base = c.bulletSpeed
        AR2_speedVerified = true
    else
        local weaponName = AR2_getEquippedItemName()
        if weaponName then
            local ItemData = AR2_getItemDataModule()
            if ItemData and ItemData[weaponName] and ItemData[weaponName].FireConfig then
                local speed = ItemData[weaponName].FireConfig.MuzzleVelocity
                if type(speed) == "number" and speed > 100 then base = speed end
            end
        end
        if base and weaponName then
            AR2_speedByWeapon[weaponName] = base
            AR2_lastGoodSpeed = base
            AR2_speedVerified = true
        elseif weaponName and AR2_speedByWeapon[weaponName] then
            base = AR2_speedByWeapon[weaponName]
            AR2_lastGoodSpeed = base
            AR2_speedVerified = true
        else
            base = AR2_speedByWeapon[weaponName or ""] or AR2_lastGoodSpeed or 4700
            AR2_speedVerified = false
        end
    end

    if base and AR2_CFG.weapon.instaBullets then
        local m = tonumber(AR2_ibEffectiveMult) or 1
        if m > 1 then base = base * m end
    end

    if base then
        local mod = nil
        pcall(function()
            local fw = require(AR2_ReplicatedFirst:WaitForChild("Framework", 10))
            local G  = fw.require("Configs", "Globals") or fw.Configs.Globals
            if type(G) == "table" and type(G.MuzzleVelocityMod) == "number" then
                mod = G.MuzzleVelocityMod
            end
        end)
        if type(mod) == "number" and mod > 0 and mod ~= 1 then
            base = base * mod
        end
        AR2_velModUsed = mod or 1
    end

    AR2_speedUsed = base
    return base
end


