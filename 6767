        local assets = AR2_ReplicatedStorage:FindFirstChild("Assets")
        for _, folder in ipairs({ "Items", "LootModels", "Faces" }) do
            local f = assets and assets:FindFirstChild(folder)
            if f then
                for _, m in ipairs(f:GetChildren()) do
                    if string.match(m.Name, "^Face") and not seen[m.Name] then
                        seen[m.Name] = true
                        list[#list+1] = m.Name
                    end
                end
            end
        end
    end)
    table.insert(list, 1, "None")
    return list
end


AR2_outfitLearned = nil
AR2_outfitLog     = {}

function AR2_outfitCapture(msg, packed)
    if msg ~= "Set Outfit Item" then return end
    AR2_outfitLearned = packed

    local parts = {}
    for i = 1, packed.n do
        local v = packed[i]
        local t = typeof(v)
        if t == "string" then parts[i] = '"' .. v .. '"'
        elseif t == "number" or t == "boolean" then parts[i] = tostring(v)
        elseif t == "table" then
            local ks = {}
            pcall(function()
                for k in pairs(v) do ks[#ks+1] = tostring(k) if #ks > 8 then break end end
            end)
            parts[i] = "table{" .. table.concat(ks, ",") .. "}"
        else parts[i] = t end
    end
    local line = ("CAPTURED Set Outfit Item(%s)"):format(table.concat(parts, ", "))
    AR2_outfitLog[#AR2_outfitLog+1] = line
end

function AR2_outfitSend(slotName, itemName, slotIdx, itemIdx)
    if not AR2_outfitLearned then
        return false, "not captured -- change one cosmetic in the menu first"
    end
    local net = AR2_resolveNetTable()
    if not net or type(net.Send) ~= "function" then return false, "net table not resolved" end

    local L = AR2_outfitLearned
    local a = {}
    for i = 1, L.n do a[i] = L[i] end

    slotIdx = tonumber(slotIdx) or 0
    itemIdx = tonumber(itemIdx) or 0

    if itemIdx > 0 and itemIdx <= L.n then a[itemIdx] = itemName end
    if slotIdx > 0 and slotIdx <= L.n then a[slotIdx] = slotName end

    if itemIdx == 0 then
        local strs = {}
        for i = 1, L.n do if type(L[i]) == "string" then strs[#strs+1] = i end end
        if #strs >= 2 then
            a[strs[1]] = slotName
            a[strs[2]] = itemName
        elseif #strs == 1 then
            a[strs[1]] = itemName
        else
            return false, "captured call had no string arguments to substitute"
        end
    end

    local send = AR2_netSendOrig or net.Send
    local ok, err = pcall(function()
        return send(net, "Set Outfit Item", table.unpack(a, 1, L.n))
    end)
    if not ok then return false, tostring(err) end

    local shown = {}
    for i = 1, L.n do shown[i] = tostring(a[i]) end
    return true, "sent: " .. table.concat(shown, ", ")
end

function AR2_outfitDump()
    local lines = { "== SET OUTFIT ITEM ==" }
    if not AR2_outfitLearned then
        lines[#lines+1] = "  (not captured -- change one cosmetic in the menu)"
    else
        local L = AR2_outfitLearned
        for i = 1, L.n do
            local v = L[i]
            lines[#lines+1] = ("  arg %d  %-10s %s")
                :format(i, typeof(v), tostring(v))
        end
    end
    for _, l in ipairs(AR2_outfitLog) do lines[#lines+1] = "  " .. l end
    local txt = table.concat(lines, "\n")
    print(txt)
    pcall(function() setclipboard(txt) end)
    return txt
end

function AR2_outfitSaveAndDress(name)
    local net = AR2_resolveNetTable()
    if not net then return false, "net table not resolved" end
    local send = AR2_netSendOrig or net.Send

    local ok1 = pcall(function()
        return send(net, "Save Loadout", nil, tostring(name or "DROIDWARE"))
    end)
    if not ok1 then return false, "Save Loadout rejected" end

    local id = AR2_lastLoadoutId
    if not id then
        return true, "saved -- now press Dress in the menu once so the id is seen"
    end
    local ok2 = pcall(function() return send(net, "Dress Loadout", id) end)
    return ok2, ok2 and ("saved and dressed " .. tostring(id)) or "Dress Loadout rejected"
end




