function AR2_ibSafeMax(spd)
    local hard = AR2_IB_CFG.hardMax or 20
    local gs = AR2_ibGunStat(spd)
    if not gs.safeMax then gs.safeMax = hard end
    return math.clamp(gs.safeMax, 1, hard)
end

function AR2_ibOutcome(mult, landed)
    if not AR2_ibEnabled then return end
    mult = tonumber(mult)
    if not mult or mult <= 1.001 then return end

    local hard = AR2_IB_CFG.hardMax or 20
    local gs = AR2_ibGunStat(AR2_ibLastSpd)
    if not gs.safeMax then gs.safeMax = hard end

    if landed then
        gs.safeMax = math.min(hard, math.max(gs.safeMax, mult * 1.05))
    else
        gs.safeMax = math.max(1, math.min(gs.safeMax, mult * 0.75))
    end
end

function AR2_ibGunKey(spd)
    return tostring(math.floor((tonumber(spd) or 0) / 50) * 50)
end

function AR2_ibGunStat(spd)
    local k = AR2_ibGunKey(spd)
    local st = AR2_ibGunStats[k]
    if not st then
        st = { shots = 0, hits = 0, rate = -1, safeMax = nil }
        AR2_ibGunStats[k] = st
    end
    return st
end

AR2_IB_CFG = {
    targetTravelMs  = 25,
    stepUpPct       = 0.10,
    stepDownPct     = 0.20,
    windowSecs      = 5,
    missThresh      = 0.65,
    goodThresh      = 0.88,
    maxMult         = 5,
    minMult         = 1,
    hardMax         = 20,
    seedDistance    = 400,
}

function AR2_ibCeiling(spd)
    local hard = AR2_IB_CFG.hardMax or 20
    local safe = AR2_ibSafeMax(spd) or hard
    return math.max(AR2_IB_CFG.minMult, math.min(hard, safe))
end

AR2_ibSeedFrom = nil

function AR2_ibSeed()
    local want = tonumber(AR2_CFG.weapon.instaMaxMult) or 2
    if AR2_ibSeeded and AR2_ibSeedFrom == want then return end
    AR2_ibMult     = math.max(AR2_IB_CFG.minMult, want)
    AR2_ibSeedFrom = want
    AR2_ibSeeded   = true
    AR2_ibShotsFired    = 0
    AR2_ibHitsConfirmed = 0
    AR2_ibLastEval      = os.clock()
end

function AR2_ibEvaluate()
    local now = os.clock()
    if now - AR2_ibLastEval < AR2_IB_CFG.windowSecs then return end
    if AR2_ibShotsFired == 0 then AR2_ibLastEval = now return end

    local rate = AR2_ibHitsConfirmed / AR2_ibShotsFired
    AR2_ibLastRate = rate
    table.insert(AR2_ibHistory, {
        mult = AR2_ibMult, rate = rate,
        shots = AR2_ibShotsFired,
        confirmed = AR2_ibHitsConfirmed,
        spd = AR2_ibLastSpd,
    })

    local cap = AR2_ibCeiling(AR2_ibLastSpd)

    if AR2_ibAdapt then
        if rate >= AR2_IB_CFG.goodThresh then
            local step = math.max(1, math.floor(AR2_ibMult * AR2_IB_CFG.stepUpPct))
            AR2_ibMult = math.min(cap, AR2_ibMult + step)
        elseif rate < AR2_IB_CFG.missThresh then
            local step = math.max(1, math.floor(AR2_ibMult * AR2_IB_CFG.stepDownPct))
            AR2_ibMult = math.max(AR2_IB_CFG.minMult, AR2_ibMult - step)
        end
    end

    if AR2_ibMult > cap then AR2_ibMult = cap end

    AR2_ibShotsFired    = 0
    AR2_ibHitsConfirmed = 0
    AR2_ibLastEval      = now
end

AR2_ibSeedHP  = {}
AR2_ibDedupeT = {}
local function AR2_ibStartHitConfirm()
    for _, obj in ipairs(AR2_ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                local args = {...}
                if args[1] ~= "Character State Sync" then return end
                local data = args[2]
                if type(data) ~= "table" or not data.Seed then return end
                local seed = data.Seed
                local now  = os.clock()
                if AR2_ibDedupeT[seed]
                and now - AR2_ibDedupeT[seed] < 0.15 then return end
                AR2_ibDedupeT[seed] = now
                local hp = nil
                pcall(function()
                    if data.Stats and data.Stats.Health then
                        hp = data.Stats.Health.Value
                    end
                end)
                if not hp then return end
                local prev = AR2_ibSeedHP[seed]
                AR2_ibSeedHP[seed] = hp
                if prev and hp < prev
                and now - AR2_ibLastHitTime < 3 then
                    AR2_ibHitsConfirmed = AR2_ibHitsConfirmed + 1
                end
            end)
        end
    end
end


