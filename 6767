function AR2_setWallbangFilter(on)
    if on then
        if AR2_raycastingLib and type(AR2_raycastingLib.BulletCastLight) == "function"
           and not AR2_wallbangFilterOrig then
            AR2_wallbangFilterOrig = AR2_raycastingLib.BulletCastLight

            local function wbBody(self, ray, filter, a3, a4)
                local rageWindow = AR2_CFG.rageBot.on

                    and (AR2_rageFireMark or 0) > 0
                    and (os.clock() - AR2_rageFireMark) <= 0.40

                if not (AR2_CFG.weapon.wallbangFilter or rageWindow) then
                    return AR2_wallbangFilterOrig(self, ray, filter, a3, a4)
                end
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.IgnoreWater = true
                params.FilterDescendantsInstances = typeof(filter) == "table" and filter or {}
                AR2_lastWallCount = 0
                local origin, dir = ray.Origin, ray.Direction
                local unlimited = (AR2_CFG.weapon.penUnlimited == true) or rageWindow
                local budget    = unlimited and math.huge
                    or math.clamp(tonumber(AR2_CFG.weapon.penBudget) or 12, 0, 12)
                local spent  = 0
                local passes = unlimited and 64 or math.min(AR2_CFG.weapon.wallbangPierce or 12, 12)
                for _ = 1, passes do
                    local hit = AR2_Workspace:Raycast(origin, dir, params)
                    if not hit then break end
                    local inst = hit.Instance
                    local isTarget = false
                    pcall(function()
                        isTarget = AR2_raycastingLib.IsHitCharacter(AR2_raycastingLib, inst)
                            or AR2_raycastingLib.IsHitZombie(AR2_raycastingLib, inst)
                            or AR2_raycastingLib.IsHitVehicle(AR2_raycastingLib, inst)
                    end)
                    if not isTarget and AR2_entitiesLib and type(AR2_entitiesLib.Search) == "function" then
                        local ok, ent = pcall(AR2_entitiesLib.Search, AR2_entitiesLib, inst)
                        if ok then isTarget = ent ~= nil end
                    end
                    if isTarget or (inst:HasTag("Water Part") and not a4) then
                        AR2_lastWallsPierced = spent > 0 and AR2_lastWallCount or 0
                        AR2_filterPathHits = (AR2_filterPathHits or 0) + 1
                        if false then
                            return inst, hit.Position, hit.Normal, nil, nil
                        end
                        return inst, hit.Position, hit.Normal, hit.Material
                    end

                    local thick = 0.25
                    pcall(function()
                        local far = hit.Position + dir.Unit * 60
                        local back = RaycastParams.new()
                        back.FilterType = Enum.RaycastFilterType.Include
                        back.FilterDescendantsInstances = { inst }
                        local exit = AR2_Workspace:Raycast(far, hit.Position - far, back)
                        if exit then
                            local t = (exit.Position - hit.Position).Magnitude
                            if t > 0 then thick = t end
                        end
                    end)

                    spent = spent + thick
                    AR2_lastWallCount = (AR2_lastWallCount or 0) + 1
                    if spent > budget then
                        return nil, hit.Position, hit.Normal, hit.Material
                    end

                    params:AddToFilter(inst)
                end
                return nil, origin + dir, Vector3.new(0, 1, 0), Enum.Material.Air
            end

            AR2_raycastingLib.BulletCastLight = function(self, ray, filter, a3, a4)
                local prev = AR2_wbInPierce
                AR2_wbInPierce = true
                local ok, r1, r2, r3, r4 = pcall(wbBody, self, ray, filter, a3, a4)
                AR2_wbInPierce = prev

                if not ok then
                    return AR2_wallbangFilterOrig(self, ray, filter, a3, a4)
                end

                if r1 == nil and AR2_CFG.weapon.hbeOn and AR2_hbeCandPart
                   and os.clock() < (AR2_bulletCastUntil or 0) then
                    local p = AR2_hbeCandPoint
                    if p and (p - ray.Origin).Magnitude <= ray.Direction.Magnitude then
                        AR2_hbeSwaps = (AR2_hbeSwaps or 0) + 1
                        return AR2_hbeCandPart, p,
                               (ray.Origin - p).Unit, Enum.Material.Plastic
                    end
                end

                return r1, r2, r3, r4
            end
        end
    elseif AR2_wallbangFilterOrig then
        pcall(function() AR2_raycastingLib.BulletCastLight = AR2_wallbangFilterOrig end)
        AR2_wallbangFilterOrig = nil
    end
end



