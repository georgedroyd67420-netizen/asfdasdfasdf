            end

            local dd
            local function apply(text)
                text = string.lower(tostring(text or ""))
                local out = {}
                for _,v in ipairs(full) do
                    if text == "" or string.find(string.lower(tostring(v)),text,1,true) then
                        out[#out+1] = v
                        if #out >= AR2_DROP_CAP then break end
                    end
                end
                if #out == 0 then out = { "(no match)" } end
                if dd and type(dd.SetValues)=="function" then
                    pcall(function() dd:SetValues(out) end)
                end
                return #out
            end

            local okInput = pcall(function()
                section:AddInput({
                    Text = label.." filter",
                    Placeholder = "type to narrow ("..#full.." total)",
                    Callback = function(v) apply(v) end,
                })
            end)
            if not okInput then
