function AR2_onServerImpact(pos, dmg)
    AR2_ibHits    = (AR2_ibHits or 0) + 1
    AR2_regHits   = (AR2_regHits or 0) + 1
    AR2_regLastAt = os.clock()
    AR2_lastImpactPos = pos
    AR2_lastImpactAt  = os.clock()

    if not AR2_CFG.misc.srvDrivenFX then return end

    local who = AR2_victimAtPosition(pos)
    local atPos = (typeof(pos) == "Vector3") and pos
        or ((typeof(pos) == "CFrame") and pos.Position or nil)

    if not atPos and who then
        local folder = AR2_Workspace:FindFirstChild("Characters")
        local mdl = folder and folder:FindFirstChild(who)
        local pt = mdl and (mdl:FindFirstChild("UpperTorso")
                         or mdl:FindFirstChild("HumanoidRootPart"))
        if pt then atPos = pt.Position end
    end

    if AR2_CFG.hitmarker.enabled then
        AR2_hitmarkerFlag = true
    end

    if AR2_CFG.misc.srvImpactFX and atPos then
        AR2_spawnImpactFX(atPos)
    end

    if AR2_CFG.misc.srvTracer and AR2_lastShotOrigin and atPos then
        AR2_addServerTracer(AR2_lastShotOrigin, atPos)
    end

    if atPos and AR2_lastAimPos
       and (os.clock() - (AR2_lastAimAt or 0)) < 1.5 then
        local err = (atPos - AR2_lastAimPos).Magnitude
        local e = AR2_shotErr
        e.n    = e.n + 1
        e.sum  = e.sum + err
        e.last = err
        if err > e.worst then e.worst = err end
    end

    if who then AR2_applyServerDamage(dmg, who) end
end

function AR2_installDamageListener()
    if AR2_dmgListenerOn then return true end
    local net = AR2_resolveNetTable()
    if not net or type(rawget(net, "Add")) ~= "function" then return false end

    local reg = nil
    for i = 1, 8 do
        local ok, uv = pcall(debug.getupvalue, net.Add, i)
        if ok and type(uv) == "table" then
            if rawget(uv, "Bullet Damage") ~= nil or rawget(uv, "Replicate Shot") ~= nil then
                reg = uv
                break
            end
        end
    end
    if not reg then return false end

    local orig = rawget(reg, "Bullet Damage")
    if type(orig) ~= "function" then return false end

    local function AR2_pickImpact(...)
        local n = select("#", ...)
        local vec, num
        for i = 1, n do
            local v = select(i, ...)
            local t = typeof(v)
            if not vec and t == "Vector3" then vec = v
            elseif not vec and t == "CFrame" then vec = v.Position
            elseif not num and t == "number" and v > 0 then num = v end
        end
        return vec, num
    end

    rawset(reg, "Bullet Damage", function(key, pos, dmg, colour)
        if not AR2_dmgSigLogged then
            AR2_dmgSigLogged = true
            pcall(function()
                print(string.format(
                    "[DROIDWARE DAMAGE] arg1=%s(%s)  arg2=%s(%s)  arg3=%s(%s)  arg4=%s(%s)",
                    typeof(key), tostring(key), typeof(pos), tostring(pos),
                    typeof(dmg), tostring(dmg), typeof(colour), tostring(colour)))
            end)
        end

        pcall(function()
            local vec, num = AR2_pickImpact(key, pos, dmg, colour)
            if num then
                AR2_netDamageCount = (AR2_netDamageCount or 0) + 1
                AR2_netDamageLast  = num
                AR2_netDamageAt    = os.clock()
                AR2_lastSeenDamage = num
                pcall(AR2_shotLogHit, num, true)
                pcall(AR2_onServerImpact, vec, num)
            end
        end)
        return orig(key, pos, dmg, colour)
    end)

    AR2_dmgListenerOn = true
    return true
end

function AR2_installNetHook()
    if AR2_netSendOrig then return true end
    local net = AR2_resolveNetTable()
    if not net or type(hookfunction) ~= "function" then return false end

    local ok = pcall(function()
        AR2_netSendOrig = hookfunction(net.Send, newcclosure(function(self, msg, ...)
            local res = table.pack(AR2_netSendOrig(self, msg, ...))

            if (AR2_CFG.misc.cosLearn or AR2_cosEnabled) and type(msg) == "string" then
                pcall(function()
                    if string.find(lm, "bullet", 1, true)
                    or string.find(lm, "shot", 1, true) then
                        AR2_ibShots  = (AR2_ibShots  or 0) + 1
                        AR2_regShots = (AR2_regShots or 0) + 1

                        if AR2_CFG.weapon.spreadFlySteady
                           and (AR2_CFG.misc.fly or AR2_CFG.misc.tpTour) then
                            pcall(function()
                                local c = AR2_LocalPlayer.Character
                                local r = c and c:FindFirstChild("HumanoidRootPart")
                                if r then
                                    r.AssemblyLinearVelocity = r.AssemblyLinearVelocity * 0.5
                                end
                            end)
                        end
                    end
                    AR2_cosSeenMsgs = AR2_cosSeenMsgs or {}
                    AR2_cosSeenMsgs[msg] = (AR2_cosSeenMsgs[msg] or 0) + 1
                end)
                local lm = string.lower(msg)
                if string.find(lm, "loadout", 1, true)
                or string.find(lm, "cosmetic", 1, true)
                or string.find(lm, "wardrobe", 1, true)
                or string.find(lm, "appearance", 1, true)
                or string.find(lm, "equip", 1, true)
                or string.find(lm, "dress", 1, true)
                or string.find(lm, "slot", 1, true)
                or string.find(lm, "hair", 1, true)
                or string.find(lm, "face", 1, true)
                or string.find(lm, "save", 1, true)
                or string.find(lm, "outfit", 1, true)
                or string.find(lm, "item", 1, true) then
                    local a = table.pack(...)
                    pcall(AR2_outfitCapture, msg, a)
                    local parts = {}
                    for i = 1, math.min(a.n, 6) do
                        local v = a[i]
                        parts[i] = (type(v) == "string")
                            and ('"' .. v .. '"')
                            or (typeof(v) .. (type(v) == "number" and ("=" .. v) or ""))
                    end
                    pcall(function()
                        AR2_cosEquipLog[#AR2_cosEquipLog+1] =
                            ("SEND %s(%s)"):format(msg, table.concat(parts, ", "))
                        if #AR2_cosEquipLog > 60 then table.remove(AR2_cosEquipLog, 1) end
                    end)
                end
            end

            if false then
                local packed = table.pack(...)
                task.spawn(function()
                    task.wait(AR2_CFG.weapon.netReloadDelay or 0.05)
                    pcall(function()
                        AR2_netSendOrig(self, "Character Reload Firearm Committed",
                            packed[1], packed[2])
                    end)
                end)
            end

            return table.unpack(res, 1, res.n)
        end))
    end)
    return ok and AR2_netSendOrig ~= nil
end

function setInstantReloadEnabled(enabled)
    AR2_instantReloadEnabled = enabled
    AR2_CFG.weapon.instantReload = enabled
    if enabled then
        AR2_instantReloadHook()
        AR2_instantReloadOnEquip()
        if not AR2_reloadWatchConn then
            AR2_reloadWatchConn = AR2_RunService.Heartbeat:Connect(function()
                if not AR2_instantReloadEnabled then
                    AR2_reloadWatchConn:Disconnect()
                    AR2_reloadWatchConn = nil
                    return
                end
                local now = os.clock()
                if now - AR2_reloadWatchLast < 4 then return end
                AR2_reloadWatchLast = now
                local pc = AR2_getPlayerClass()
                local actualChar = AR2_LocalPlayer.Character
                if pc and pc.Character ~= actualChar then return end
                local inner = AR2_getEquippedInner()
                if inner and not inner.__reloadHooked then AR2_instantReloadHook() end
            end)
        end
    else
        if AR2_reloadWatchConn then
            AR2_reloadWatchConn:Disconnect()
            AR2_reloadWatchConn = nil
        end
        AR2_reloadWatchLast = 0
        for weapon, origFunc in pairs(AR2_instantReloadOriginalMap) do
            if weapon and type(weapon.OnReload) == "function" then
                weapon.OnReload = origFunc
                weapon.__reloadHooked = nil
            end
        end
        table.clear(AR2_instantReloadOriginalMap)
        if AR2_instantReloadEquipConn then
            AR2_instantReloadEquipConn:Disconnect()
            AR2_instantReloadEquipConn = nil
        end
    end
end

local function AR2_reloadRespawnSetup(newChar)
    task.spawn(function()
        local deadline = os.clock() + 15
        while os.clock() < deadline do
            if not AR2_instantReloadEnabled then return end
            local hum = newChar:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Health > 0 and newChar:FindFirstChild("HumanoidRootPart") then
                task.wait(2)
                if not AR2_instantReloadEnabled then return end
                AR2_instantReloadHook()
                AR2_instantReloadOnEquip()
                return
            end
            task.wait(0.25)
        end
        if AR2_instantReloadEnabled then
            AR2_instantReloadHook()
            AR2_instantReloadOnEquip()
        end
    end)
end

