function AR2_dumpTable(t, depth, prefix, out)
    depth = depth or 0
    if depth > 3 then return end
    local keys = {}
    pcall(function()
        for k in pairs(t) do keys[#keys+1] = k end
    end)
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    for _, k in ipairs(keys) do
        local v = t[k]
        local ty = typeof(v)
        if ty == "table" then
            out[#out+1] = ("%s%s = {"):format(prefix, tostring(k))
            AR2_dumpTable(v, depth + 1, prefix .. "  ", out)
            out[#out+1] = prefix .. "}"
        elseif ty == "string" then
            out[#out+1] = ('%s%s = "%s"'):format(prefix, tostring(k), tostring(v))
        elseif ty == "Instance" then
            out[#out+1] = ("%s%s = <%s %s>"):format(prefix, tostring(k), v.ClassName, v.Name)
        else
            out[#out+1] = ("%s%s = %s (%s)"):format(prefix, tostring(k), tostring(v), ty)
        end
    end
end

function AR2_cosDumpLoadout()
