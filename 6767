function AR2_setAntiRubberband(on)
    AR2_CFG.misc.antiRubber = on and true or false
    if not AR2_CFG.misc.antiRubber and not AR2_rubberOrig then return true, "off" end

    local reg = AR2_cosFindRegistry()
    if not reg then return false, "network registry not resolved" end

    if not AR2_rubberOrig then
        local orig = rawget(reg, "Rubberbanding")
        if type(orig) ~= "function" then return false, "no Rubberbanding callback" end
        AR2_rubberOrig = orig

        local wrapped = function(...)
            if AR2_CFG.misc.antiRubber then
                AR2_rubberBlocked = AR2_rubberBlocked + 1
                return nil
            end
            local a = table.pack(...)
            local res = table.pack(pcall(AR2_rubberOrig, table.unpack(a, 1, a.n)))
            if not res[1] then return nil end
            return table.unpack(res, 2, res.n)
        end
        pcall(function() rawset(reg, "Rubberbanding", wrapped) end)
    end
    return true, AR2_CFG.misc.antiRubber and "blocking corrections" or "passing corrections"
end

function AR2_legalResume(seconds)
    local char = AR2_LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false, "no root" end

    AR2_resumeCF    = root.CFrame
    AR2_resumeUntil = os.clock() + (tonumber(seconds) or AR2_CFG.misc.resumeHold or 0.6)

    pcall(function()
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    local gc = AR2_resolveGameCharacter()
    if gc then pcall(AR2_flattenFallStart, gc, root.Position.Y) end

    return true, "holding for " .. tostring(AR2_resumeUntil - os.clock())
end

AR2_RunService.Heartbeat:Connect(function()
    if not AR2_resumeCF then return end
    if os.clock() > AR2_resumeUntil then AR2_resumeCF = nil return end

    local char = AR2_LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then AR2_resumeCF = nil return end

    pcall(function()
        root.CFrame = AR2_resumeCF
        root.AssemblyLinearVelocity = Vector3.zero
        local gc = AR2_resolveGameCharacter()
        if gc then AR2_flattenFallStart(gc, root.Position.Y) end
    end)
end)


