            if gr then AR2_flattenFallStart(gc, gr.Position.Y) end

            local anim = rawget(gc, "Animator")
            if anim then
                local playing = false
                pcall(function() playing = anim:IsAnimationPlaying("Actions.Fall Impact") end)
                if playing then
                    local model = rawget(gc, "Instance") or char
                    local h = model and model:FindFirstChildOfClass("Humanoid")
                    local a = h and h:FindFirstChildOfClass("Animator")
                    if a then
                        for _, t in ipairs(a:GetPlayingAnimationTracks()) do
                            local n = tostring(t.Animation and t.Animation.Name or "")
                            if string.find(string.lower(n), "fall")
                            or string.find(string.lower(n), "stagger")
                            or string.find(string.lower(n), "ragdoll") then
                                pcall(function() t:Stop(0) end)
                            end
                        end
                    end
                end
            end
        end)
    end)
end

AR2_adsConn = nil

-- ---------------------------------------------------------------------------
-- FORCE SPRINT (standalone)
-- Previously this was a sub-option of ADS-while-sprint: it only ran inside that
-- heartbeat and only while MouseButton2 was held, so it needed ADS, it dropped
-- the moment you released aim, and it never applied while just walking.
-- Now it is its own loop that pins the sprint input every frame regardless of
-- ADS or which way you are moving.
AR2_sprintConn  = nil
AR2_sprintHeld  = {}
-- RunningInput is the sprint *input* flag. AR2 gates actual sprint on movement
-- direction internally, so we also pin any boolean field on the character class
-- that looks like the resolved sprint state. We only touch fields that already
-- exist AND are already booleans, so we never invent members on the class.
AR2_SPRINT_GATES = { "Running", "IsRunning", "Sprinting", "IsSprinting",
                     "CanRun", "CanSprint", "SprintInput", "RunInput" }

function AR2_setForceSprint(on)
    AR2_CFG.misc.forceSprint = on and true or false

    if AR2_sprintConn then AR2_sprintConn:Disconnect() AR2_sprintConn = nil end

    if not AR2_CFG.misc.forceSprint then
        pcall(function()
            local gc = AR2_resolveGameCharacter()
            if type(gc) ~= "table" then return end
            pcall(function() gc.RunningInput = false end)
            for f in pairs(AR2_sprintHeld) do pcall(function() gc[f] = false end) end
        end)
        AR2_sprintHeld = {}
        return true, "off"
    end

    AR2_sprintConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.misc.forceSprint then return end
        local gc = AR2_resolveGameCharacter()
        if type(gc) ~= "table" then return end

        -- pin the input every frame: survives respawn, menus, and ADS release
        if rawget(gc, "RunningInput") ~= true then
            pcall(function() gc.RunningInput = true end)
        end
        -- omnidirectional: re-assert the resolved state so strafing/backwards
        -- movement isn't gated back to walk speed
        for _, f in ipairs(AR2_SPRINT_GATES) do
            local cur = rawget(gc, f)
            if type(cur) == "boolean" and cur ~= true then
                if pcall(function() gc[f] = true end) then AR2_sprintHeld[f] = true end
            end
        end
    end)
    return true, "on"
end

-- Debug helper: prints every boolean field on the game character so we can find
-- the real sprint/direction gate if the candidate list above misses it.
function AR2_dumpCharFields()
    local gc = AR2_resolveGameCharacter()
    if type(gc) ~= "table" then warn("[sprint] no game character") return end
    local out = { "== GAME CHARACTER FIELDS ==" }
    for k, v in pairs(gc) do
        local t = typeof(v)
        if t == "boolean" or t == "number" then
            out[#out+1] = ("  %s = %s (%s)"):format(tostring(k), tostring(v), t)
        end
    end
    table.sort(out)
    local text = table.concat(out, "\n")
    print(text)
    if setclipboard then pcall(setclipboard, text) end
end

function AR2_setAdsWhileSprint(enabled)
    AR2_CFG.misc.adsWhileSprint = enabled and true or false

    if AR2_adsConn then AR2_adsConn:Disconnect() AR2_adsConn = nil end
    if not AR2_CFG.misc.adsWhileSprint then
        pcall(function()
            local gc = AR2_resolveGameCharacter()
            if type(gc) == "table" then
                -- don't clear sprint if the standalone force-sprint owns it
                if AR2_adsSetSprint and not AR2_CFG.misc.forceSprint then gc.RunningInput = false end
                if AR2_adsSetZoom   then gc.Zooming      = false end
            end
        end)
        AR2_adsSetSprint, AR2_adsSetZoom = false, false
        return
    end

    AR2_adsConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.misc.adsWhileSprint then return end

        pcall(function()
            local gc = AR2_resolveGameCharacter()
            if type(gc) ~= "table" then return end

            local holdingAim = AR2_UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

            if not holdingAim then
                -- only release sprint if force-sprint isn't holding it on its own
                if AR2_adsSetSprint and not AR2_CFG.misc.forceSprint then
                    pcall(function() gc.RunningInput = false end)
                    AR2_adsSetSprint = false
                end
                if AR2_adsSetZoom then
                    pcall(function() gc.Zooming = false end)
                    AR2_adsSetZoom = false
                end
                return
            end

            if rawget(gc, "Zooming") ~= true then
                pcall(function() gc.Zooming = true end)
                AR2_adsSetZoom = true
                AR2_adsForced = (AR2_adsForced or 0) + 1
            end

        end)
    end)
end

