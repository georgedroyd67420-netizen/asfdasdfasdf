    end
    if not tbl then return "captured call had no loadout table" end

    local out = { "== CAPTURED LOADOUT ==" }
    AR2_dumpTable(tbl, 0, "  ", out)
    local txt = table.concat(out, "\n")
    print(txt)
    pcall(function() setclipboard(txt) end)
    pcall(function() writefile("droidware_loadout.txt", txt) end)
    return txt
end

function AR2_cosApplyLoadoutToMe(fnName)
    local wr = AR2_cosFindWardrobe()
    if not wr then return false, "wardrobe not found" end

    fnName = fnName or "ApplyLoadout"
    local L = AR2_cosLearned and AR2_cosLearned[fnName]
    if not L then return false, fnName .. " not captured yet -- open a loadout first" end

    local fn = (AR2_cosHookedWR and AR2_cosHookedWR[fnName]) or rawget(wr, fnName)
    if type(fn) ~= "function" then return false, fnName .. " missing" end

    local char = AR2_LocalPlayer.Character
    if not char then return false, "no character" end

    local a = {}
    for i = 1, L.n do
        local v = L.args[i]
        if typeof(v) == "Instance" then a[i] = char else a[i] = v end
    end

    local ok, err = pcall(fn, table.unpack(a, 1, L.n))
    if ok then return true, fnName .. " applied to " .. char.Name end
    return false, tostring(err)
end


function AR2_cosDeepCopy(t)
    if type(t) ~= "table" then return t end
    local out = {}
    for k, v in pairs(t) do out[k] = AR2_cosDeepCopy(v) end
    return out
end

function AR2_cosCapturedLoadout()
    for _, fn in ipairs({ "ApplyLoadout", "DressFromLoadout" }) do
        local L = AR2_cosLearned and AR2_cosLearned[fn]
        if L then
            for i = 1, L.n do
                local v = L.args[i]
                if typeof(v) == "table" and v ~= AR2_cosWardrobe then
                    if rawget(v, "Equipment") ~= nil then return v, fn end
                end
            end
        end
    end
    return nil, nil
end

function AR2_cosSlotValue(key)
    local v = AR2_CFG.misc[key]
    if type(v) ~= "string" or v == "" or v == "None" or string.find(v, "^%(") then
        return "Default"
    end
    return v
end

function AR2_cosBuildLoadout()
    local src = AR2_cosCapturedLoadout()
    if not src then return nil, "no loadout captured -- open one in the menu with Learn Mode on" end

    local L = AR2_cosDeepCopy(src)
    L.Equipment = L.Equipment or {}
    local E = L.Equipment

    E.Hat    = AR2_cosSlotValue("dressHat")
    E.Vest   = AR2_cosSlotValue("dressVest")
    E.Top    = AR2_cosSlotValue("dressTop")
    E.Belt   = AR2_cosSlotValue("dressBelt")
    E.Bottom = AR2_cosSlotValue("dressLeg")

    E.Accessory = type(E.Accessory) == "table" and E.Accessory or {}
    E.Accessory[1] = AR2_cosSlotValue("dressAcc")
    E.Accessory[2] = AR2_cosSlotValue("dressAcc2")

    local hair = AR2_cosSlotValue("dressHair")
    if hair ~= "Default" then L.Hairstyle = hair end

    local face = AR2_cosSlotValue("dressFace")
    if face ~= "Default" then L.FaceId = face end

    L.HairColor = math.floor(tonumber(AR2_CFG.misc.hairColor) or L.HairColor or 1)
    L.SkinColor = math.floor(tonumber(AR2_CFG.misc.skinColor) or L.SkinColor or 1)

    return L
end

function AR2_cosApplyBuilt()
    local wr = AR2_cosFindWardrobe()
    if not wr then return false, "wardrobe not found" end

    local built, why = AR2_cosBuildLoadout()
    if not built then return false, why end

    local char = AR2_LocalPlayer.Character
    if not char then return false, "no character" end

    local _, srcFn = AR2_cosCapturedLoadout()
    local order = (srcFn == "DressFromLoadout")
        and { "DressFromLoadout", "ApplyLoadout" }
        or  { "ApplyLoadout", "DressFromLoadout" }

    local lastErr
    for _, fnName in ipairs(order) do
        local L  = AR2_cosLearned and AR2_cosLearned[fnName]
        local fn = (AR2_cosHookedWR and AR2_cosHookedWR[fnName]) or rawget(wr, fnName)
        if type(fn) == "function" and L then
            local a = {}
            for i = 1, L.n do
                local v = L.args[i]
                if typeof(v) == "Instance" then a[i] = char
                elseif typeof(v) == "table" and v ~= wr then a[i] = built
                else a[i] = v end
            end
            local ok, err = pcall(fn, table.unpack(a, 1, L.n))
            if ok then return true, fnName .. " applied" end
            lastErr = err
        end
    end
    return false, tostring(lastErr or "no loadout function captured")
end

function AR2_cosFaceList()
    local list, seen = {}, {}
