function AR2_resolveGravTable()
    if AR2_gravTable then return AR2_gravTable end
    if not (AR2_originalFireFunction and AR2_CAP.getupvalue) then
        AR2_gravNote = "no getupvalue / no Fire ref"
        return nil
    end

    local stepFn
    pcall(function() stepFn = debug.getupvalue(AR2_originalFireFunction, 4) end)
    if type(stepFn) ~= "function" then
        AR2_gravNote = "step fn not at upvalue 4 (Fire may be wrapped)"
        return nil
    end

    for i = 1, 14 do
        local ok, uv = pcall(debug.getupvalue, stepFn, i)
        if ok and type(uv) == "table" and type(rawget(uv, "ProjectileGravity")) == "number" then
            AR2_gravTable = uv
            AR2_gravOrig  = uv.ProjectileGravity
            AR2_gravNote  = string.format("found at step upvalue %d, gravity=%.3f", i, AR2_gravOrig)
            return uv
        end
    end

    AR2_gravNote = "ProjectileGravity not found in step upvalues"
    return nil
end

function AR2_setNoDrop(on)
    local cfg = AR2_resolveGravTable()
    if not cfg then return false, AR2_gravNote end

    if AR2_gravConn then
        pcall(function() AR2_gravConn:Disconnect() end)
        AR2_gravConn = nil
    end

    if not on then
        pcall(function() cfg.ProjectileGravity = AR2_gravOrig end)
        AR2_gravNote = string.format("restored to %.3f", AR2_gravOrig or 0)
        return true, AR2_gravNote
    end

    local okWrite = pcall(function() cfg.ProjectileGravity = 0 end)
    if not okWrite then
        AR2_gravNote = "table is read-only"
        return false, AR2_gravNote
    end

    if cfg.ProjectileGravity ~= 0 then
        AR2_gravNote = "write did not stick (value is " .. tostring(cfg.ProjectileGravity) .. ")"
        return false, AR2_gravNote
    end

    AR2_gravConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.weapon.noDrop then return end
        if cfg.ProjectileGravity ~= 0 then
            pcall(function() cfg.ProjectileGravity = 0 end)
        end
    end)

    AR2_gravNote = string.format("gravity 0 (was %.3f), held each frame", AR2_gravOrig or 0)
    return true, AR2_gravNote
end

function AR2_installResolverHook()
    if AR2_resolverOrig then return true end
    if not (AR2_originalFireFunction and AR2_CAP.getupvalue and AR2_CAP.setupvalue) then return false end

    local stepFn
    pcall(function() stepFn = debug.getupvalue(AR2_originalFireFunction, 4) end)
    if type(stepFn) ~= "function" then return false end

    local resolver
    pcall(function() resolver = debug.getupvalue(stepFn, 5) end)
    if type(resolver) ~= "function" then return false end

    AR2_resolverOrig = resolver
    AR2_resolverStep = stepFn

    local function patched(ray, ignoreList, flag)
        local inst, pos, normal, a, b = AR2_resolverOrig(ray, ignoreList, flag)

        local okLogic, passThrough = pcall(function()
            pcall(function()
                local dy = ray.Direction.Y
                if AR2_gravPrevDirY then
                    local accel = (dy - AR2_gravPrevDirY) * 3600
                    if accel < -0.5 and accel > -500 then
                        local t = AR2_gravSamples
                        t[#t + 1] = -accel
                        if #t > 90 then table.remove(t, 1) end
                        local sum = 0
                        for _, v in ipairs(t) do sum = sum + v end
                        AR2_measuredGravity = sum / #t
                    end
                end
                AR2_gravPrevDirY = dy
            end)

            if inst == nil then return false end

            local isTarget = AR2_isDamageTarget(inst)

            if AR2_CFG.misc.shotLogger then
                pcall(function()
                    local e = AR2_shotLog and AR2_shotLog.pending
                    if not e then return end
                    if isTarget then
                        if not e.part then
                            e.part = inst.Name
                            e.dist = (pos - (e.origin or pos)).Magnitude
                        end
                    elseif not e.part then
                        e.blocked = inst.Name
                    end
                end)
            end

            if isTarget then return false end

            local key = (type(ignoreList) == "table") and ignoreList or nil
            if key and AR2_rageBulletKeys[key] == nil then
                local mark = AR2_rageFireMark or 0
                AR2_rageBulletKeys[key] = (mark > 0 and (os.clock() - mark) <= 0.20) and true or false
            end

            local pierceAll = false

            if not (pierceAll or AR2_CFG.weapon.wallbang) then return false end

            local unlimited = pierceAll or (AR2_CFG.weapon.penUnlimited == true)
            local budget    = math.min(tonumber(AR2_CFG.weapon.penBudget) or 12, 12)
            if not unlimited and budget <= 0 then return false end

            if pierceAll then AR2_ragePierceHits = (AR2_ragePierceHits or 0) + 1 end

            local spent = (key and AR2_penByBullet[key]) or 0

            local thick = 0
            if not unlimited then
                thick = AR2_penThickness(inst, pos, ray.Direction) or 0
                if spent + thick > budget then return false end
            end

            if key then AR2_penByBullet[key] = spent + thick end
            AR2_penSpent = spent + thick
            AR2_lastWallsPierced = (AR2_lastWallsPierced or 0) + 1

            pcall(function()
                local e = AR2_shotLog and AR2_shotLog.pending
                if e then
                    e.walls   = (e.walls or 0) + 1
                    e.studs   = (e.studs or 0) + thick
                    e.blocked = nil
                end
            end)

            pcall(function()
                if type(ignoreList) == "table" then table.insert(ignoreList, inst) end
            end)

            return true
        end)

        if not okLogic then
            AR2_resolverErrors = (AR2_resolverErrors or 0) + 1
            AR2_warnOnce("resolver",
                "[wallbang] resolver logic error (bullet preserved): " .. tostring(passThrough), 5)
            return inst, pos, normal, a, b
        end

        if passThrough then
            return nil, ray.Origin + ray.Direction, Vector3.new(0, 1, 0), a, b
        end

        return inst, pos, normal, a, b
    end

    local ok = pcall(function() debug.setupvalue(stepFn, 5, patched) end)
    if not ok then AR2_resolverOrig = nil AR2_resolverStep = nil end
    return ok
end

function AR2_removeResolverHook()
    if AR2_resolverOrig and AR2_resolverStep and AR2_CAP.setupvalue then
        pcall(function() debug.setupvalue(AR2_resolverStep, 5, AR2_resolverOrig) end)
    end
    AR2_resolverOrig, AR2_resolverStep = nil, nil
end

