local AR2_COS_BODY = {
    HumanoidRootPart=true, Head=true,
    UpperTorso=true, LowerTorso=true, Torso=true,
    ["Left Arm"]=true, ["Right Arm"]=true,
    ["Left Leg"]=true, ["Right Leg"]=true,
