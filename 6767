    local AR2_B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    local function AR2_b64encode(data)
        data = tostring(data)
        local out = {}
        local len = #data
        local i = 1
        while i <= len do
            local a1 = string.byte(data, i) or 0
            local a2 = string.byte(data, i + 1)
            local a3 = string.byte(data, i + 2)
            local n = a1 * 65536 + (a2 or 0) * 256 + (a3 or 0)
            local c1 = math.floor(n / 262144) % 64
            local c2 = math.floor(n / 4096) % 64
            local c3 = math.floor(n / 64) % 64
            local c4 = n % 64
            out[#out + 1] = AR2_B64CHARS:sub(c1 + 1, c1 + 1)
            out[#out + 1] = AR2_B64CHARS:sub(c2 + 1, c2 + 1)
            out[#out + 1] = a2 and AR2_B64CHARS:sub(c3 + 1, c3 + 1) or "="
            out[#out + 1] = a3 and AR2_B64CHARS:sub(c4 + 1, c4 + 1) or "="
            i = i + 3
        end
        return table.concat(out)
    end

    local AR2_B64LOOKUP = {}
    for idx = 1, #AR2_B64CHARS do
        AR2_B64LOOKUP[AR2_B64CHARS:sub(idx, idx)] = idx - 1
    end

    local function AR2_b64decode(data)
        data = tostring(data):gsub("[^%w%+%/%=]", "")
        local out = {}
        local i = 1
        while i <= #data do
            local ch = { data:sub(i, i), data:sub(i + 1, i + 1), data:sub(i + 2, i + 2), data:sub(i + 3, i + 3) }
            local v = {}
            for k = 1, 4 do v[k] = AR2_B64LOOKUP[ch[k]] or 0 end
            local n = v[1] * 262144 + v[2] * 4096 + v[3] * 64 + v[4]
            out[#out + 1] = string.char(math.floor(n / 65536) % 256)
            if ch[3] ~= "=" and ch[3] ~= "" then out[#out + 1] = string.char(math.floor(n / 256) % 256) end
            if ch[4] ~= "=" and ch[4] ~= "" then out[#out + 1] = string.char(n % 256) end
            i = i + 4
        end
        return table.concat(out)
    end

    NL.Base64Encode = (crypt and (crypt.base64encode or crypt.base64_encode or (crypt.base64 and crypt.base64.encode)))
        or base64_encode or (base64 and base64.encode) or AR2_b64encode
    NL.Base64Decode = (crypt and (crypt.base64decode or crypt.base64_decode or (crypt.base64 and crypt.base64.decode)))
