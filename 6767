function AR2_installCrashGuard()
    if AR2_crashGuardDone then return true end

    local ok = pcall(function()
        local Net = require(AR2_ReplicatedFirst:WaitForChild("Framework", 30)).Libraries.Network
        if type(Net) ~= "table" or type(Net.Add) ~= "function" then return end

        local DEAD_MANS = "Did You Hear What Steve Jobs Died From?"
        pcall(function() Net:Remove(DEAD_MANS, true) end)
        local okA = pcall(function()
            Net:Add(DEAD_MANS, function() end)
        end)
        AR2_crashGuardLog[#AR2_crashGuardLog + 1] =
            (okA and "neutralised: dead-man handler" or "FAILED: dead-man handler")

        pcall(function() Net:Remove("\r", true) end)
        local okB = pcall(function()
            Net:Add("\r", function(...)
                local a = table.pack(...)
                if not (os.clock() * 10000 % 1 > 0.5) then
                    Net:Send(table.unpack(a, 1, a.n))
                    return
                end
                pcall(function() Net:Fetch(table.unpack(a, 1, a.n)) end)
                Net:Send(table.unpack(a, 1, a.n))
            end)
        end)
        AR2_crashGuardLog[#AR2_crashGuardLog + 1] =
            (okB and "neutralised: conditional handler" or "FAILED: conditional handler")

        AR2_crashGuardDone = okA and okB
    end)

    if not ok then
        AR2_crashGuardLog[#AR2_crashGuardLog + 1] = "FAILED: could not reach Network module"
    end
    return AR2_crashGuardDone
end

