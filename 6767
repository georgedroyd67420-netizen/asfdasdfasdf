function AR2_volleyApply()
    local item = AR2_volleyOuterItem()
    if not item then return end

    local inner = rawget(item, "__item") or item
    local c     = AR2_CFG.weapon

    local okFc, fc = pcall(function() return item.FireConfig end)
    if not okFc or type(fc) ~= "table" then return end

    if c.volley then
        if AR2_volleyFcSaved[inner] == nil then
            AR2_volleyFcSaved[inner]   = fc
            AR2_volleyModeSaved[inner] = item.FireMode
        end

        local live = fc

        if not rawget(fc, "__ar2") then
            local copy = { __ar2 = true }
            for k, v in pairs(fc) do copy[k] = v end

            pcall(function() inner.FireConfig = copy end)

            local okR, now = pcall(function() return item.FireConfig end)
            if not (okR and type(now) == "table" and rawget(now, "__ar2")) then
                pcall(function() rawset(inner, "FireConfig", copy) end)
                okR, now = pcall(function() return item.FireConfig end)
                if not (okR and type(now) == "table" and rawget(now, "__ar2")) then
                    return
                end
            end
            live = now
        end

        local mode = AR2_volleyModeSaved[inner] or item.FireMode
        local key  = AR2_volleyRateKey[mode] or "FireRate"
        local rate = live[key] or live.FireRate or live.SemiFireRate or live.AutoFireRate
        if type(rate) ~= "number" or rate <= 0 then return end

        live.BurstCount            = AR2_VOLLEY_MAX
        live.BurstFireRate         = rate
        live.BurstFireRateModifier = math.max(tonumber(c.volleyGap) or 100, 1) / 100

        pcall(function() inner.FireMode = "Burst" end)
        pcall(function() item.FireMode  = "Burst" end)

    elseif AR2_volleyFcSaved[inner] ~= nil then
        local savedFc   = AR2_volleyFcSaved[inner]
        local savedMode = AR2_volleyModeSaved[inner]

        pcall(function() inner.FireConfig = savedFc end)

        if savedMode then
            pcall(function() inner.FireMode = savedMode end)
            pcall(function() item.FireMode  = savedMode end)
        end

        AR2_volleyFcSaved[inner]   = nil
        AR2_volleyModeSaved[inner] = nil
    end
end

