            local stillHere = (cur == nil or cur == "-" or cur == "None")
            if not stillHere then
                for _, n in ipairs(names) do
                    if n == cur then stillHere = true break end
                end
            end
            if not stillHere then
                AR2_CFG.tp.target = "-"
                AR2_setDropdownValue(targetDropdown, "None")
                AR2_setDropdownValue(carTPDropdown, "None")
            end
            if notify then
