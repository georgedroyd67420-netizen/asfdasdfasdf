function AR2_removeAllHooks()
    local removed = {}

    local wr = AR2_cosWardrobe
    if type(wr) == "table" and type(AR2_cosHookedWR) == "table" then
        for name, orig in pairs(AR2_cosHookedWR) do
            if type(orig) == "function" then
                pcall(function() rawset(wr, name, orig) end)
                removed[#removed+1] = name
            end
        end
        AR2_cosHookedWR = {}
    end

    local reg = AR2_cosRegistry
    if type(reg) == "table" and type(AR2_cosInvHooked) == "table" then
        for key, orig in pairs(AR2_cosInvHooked) do
            if type(orig) == "function" then
                pcall(function() rawset(reg, key, orig) end)
                removed[#removed+1] = key
            end
        end
        AR2_cosInvHooked = {}
    end

    if type(reg) == "table" and type(AR2_rubberOrig) == "function" then
        pcall(function() rawset(reg, "Rubberbanding", AR2_rubberOrig) end)
        AR2_rubberOrig = nil
        AR2_CFG.misc.antiRubber = false
        removed[#removed+1] = "Rubberbanding"
    end

    if #removed == 0 then return true, "none were installed" end
    return true, ("removed %d: %s"):format(#removed, table.concat(removed, ", "))
end

