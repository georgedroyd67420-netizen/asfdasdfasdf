function AR2_bagSaveTune()
    local key = AR2_bagTuneKey()
    if not key then return false, "pick a bag first" end

    local entries = {}
    for pair in string.gmatch(tostring(AR2_CFG.misc.bagTunes or ""), "[^|]+") do
        local k = string.match(pair, "^(.-)=")
        if k and k ~= key then entries[#entries+1] = pair end
    end

    entries[#entries+1] = ("%s=%s,%s,%s,%s,%s,%s,%s"):format(key,
        tostring(AR2_CFG.misc.bagOffX  or 0), tostring(AR2_CFG.misc.bagOffY or 0),
        tostring(AR2_CFG.misc.bagOffZ  or 0), tostring(AR2_CFG.misc.bagYaw  or 0),
        tostring(AR2_CFG.misc.bagPitch or 0), tostring(AR2_CFG.misc.bagRoll or 0),
        tostring(AR2_CFG.misc.bagScale or 1))

    AR2_CFG.misc.bagTunes = table.concat(entries, "|")
    return true, "saved placement for " .. key
end

function AR2_bagLoadTune()
    local key = AR2_bagTuneKey()
    if not key then return false, "no bag selected" end

    for pair in string.gmatch(tostring(AR2_CFG.misc.bagTunes or ""), "[^|]+") do
        local k, rest = string.match(pair, "^(.-)=(.*)$")
        if k == key and rest then
            local v = {}
            for num in string.gmatch(rest, "[^,]+") do v[#v+1] = tonumber(num) end
            if #v >= 7 then
                AR2_CFG.misc.bagOffX, AR2_CFG.misc.bagOffY  = v[1], v[2]
                AR2_CFG.misc.bagOffZ, AR2_CFG.misc.bagYaw   = v[3], v[4]
                AR2_CFG.misc.bagPitch, AR2_CFG.misc.bagRoll = v[5], v[6]
                AR2_CFG.misc.bagScale = v[7]
                return true, "loaded placement for " .. key
            end
        end
    end
    return false, "no saved placement for " .. key
end


