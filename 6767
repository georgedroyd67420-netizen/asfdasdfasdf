function AR2_cosFindRegistry()
    if AR2_cosRegistry then return AR2_cosRegistry end
    local net = AR2_resolveNetTable()
    if not net or type(rawget(net, "Add")) ~= "function" then return nil end
    for i = 1, 8 do
        local ok, uv = pcall(debug.getupvalue, net.Add, i)
        if ok and type(uv) == "table" then
            if rawget(uv, "Bullet Damage") ~= nil or rawget(uv, "Replicate Shot") ~= nil then
                AR2_cosRegistry = uv
                return uv
            end
        end
    end
    return nil
end

function AR2_cosDescribe(a)
    local parts = {}
    for i = 1, math.min(a.n, 8) do
        local v = a[i]
        local t = typeof(v)
        if t == "string" then
            parts[i] = '"' .. tostring(v) .. '"'
        elseif t == "number" or t == "boolean" then
            parts[i] = t .. "=" .. tostring(v)
        elseif t == "table" then
            local keys = {}
            pcall(function()
                for k in pairs(v) do
                    if type(k) == "string" then keys[#keys+1] = k end
                    if #keys >= 8 then break end
                end
            end)
            table.sort(keys)
            parts[i] = "table{" .. table.concat(keys, ",") .. "}"
        else
            parts[i] = t
        end
    end
    return table.concat(parts, ", ")
end

function AR2_cosLearnInbound()
    local reg = AR2_cosFindRegistry()
    if not reg then return false, "registry not found" end

    local n = 0
    AR2_cosInvHooked = AR2_cosInvHooked or {}
    for _, key in ipairs(AR2_COS_INBOUND) do
        local orig = rawget(reg, key)
        if type(orig) == "function" and not AR2_cosInvHooked[key] then
            AR2_cosInvHooked[key] = orig
            local wrapped = function(...)
                local a = table.pack(...)
                if key == "Loadout Dressed" and typeof(a[1]) == "string" then
                    AR2_lastLoadoutId = a[1]
                end
                if not AR2_cosInvLearned[key] then
                    AR2_cosInvLearned[key] = AR2_cosDescribe(a)
                    local line = ("RECV %s(%s)"):format(key, AR2_cosInvLearned[key])
                    pcall(function()
                        AR2_cosEquipLog = AR2_cosEquipLog or {}
                        AR2_cosEquipLog[#AR2_cosEquipLog+1] = line
                        if #AR2_cosEquipLog > 60 then table.remove(AR2_cosEquipLog, 1) end
                    end)
                                end
                local res = table.pack(pcall(orig, table.unpack(a, 1, a.n)))
                if not res[1] then return nil end
                return table.unpack(res, 2, res.n)
            end
            pcall(function() rawset(reg, key, wrapped) end)
            n = n + 1
        end
    end
    return true, ("watching %d inbound"):format(n)
end


