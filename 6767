function AR2_findItemData()
    if type(AR2_itemData) == "table" then return AR2_itemData end
    local best, bestN = nil, 0
    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "table" then
            local n, looksRight = 0, false
            pcall(function()
                for k, v in pairs(obj) do
                    n = n + 1
                    if type(k) == "string" and type(v) == "table"
                       and rawget(v, "RealName") ~= nil and rawget(v, "Type") ~= nil then
                        looksRight = true
                    end
                    if n > 3000 then break end
                end
            end)
            if looksRight and n > bestN then best, bestN = obj, n end
        end
    end
    AR2_itemData = best
    return best
end

