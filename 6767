local function AR2_doInventoryFire(part)
    if not AR2_lastFireParams or not AR2_originalFireFunction then return end

    if not AR2_fireParamsUsable(AR2_lastFireParams) then
        AR2_hasRealWD  = false
        AR2_autoSeeded = false
        AR2_warnOnce("invfire", "[ragebot] seeded weapon data is stale -- equip and fire once to re-seed", 5)
        return
    end

    local pc = AR2_lastFireParams.pc
    local wi = AR2_lastFireParams.wi
    local wd = AR2_lastFireParams.wd
    local char = AR2_LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local origin = hrp and (hrp.Position + Vector3.new(0,1.5,0)) or AR2_localPosition()
    local dir = (part.Position - origin).Unit

    local dest    = part.Position
    local blocker = nil

    if AR2_CFG.weapon.fakeWindows then
        pcall(AR2_fakeWindowPath, origin, dest, 6)
    end

    if AR2_CFG.weapon.ignoreInject then
        pcall(AR2_ignorePathParts, origin, dest, 8)
        task.delay(math.clamp((tonumber(AR2_CFG.weapon.ignoreHoldMs) or 600) / 1000, 0.05, 3),
            function() pcall(AR2_releaseIgnoredParts) end)
    end

    if false then
        local newOrigin, moved, stillBlocked = AR2_findLegalOrigin(origin, dest)
        blocker = stillBlocked
        if moved > 0.01 then
            origin = newOrigin
            local nd = dest - origin
            if nd.Magnitude > 0.001 then dir = nd.Unit end
            AR2_lastOriginAdj = moved
        end
    elseif AR2_CFG.rageBot.legalOnly then
        blocker = AR2_serverPathBlocked(origin, dest)
    end

    AR2_lastPathBlocker = blocker and blocker.Name or nil

    if blocker and AR2_CFG.rageBot.legalOnly then
        AR2_pathSkips = (AR2_pathSkips or 0) + 1
        AR2_warnOnce("legalpath",
            "[ragebot] skipped: server would stop the bullet at " .. tostring(blocker.Name), 4)
        return
    end

    local saved, spoofed = nil, false
    pcall(function()
        if pc and pc.Character then
            saved = pc.Character.EquippedItem
            if not saved then
                pc.Character.EquippedItem = wi
                spoofed = true
            end
        end
    end)

    AR2_rageShotActive = true
    AR2_rageShotPart   = part
    AR2_rageShotUntil  = os.clock() + 0.25
    AR2_rageFireMark   = os.clock()

    local fireFn = (AR2_Bullets and AR2_Bullets.Fire) or AR2_originalFireFunction
    local ok, err = pcall(fireFn,
        AR2_lastFireParams.self, pc, wi, wd,
        origin, dir, math.random(100000, 999999)
    )

    AR2_rageShotActive = false

    if spoofed then
        pcall(function()
            if pc and pc.Character then
                pc.Character.EquippedItem = saved
            end
        end)
    end
    if not ok then
        AR2_hasRealWD  = false
        AR2_autoSeeded = false
        AR2_warnOnce("invfire2", "[ragebot] inv fire failed: " .. tostring(err), 5)
    end
end

