AR2_shotLog = { rows = {}, objs = {}, pending = nil, conn = nil }

AR2_penTable = {}

function AR2_penTableNote(walls, studs, registered)
    local k = math.clamp(math.floor(tonumber(walls) or 0), 0, 12)
    local r = AR2_penTable[k]
    if not r then
        r = { shots = 0, hits = 0, studs = 0 }
        AR2_penTable[k] = r
    end
    r.shots = r.shots + 1
    r.studs = r.studs + (tonumber(studs) or 0)
    if registered then r.hits = r.hits + 1 end
end

function AR2_penTableReport()
    local lines = {}
    for k = 0, 12 do
        local r = AR2_penTable[k]
        if r and r.shots > 0 then
            lines[#lines + 1] = string.format(
                "%2d walls | %3d shots | %3d server hits | %5.1f%% | avg %.1f studs",
                k, r.shots, r.hits, (r.hits / r.shots) * 100, r.studs / r.shots)
        end
    end
    if #lines == 0 then
        return "no shots recorded yet -- turn the Shot Logger on and fire"
    end
    return table.concat(lines, "\n")
end
AR2_lastOriginAdj = 0

local function AR2_shotLogNewRow()
    local tick = Drawing.new("Square")
    tick.Thickness, tick.Filled, tick.Visible = 1, true, false
    tick.Size = Vector2.new(2, 11)

    local main = Drawing.new("Text")
    main.Font, main.Size, main.Outline, main.Visible, main.Center = 2, 14, true, false, false

    local stat = Drawing.new("Text")
    stat.Font, stat.Size, stat.Outline, stat.Visible, stat.Center = 2, 14, true, false, false

    return { tick = tick, main = main, stat = stat }
end

local function AR2_shotLogEnsure(n)
    while #AR2_shotLog.objs < n do
        local ok, row = pcall(AR2_shotLogNewRow)
        if not ok then return end
        table.insert(AR2_shotLog.objs, row)
    end
end

local function AR2_shotLogHideRow(row)
    row.tick.Visible = false
    row.main.Visible = false
    row.stat.Visible = false
end

function AR2_shotLogClear()
    for _, row in ipairs(AR2_shotLog.objs) do
        pcall(function() row.tick:Remove() end)
        pcall(function() row.main:Remove() end)
        pcall(function() row.stat:Remove() end)
    end
    AR2_shotLog.objs = {}
    AR2_shotLog.rows = {}
    AR2_shotLog.pending = nil
end

function AR2_shotLogFinalize(e)
    if not e or e.counted then return end
    e.counted = true
    pcall(AR2_penTableNote, e.walls or 0, e.studs or 0, e.srv == true)
end

function AR2_shotLogOpen(dist, originAdj, walls, studs, origin)
    if not (AR2_CFG.misc.shotLogger or AR2_ibEnabled) then return end
    pcall(AR2_shotLogFinalize, AR2_shotLog.pending)
    local e = {
        t         = os.clock(),
        dist      = dist or 0,
        originAdj = originAdj or 0,
        walls     = walls or 0,
        studs     = studs or 0,
        origin    = origin,
        part      = nil,
        blocked   = nil,
        ib        = AR2_ibEnabled and (AR2_ibEffectiveMult or 1) or nil,
        dmg       = 0,
        reg       = nil,
    }
    AR2_shotLog.pending = e
    table.insert(AR2_shotLog.rows, 1, e)
    local cap = math.clamp(AR2_CFG.misc.shotLoggerLines or 8, 3, 14)
    while #AR2_shotLog.rows > cap do table.remove(AR2_shotLog.rows) end
end

function AR2_shotLogHit(amount, fromServer)
    local e = AR2_shotLog.pending
    if not e then return end
    if fromServer then
        if not e.srv then
            e.srv = true
            e.counted = true
            pcall(AR2_penTableNote, e.walls or 0, e.studs or 0, true)
        end
    end
    if os.clock() - e.t > 1.3 then
        AR2_shotLog.pending = nil
        return
    end
    e.dmg = e.dmg + (tonumber(amount) or 0)
    if not e.reg then
        pcall(AR2_rtNote, e)
        e.reg = true
        if AR2_ibEnabled then
            AR2_ibHitsConfirmed = AR2_ibHitsConfirmed + 1
            pcall(function()
                local gs = AR2_ibGunStat(AR2_ibLastSpd)
                gs.hits = gs.hits + 1
                if gs.shots > 0 then gs.rate = gs.hits / gs.shots end
            end)
            pcall(AR2_ibOutcome, e.ib, true)
        end
    end
end

local function AR2_shotLogTextWidth(obj)
    local w = nil
    pcall(function()
        local b = obj.TextBounds
        if typeof(b) == "Vector2" and b.X > 0 then w = b.X end
    end)
    return w or (#tostring(obj.Text) * 7.4)
end

function AR2_shotLogStart()
    if AR2_shotLog.conn then return end
    AR2_shotLog.conn = AR2_RunService.RenderStepped:Connect(function()
        local okRun = pcall(function()
            local now  = os.clock()

            local p = AR2_shotLog.pending
            if p and p.reg == nil and now - p.t > 1.3 then
                p.reg = false
                AR2_shotLog.pending = nil
                pcall(AR2_rtNote, p)
                if not p.blocked then pcall(AR2_ibOutcome, p.ib, false) end
            end

            local show = AR2_CFG.misc.shotLogger == true
            if not show then
                for _, row in ipairs(AR2_shotLog.objs) do AR2_shotLogHideRow(row) end
                return
            end

            local life = math.clamp(AR2_CFG.misc.shotLoggerTime or 5, 1, 20)

            local cap = math.clamp(AR2_CFG.misc.shotLoggerLines or 8, 3, 14)
            local n   = math.min(#AR2_shotLog.rows, cap)
            AR2_shotLogEnsure(n)

            local cam = AR2_Workspace.CurrentCamera
            local vp  = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
            local lineH = 17
            local x  = 18
            local y0 = math.floor(vp.Y * 0.5 - (n * lineH) * 0.5)
            local accent = (AR2_CFG.ui and AR2_CFG.ui.accent) or Color3.fromRGB(230, 30, 40)

            if AR2_ibEnabled then
                AR2_shotLogEnsure(n + 1)
                local hdr = AR2_shotLog.objs[#AR2_shotLog.objs]
                if hdr then
                    local pct = AR2_ibLastRate
                    local rateTxt = (pct and pct >= 0)
                        and string.format("%d%% reg", math.floor(pct * 100 + 0.5))
                        or "sampling"
                    local gs = AR2_ibGunStat(AR2_ibLastSpd)
                    local gunTxt = (gs.rate and gs.rate >= 0)
                        and string.format("gun %d%%", math.floor(gs.rate * 100 + 0.5))
                        or "gun --"
                    hdr.main.Text = string.format("INSTA  x%.2f  cap:%s  safe<=%.2f   %s   %s   %d shots",
                        AR2_ibEffectiveMult or 1,
                        AR2_ibLastCapWhy ~= "" and AR2_ibLastCapWhy or "-",
                        AR2_ibSafeMax(AR2_ibLastSpd),
                        rateTxt, gunTxt, AR2_ibShotsFired or 0)
                    hdr.main.Position = Vector2.new(x + 8, y0 - lineH - 4)
                    hdr.main.Color = accent
                    hdr.main.Transparency = 1
                    hdr.main.Visible = true
                    hdr.stat.Visible = false
                    hdr.tick.Position = Vector2.new(x, y0 - lineH - 2)
                    hdr.tick.Size = Vector2.new(2, 11)
                    hdr.tick.Color = accent
                    hdr.tick.Transparency = 1
                    hdr.tick.Visible = true
                end
            end

            for i = 1, #AR2_shotLog.objs do
                local row = AR2_shotLog.objs[i]
                local e   = AR2_shotLog.rows[i]
                if AR2_ibEnabled and i == #AR2_shotLog.objs then
                elseif not e or i > n then
                    AR2_shotLogHideRow(row)
                else
                    local age = now - e.t
                    if age > life then
                        AR2_shotLogHideRow(row)
                    else
                        local fade = math.clamp((life - age) / 1.0, 0, 1)
                        local y = y0 + (i - 1) * lineH

                        local originTxt = e.originAdj > 0.05
                            and string.format("origin +%.1f", e.originAdj)
                            or  "origin --"
                        local wallTxt = e.walls > 0
                            and string.format("walls %d / %.1f studs", e.walls, e.studs)
                            or  "clear path"

                        local ibTxt = e.ib and string.format("   IB x%.2f", e.ib) or ""
                        row.main.Text     = string.format("%4.0fm   %s   %s%s", e.dist, originTxt, wallTxt, ibTxt)
                        row.main.Position = Vector2.new(x + 8, y)
                        row.main.Color    = Color3.fromRGB(214, 209, 202)
                        row.main.Transparency = fade
                        row.main.Visible  = true

                        local statTxt, statCol
                        if e.reg == true then
                            statTxt = e.part
                                and string.format("%s %s  %d dmg", e.srv and "SRV HIT" or "HIT", e.part, math.floor(e.dmg + 0.5))
                                or  string.format("%s  %d dmg", e.srv and "SRV HIT" or "HIT", math.floor(e.dmg + 0.5))
                            statCol = Color3.fromRGB(120, 230, 140)
                        elseif e.reg == false then
                            if e.blocked then
                                statTxt = "BLOCKED  " .. tostring(e.blocked):sub(1, 22)
                                statCol = Color3.fromRGB(245, 175, 70)
                            elseif e.part then
                                statTxt = "NO REG  (" .. e.part .. ")"
                                statCol = Color3.fromRGB(240, 95, 95)
                            else
                                statTxt = "NO HIT"
                                statCol = Color3.fromRGB(150, 150, 160)
                            end
                        else
                            statTxt = "..."
                            statCol = Color3.fromRGB(190, 180, 120)
                        end

                        row.stat.Text     = statTxt
                        row.stat.Position = Vector2.new(x + 8 + AR2_shotLogTextWidth(row.main) + 12, y)
                        row.stat.Color    = statCol
                        row.stat.Transparency = fade
                        row.stat.Visible  = true

                        row.tick.Position = Vector2.new(x, y + 2)
                        row.tick.Size     = Vector2.new(2, 11)
                        row.tick.Color    = e.reg == true and Color3.fromRGB(120, 230, 140) or accent
                        row.tick.Transparency = fade
                        row.tick.Visible  = true
                    end
                end
            end
        end)
        if not okRun then end
    end)
end

function AR2_shotLogStop()
    if AR2_shotLog.conn then
        pcall(function() AR2_shotLog.conn:Disconnect() end)
        AR2_shotLog.conn = nil
    end
    for _, row in ipairs(AR2_shotLog.objs) do pcall(AR2_shotLogHideRow, row) end
end

