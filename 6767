function AR2_tourRootOf(plr)
    local c = plr and plr.Character
    if not c then return nil end
    local h = c:FindFirstChildWhichIsA("Humanoid")
    if not h or h.Health <= 0 then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

function AR2_tourMyRoot()
    local c = AR2_LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

function AR2_tourEligible(plr)
    if plr == AR2_LocalPlayer then return false end
    if AR2_tourVisited[plr] then return false end
    if AR2_CFG.misc.tourTeamCheck then
        local mt, pt = AR2_LocalPlayer.Team, plr.Team
        if mt ~= nil and pt ~= nil and mt == pt then return false end
    end
    return AR2_tourRootOf(plr) ~= nil
end

function AR2_tourPickTarget()
    local me = AR2_tourMyRoot()
    if not me then return nil end

    local best, bestD = nil, math.huge
    local maxD = tonumber(AR2_CFG.misc.tourMaxDist) or 5000
    for _, plr in ipairs(AR2_Players:GetPlayers()) do
        if AR2_tourEligible(plr) then
            local r = AR2_tourRootOf(plr)
            if r then
                local d = (r.Position - me.Position).Magnitude
                if d < bestD and d <= maxD then best, bestD = plr, d end
            end
        end
    end
    return best, bestD
end

function AR2_tourStandoff(targetRoot, myPos)
    local off = tonumber(AR2_CFG.misc.tourOffset) or 6
    local up  = tonumber(AR2_CFG.misc.tourHeight) or 3
    local dir = myPos - targetRoot.Position
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    return targetRoot.Position + dir.Unit * off + Vector3.new(0, up, 0)
end

AR2_tourSpeedCur  = nil
AR2_tourLastRub   = 0
AR2_tourLastTune  = 0

function AR2_tourSpeedNow()
    local ceiling = tonumber(AR2_CFG.misc.tourSpeed) or 4000
    if not AR2_CFG.misc.tourAutoTune then return ceiling end

    local floor = tonumber(AR2_CFG.misc.tourTuneFloor) or 400
    AR2_tourSpeedCur = AR2_tourSpeedCur or ceiling

    local now = os.clock()
    if now - AR2_tourLastTune < 0.5 then return AR2_tourSpeedCur end
    AR2_tourLastTune = now

    local rub = AR2_rubberBlocked or 0
    if rub > AR2_tourLastRub then
        AR2_tourSpeedCur = math.max(floor, AR2_tourSpeedCur * 0.5)
        AR2_tourNote = ("corrected, backing off to %.0f/s"):format(AR2_tourSpeedCur)
        AR2_tourLastRub = rub
    else
        AR2_tourSpeedCur = math.min(ceiling, AR2_tourSpeedCur * 1.15)
    end
    return AR2_tourSpeedCur
end

function AR2_tourStep(dt)
    local me = AR2_tourMyRoot()
    if not me then AR2_tourNote = "no character" return end

    if not AR2_CFG.misc.fly then
        AR2_tourNote = "waiting for fly"
        return
    end

    if AR2_tourState ~= "travel" then return end

    local tr = AR2_tourRootOf(AR2_tourTarget)
    if not tr then
        if AR2_tourTarget then AR2_tourVisited[AR2_tourTarget] = true end
        AR2_tourState, AR2_tourTarget, AR2_tourDest = "idle", nil, nil
        AR2_tourReleaseAnchor(me)
        AR2_tourNote = "target gone -- press again"
        return
    end

    local want  = AR2_tourDest or AR2_tourStandoff(tr, me.Position)
    local delta = want - me.Position
    local dist  = delta.Magnitude

    if dist <= (tonumber(AR2_CFG.misc.tourArrive) or 4) then
        AR2_tourReleaseAnchor(me)
        AR2_tourVisited[AR2_tourTarget] = true
        AR2_tourState, AR2_tourDest = "idle", nil
        AR2_tourNote = "arrived at " .. tostring(AR2_tourTarget and AR2_tourTarget.Name)
        return
    end

    pcall(function()
        if AR2_CFG.misc.tourAnchor and not me.Anchored then
            me.Anchored = true
            AR2_tourAnchored = true
        end
    end)

    local speed   = AR2_tourSpeedNow()
    local maxStep = tonumber(AR2_CFG.misc.tourMaxStep) or 250
    local step    = math.min(speed * dt, maxStep, dist)
    local nextPos = me.Position + delta.Unit * step

    pcall(function()
        me.CFrame = CFrame.lookAt(nextPos, tr.Position)
        me.AssemblyLinearVelocity = (dt > 0) and (delta.Unit * (step / dt)) or Vector3.zero
    end)
    AR2_tourNote = ("%s  %.0f studs"):format(AR2_tourTarget.Name, dist)
end

function AR2_tourReleaseAnchor(root)
    if not AR2_tourAnchored then return end
    pcall(function()
        local r = root
        if not r then
            local c = AR2_LocalPlayer.Character
            r = c and c:FindFirstChild("HumanoidRootPart")
        end
        if r then r.Anchored = false end
    end)
    AR2_tourAnchored = false
    if AR2_CFG.misc.autoResume then pcall(AR2_legalResume, 0.4) end
end

function AR2_tourGoNext()
    if not AR2_CFG.misc.tpTour then return false, "tour is off" end

    local me = AR2_tourMyRoot()
    if not me then return false, "no character" end

    if AR2_tourState == "travel" then
        if AR2_tourTarget then AR2_tourVisited[AR2_tourTarget] = true end
        AR2_tourState, AR2_tourTarget, AR2_tourDest = "idle", nil, nil
    end

    local t = AR2_tourPickTarget()
    if not t then
        AR2_tourVisited = {}
        AR2_tourLaps = (AR2_tourLaps or 0) + 1
        t = AR2_tourPickTarget()
        if not t then
            AR2_tourNote = "nobody in range"
            return false, "nobody in range"
        end
    end

    AR2_tourTarget = t
    AR2_tourState  = "travel"
    local tr0 = AR2_tourRootOf(t)
    AR2_tourDest = tr0 and AR2_tourStandoff(tr0, me.Position) or nil
    AR2_tourNote = "going to " .. t.Name
    return true, "going to " .. t.Name
end

function AR2_setTpTour(on)
    AR2_CFG.misc.tpTour = on and true or false

    if AR2_tourConn then AR2_tourConn:Disconnect() AR2_tourConn = nil end
    AR2_tourReleaseAnchor(nil)
    AR2_tourState, AR2_tourTarget, AR2_tourDest = "idle", nil, nil
    AR2_tourVisited, AR2_tourLaps = {}, 0

    if not AR2_CFG.misc.tpTour then
        AR2_tourNote = "off"
        return true, "off"
    end

    pcall(AR2_setAntiRubberband, AR2_CFG.misc.antiRubber)
    AR2_tourSpeedCur = tonumber(AR2_CFG.misc.tourSpeed) or 9000
    AR2_tourLastRub  = AR2_rubberBlocked or 0

    AR2_tourConn = AR2_RunService.Heartbeat:Connect(function(dt)
        if not AR2_CFG.misc.tpTour then return end
        pcall(AR2_tourStep, dt)
    end)

    AR2_tourNote = "ready -- press " .. tostring(AR2_CFG.misc.tourKey or "T")
    return true, AR2_tourNote
end

