        local hitSoundPresetNames = {}
        for _, preset in ipairs(AR2_HITSOUND_PRESETS) do table.insert(hitSoundPresetNames,preset.name) end
        local function getCurrentHitSoundPreset()
            for _, preset in ipairs(AR2_HITSOUND_PRESETS) do
                if preset.path == AR2_CFG.hitmarker.soundPath and preset.id == AR2_CFG.hitmarker.sound then return preset.name end
            end
            return "Custom..."
        end
        local hitSoundPresetDropdown = hmSection:AddLabel("Hit Sound Preset"):AddDropdown({
            Default=getCurrentHitSoundPreset(),
            Values=hitSoundPresetNames,
            Flag="origin_HitSoundPreset",
            Callback=function(selectedName)
                local selectedPreset
                for _,preset in ipairs(AR2_HITSOUND_PRESETS) do
                    if preset.name==selectedName then selectedPreset=preset break end
                end
                if selectedPreset then
                    if selectedPreset.name=="Custom..." then
                        AR2_CFG.hitmarker.sound="Custom..."
                        AR2_CFG.hitmarker.soundPath=AR2_CFG.hitmarker.soundPath or ""
                    else
                        AR2_CFG.hitmarker.sound=selectedPreset.id
                        AR2_CFG.hitmarker.soundPath=selectedPreset.path
                        AR2_hitSoundLoad(AR2_CFG.hitmarker.soundPath)
                    end
                    AR2_markDirty()
                end
            end
        })
        storeElement({getter=function() return getCurrentHitSoundPreset() end,setter=function(val) pcall(function() hitSoundPresetDropdown:Set(val) end) end})
