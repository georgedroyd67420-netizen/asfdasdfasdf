    if type(rawget(AR2_raycastingLib, "CastWithWhiteList")) ~= "function" then return false end

    AR2_whitelistOrig = AR2_raycastingLib.CastWithWhiteList

    AR2_raycastingLib.CastWithWhiteList = function(self, ray, list, ...)
        if AR2_CFG.weapon.alwaysHead and type(list) == "table" then
            local head
            for _, part in ipairs(list) do
                if part and part.Name == "Head" and part:IsA("BasePart") then
                    head = part
                    break
                end
            end

            if head then
                local toShooter = ray.Origin - head.Position
                local n = (toShooter.Magnitude > 0.001) and toShooter.Unit or Vector3.new(0, 1, 0)
                local pos = head.Position + n * (head.Size.Y * 0.35)

                AR2_headHits = AR2_headHits + 1
                return head, pos, n, Enum.Material.Plastic
            end
        end

        return AR2_whitelistOrig(self, ray, list, ...)
    end

    return true
end

