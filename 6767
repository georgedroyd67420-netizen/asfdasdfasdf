                local w = math.clamp(startSize.X + delta.X, MIN_W, MAX_W)
                local h = math.clamp(startSize.Y + delta.Y, MIN_H, MAX_H)
                outline.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
            end)

