        end
    end
end)

function AR2_addServerTracer(fromPos, toPos)
    if typeof(fromPos) ~= "Vector3" or typeof(toPos) ~= "Vector3" then return end

    local span = toPos - fromPos
    local len  = span.Magnitude
    if len < 0.5 or len > 5000 then return end

    local col = AR2_CFG.misc.tracerRainbow
        and Color3.fromHSV((tick() * 1000 % 360) / 360, 1, 1)
        or  Color3.fromHSV((AR2_CFG.misc.tracerHue or 0) / 360, 1, 1)
    local w = math.max(0.08, (AR2_CFG.misc.tracerWidth or 2) * 0.10)

    pcall(function()
        local pt = Instance.new("Part")
        pt.Name       = "ar2_srvtracer"
        pt.Anchored   = true
        pt.CanCollide = false
        pt.CanQuery   = false
        pt.CanTouch   = false
        pt.CastShadow = false
        pt.Material   = Enum.Material.Neon
        pt.Color      = col
        pt.Size       = Vector3.new(w, w, len)
        pt.CFrame     = CFrame.lookAt(fromPos, toPos) * CFrame.new(0, 0, -len / 2)
        pt.Parent     = AR2_Workspace

        local life = math.clamp(tonumber(AR2_CFG.misc.tracerLife) or 1.2, 0.1, 5)
        task.spawn(function()
            local steps = 14
            for i = 1, steps do
                if not pt.Parent then return end
                pcall(function() pt.Transparency = i / steps end)
                task.wait(life / steps)
            end
            pcall(function() pt:Destroy() end)
        end)
    end)
end

