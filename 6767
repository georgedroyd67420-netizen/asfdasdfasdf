function AR2_victimAtPosition(pos)
    if typeof(pos) ~= "Vector3" then return nil end

    local bestName, bestDist = nil, 12

    local function scan(folder)
        if not folder then return end
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and model ~= AR2_LocalPlayer.Character then
                local part = model:FindFirstChild("HumanoidRootPart")
                          or model:FindFirstChild("UpperTorso")
                          or model:FindFirstChild("Head")
                          or model.PrimaryPart
                if part then
                    local d = (part.Position - pos).Magnitude
                    if d < bestDist then bestDist, bestName = d, model.Name end
                end
            end
        end
    end

    scan(AR2_Workspace:FindFirstChild("Characters"))
    scan(AR2_Workspace:FindFirstChild("Zombies"))
    return bestName
end

