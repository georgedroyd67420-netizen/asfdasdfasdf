    if not char then return nil end
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("Model") and AR2_bagIsBagName(d.Name) then return d end
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and AR2_bagIsBagName(d.Name) then
            return d.Parent:IsA("Model") and d.Parent or d
        end
    end
    return nil
end

function AR2_bagHideReal(on)
    if not on then
        for part, t in pairs(AR2_bagHidden) do
            pcall(function() if part.Parent then part.Transparency = t end end)
        end
        AR2_bagHidden = {}
        return
    end
    local worn = AR2_bagFindWorn()
    if not worn then return end
    local parts = worn:IsA("BasePart") and { worn } or worn:GetDescendants()
    for _, p in ipairs(parts) do
        if p:IsA("BasePart") and AR2_bagHidden[p] == nil then
            AR2_bagHidden[p] = p.Transparency
            pcall(function() p.Transparency = 1 end)
        end
        if p:IsA("Decal") or p:IsA("Texture") then
            pcall(function() p.Transparency = 1 end)
        end
    end
end

function AR2_bagUnstick()
    local char = AR2_LocalPlayer.Character
