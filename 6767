AR2_lastPathStuds = 0
AR2_lastPathWalls = 0

function AR2_penStudsTo(origin, targetPos, ignoreList)
    local budget = tonumber(AR2_CFG.weapon.penBudget) or 5
    if AR2_CFG.weapon.penUnlimited then budget = math.huge end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.FilterDescendantsInstances = ignoreList or {}

    local total, walls = 0, 0
    local from = origin

    for _ = 1, 10 do
        local remaining = targetPos - from
        local dist = remaining.Magnitude
        if dist < 0.1 then return total, walls, true end

        local hit = AR2_Workspace:Raycast(from, remaining, params)
        if not hit then return total, walls, true end

        local entry = hit.Position
        local thick = 0.25
        pcall(function()
            local back = RaycastParams.new()
            back.FilterType = Enum.RaycastFilterType.Include
            back.FilterDescendantsInstances = { hit.Instance }
            local exit = AR2_Workspace:Raycast(targetPos, entry - targetPos, back)
            if exit then
                local t = (exit.Position - entry).Magnitude
                if t > 0 then thick = t end
            end
        end)

        total = total + thick
        walls = walls + 1
        if total > budget then return total, walls, false end

        params:AddToFilter(hit.Instance)
        from = entry + remaining.Unit * math.min(thick + 0.1, dist)
    end

    return total, walls, false
end

function AR2_rageBotVisCheck(model, part, origin)
    if not part then return false end
    local ignore = { AR2_LocalPlayer.Character, model }

    local total, walls, reached = AR2_penStudsTo(origin, part.Position, ignore)

    if not reached and AR2_CFG.magicAim.originShift then
        pcall(function()
            local dir = (part.Position - origin).Unit
            local nudge = tonumber(AR2_CFG.magicAim.originNudge) or 2
            local shifted = AR2_findBestOrigin(origin + dir * nudge, dir, part.Position, model)
            if shifted then
                local t2, w2, r2 = AR2_penStudsTo(shifted, part.Position, ignore)
                if r2 and t2 < total then total, walls, reached = t2, w2, true end
            end
        end)
    end

    AR2_lastPathStuds, AR2_lastPathWalls = total, walls
    if not reached then
        return (AR2_CFG.weapon.penUnlimited and AR2_CFG.weapon.wallbang) and true or false
    end
    if total <= 0.01 then return true end
    return (AR2_CFG.weapon.wallbang or AR2_CFG.weapon.wallbangFilter) and true or false
end


local function AR2_rageBotTarget()
    local cam    = workspace.CurrentCamera
    local rc     = AR2_CFG.rageBot
    local centre = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local best, bestPart, bestScore, bestDist = nil, nil, math.huge, 0
    local origin = AR2_localPosition()

    local Characters = workspace:FindFirstChild("Characters")
    if not Characters then return nil, nil, 0 end

    for _, model in ipairs(Characters:GetChildren()) do
        if model ~= AR2_LocalPlayer.Character and model:IsA("Model") then
            local player = AR2_Players:GetPlayerFromCharacter(model)
            if AR2_CFG.magicAim.noTeammate and player then
                if AR2_isSquadmate(player) then
                    continue
                end
            end

            local part = model:FindFirstChild("HeadCollider")
                      or model:FindFirstChild("Head")
                      or model:FindFirstChild("HumanoidRootPart")
            if part then
                local dist = (part.Position - origin).Magnitude
                if dist <= rc.maxDist then
                    if rc.visCheck and not AR2_CFG.weapon.wallbang then
                        if not AR2_rageBotVisCheck(model, part, origin) then
                            continue
                        end
                    end

                    local score
                    if rc.ignoreFov then
                        score = dist
                    else
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if not (onScreen and sp.Z > 0) then continue end
                        local px = (centre - Vector2.new(sp.X, sp.Y)).Magnitude
                        if px > rc.fov then continue end
                        score = px
                    end
                    if score < bestScore then
                        best, bestPart, bestScore, bestDist = model, part, score, dist
                    end
                end
            end
        end
    end
    return best, bestPart, bestDist
end

