AR2_morph = AR2_morph or { model = nil }

local function AR2_morphToast(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification",
            { Title = "DROIDWARE", Text = tostring(text), Duration = 4 })
    end)
end

function AR2_removeMorph()
    if AR2_morph.model then
        pcall(function() AR2_morph.model:Destroy() end)
        AR2_morph.model = nil
    end

    pcall(AR2_refreshHideState)
end

function AR2_applyMorph()
    AR2_removeMorph()

    local id = tostring(AR2_CFG.misc.morphId or ""):gsub("%D", "")
    if id == "" then AR2_morphToast("Enter a model ID first") return false end

    local char = AR2_LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then AR2_morphToast("No character") return false end


    local anchor = char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
                or char:FindFirstChild("LowerTorso")
                or hrp

    local objs
    local ok = pcall(function() objs = game:GetObjects("rbxassetid://" .. id) end)
    if not ok or type(objs) ~= "table" or #objs == 0 then
        objs = nil
        pcall(function()
            local m = game:GetService("InsertService"):LoadAsset(tonumber(id))
            if m then objs = m:GetChildren() end
        end)
    end
    if type(objs) ~= "table" or #objs == 0 then
        AR2_morphToast("Couldn't load model " .. id .. " (private or invalid?)")
        return false
    end

    local model = objs[1]
    for _, o in ipairs(objs) do if o:IsA("Model") then model = o break end end
    model.Name = "oh_morph"
    model.Parent = workspace
    pcall(function()
        if model:IsA("Model") then model:PivotTo(hrp.CFrame)
        elseif model:IsA("BasePart") then model.CFrame = hrp.CFrame end
    end)


    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid")
            or d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D")
            or d:IsA("Snap") or d:IsA("ManualWeld") then d:Destroy() end
        end
    end)

    local parts = {}
    if model:IsA("Model") then
        for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then parts[#parts+1] = d end end
    elseif model:IsA("BasePart") then parts[1] = model end
    if #parts == 0 then
        pcall(function() model:Destroy() end)
        AR2_morphToast("That asset has no parts to weld")
        return false
    end

    for _, p in ipairs(parts) do
        pcall(function()
            p.Anchored = false p.CanCollide = false p.Massless = true
            local w = Instance.new("Weld")
            w.Part0 = anchor w.Part1 = p
            w.C0 = anchor.CFrame:ToObjectSpace(p.CFrame)
            w.Parent = p
        end)
    end

    AR2_morph.model = model

    pcall(AR2_refreshHideState)
    AR2_morphToast("Morph applied (" .. #parts .. " parts)")
    return true
end

AR2_enemyMorphs    = {}
AR2_enemyMorphCache = { id = nil, template = nil }
AR2_enemyMorphConn  = nil

function AR2_enemyMorphTemplate(id)
    if AR2_enemyMorphCache.id == id and AR2_enemyMorphCache.template then
        return AR2_enemyMorphCache.template
    end

    local objs
    local ok = pcall(function() objs = game:GetObjects("rbxassetid://" .. id) end)
    if not ok or type(objs) ~= "table" or #objs == 0 then
        objs = nil
        pcall(function()
            local m = game:GetService("InsertService"):LoadAsset(tonumber(id))
            if m then objs = m:GetChildren() end
        end)
    end
    if type(objs) ~= "table" or #objs == 0 then return nil end

    local model = objs[1]
    for _, o in ipairs(objs) do if o:IsA("Model") then model = o break end end

    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid")
            or d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D")
            or d:IsA("Snap") or d:IsA("ManualWeld") then d:Destroy() end
        end
    end)

    local partCount = 0
    if model:IsA("BasePart") then
        partCount = 1
    else
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then partCount = partCount + 1 end
        end
    end

    print(string.format("[DROIDWARE MORPH] asset %s loaded as %s (%s), %d parts, %d objects",
        id, model.ClassName, model.Name, partCount, #objs))

    if partCount == 0 then
        AR2_morphToast("Asset " .. id .. " is a " .. model.ClassName .. " with no parts -- needs a Model")
        return nil
    end

    AR2_enemyMorphCache.id = id
    AR2_enemyMorphCache.template = model
    return model
end

function AR2_enemyMorphClear(model)
    local entry = AR2_enemyMorphs[model]
    if not entry then return end
    pcall(function() if entry.rig then entry.rig:Destroy() end end)
    for part, was in pairs(entry.hidden or {}) do
        pcall(function() if part.Parent then part.Transparency = was end end)
    end
    AR2_enemyMorphs[model] = nil
end

function AR2_enemyMorphClearAll()
    for model in pairs(AR2_enemyMorphs) do AR2_enemyMorphClear(model) end
    AR2_enemyMorphs = {}
end

function AR2_enemyMorphApply(model, template)
    if AR2_enemyMorphs[model] then return end

    local live = 0
    for _ in pairs(AR2_enemyMorphs) do live = live + 1 end
    if live >= (tonumber(AR2_CFG.misc.enemyMorphMax) or 6) then return end

    local anchor = model:FindFirstChild("UpperTorso")
                or model:FindFirstChild("Torso")
                or model:FindFirstChild("LowerTorso")
                or model:FindFirstChild("HumanoidRootPart")
    if not anchor then return end

    local rig = template:Clone()
    rig.Name = "ar2_enemy_morph"

    for _, d in ipairs(rig:GetDescendants()) do
        if d:IsA("Humanoid") or d:IsA("BaseScript") or d:IsA("ModuleScript")
        or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Fire")
        or d:IsA("Smoke") or d:IsA("Trail") or d:IsA("Beam")
        or d:IsA("ProximityPrompt") or d:IsA("ClickDetector")
        or d:IsA("Constraint") or d:IsA("BodyMover") or d:IsA("Light") then
            pcall(function() d:Destroy() end)
        end
    end

    pcall(function()
        if rig:IsA("Model") then rig:PivotTo(anchor.CFrame)
        elseif rig:IsA("BasePart") then rig.CFrame = anchor.CFrame end
    end)

    rig.Parent = AR2_Workspace.CurrentCamera or AR2_Workspace

    local parts = {}
    if rig:IsA("Model") then
        for _, d in ipairs(rig:GetDescendants()) do
            if d:IsA("BasePart") then parts[#parts + 1] = d end
        end
    elseif rig:IsA("BasePart") then
        parts[1] = rig
    end

    if #parts == 0 then pcall(function() rig:Destroy() end) return end

    for _, pt in ipairs(parts) do
        pcall(function()
            pt.Anchored   = true
            pt.CanCollide = false
            pt.CanQuery   = false
            pt.CanTouch   = false
            pt.Massless   = true
            pt.CastShadow = false
            if pt:IsA("MeshPart") then
                pt.RenderFidelity = Enum.RenderFidelity.Performance
            end
        end)
    end

    local cap = math.max(1, tonumber(AR2_CFG.misc.enemyMorphPartCap) or 60)
    if #parts > cap then
        for i = cap + 1, #parts do
            pcall(function() parts[i]:Destroy() end)
        end
        for i = #parts, cap + 1, -1 do parts[i] = nil end
    end


    AR2_enemyMorphApplied = (AR2_enemyMorphApplied or 0) + 1

    local hidden = {}
    if AR2_CFG.misc.enemyMorphHide and not AR2_CFG.misc.enemyMorphNoHide then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                hidden[d] = d.Transparency
                pcall(function() d.Transparency = 1 end)
            end
        end
    end

    AR2_enemyMorphs[model] = {
        rig = rig, hidden = hidden, anchor = anchor,
        visible = true, rigT = nil,
    }
end

AR2_morphHiddenRigs = {}

function AR2_morphSetRigVisible(entry, visible)
    if entry.visible == visible then return end
    entry.visible = visible

    pcall(function()
        local rig = entry.rig
        if not rig then return end
        for _, d in ipairs(rig:IsA("Model") and rig:GetDescendants() or { rig }) do
            if d:IsA("BasePart") then
                if visible then
                    d.Transparency = entry.rigT and entry.rigT[d] or 0
                else
                    entry.rigT = entry.rigT or {}
                    if entry.rigT[d] == nil then entry.rigT[d] = d.Transparency end
                    d.Transparency = 1
                end
            end
        end
    end)

    pcall(function()
        for part, orig in pairs(entry.hidden or {}) do
            if part.Parent then
                part.Transparency = visible and 1 or orig
            end
        end
    end)
end

AR2_RunService.Heartbeat:Connect(function()
    if not AR2_CFG.misc.enemyMorph then return end

    local cam = AR2_Workspace.CurrentCamera
    local eye = cam and cam.CFrame.Position
    local near = tonumber(AR2_CFG.misc.enemyMorphNear) or 18
    local far  = tonumber(AR2_CFG.misc.enemyMorphFar)  or 900

    for model, entry in pairs(AR2_enemyMorphs) do
        local rig, anchor = entry.rig, entry.anchor
        if rig and rig.Parent and anchor and anchor.Parent then
            local d = eye and (anchor.Position - eye).Magnitude or 0

            if eye and d < near then
                AR2_morphSetRigVisible(entry, false)
            elseif eye and d > far then
                AR2_morphSetRigVisible(entry, false)
            else
                AR2_morphSetRigVisible(entry, true)
                pcall(function()
                    if rig:IsA("Model") then rig:PivotTo(anchor.CFrame)
                    elseif rig:IsA("BasePart") then rig.CFrame = anchor.CFrame end
                end)
            end
        end
    end
end)

function AR2_setEnemyMorph(enabled)
    AR2_CFG.misc.enemyMorph = enabled and true or false

    if AR2_enemyMorphConn then AR2_enemyMorphConn:Disconnect() AR2_enemyMorphConn = nil end

    if not AR2_CFG.misc.enemyMorph then
        AR2_enemyMorphClearAll()
        return
    end

    task.spawn(function()
        local id = tostring(AR2_CFG.misc.enemyMorphId or ""):gsub("%D", "")
        if id == "" then
            AR2_morphToast("Enter an enemy model ID first")
            AR2_CFG.misc.enemyMorph = false
            return
        end

        local template = AR2_enemyMorphTemplate(id)
        if not template then
            AR2_morphToast("Couldn't load enemy model " .. id)
            AR2_CFG.misc.enemyMorph = false
            return
        end

        AR2_morphToast("Enemy morph on")

        AR2_enemyMorphNext = 0

        AR2_enemyMorphConn = AR2_RunService.Heartbeat:Connect(function()
            if not AR2_CFG.misc.enemyMorph then return end

            if os.clock() < (AR2_enemyMorphNext or 0) then return end
            AR2_enemyMorphNext = os.clock() + 0.25

            local folder = AR2_Workspace:FindFirstChild("Characters")
            if not folder then return end

            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") and model ~= AR2_LocalPlayer.Character then
                    pcall(AR2_enemyMorphApply, model, template)
                end
            end

            for model in pairs(AR2_enemyMorphs) do
                if not model.Parent then AR2_enemyMorphClear(model) end
            end
        end)
    end)
end

