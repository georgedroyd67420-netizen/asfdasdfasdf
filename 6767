AR2_VOLLEY_MAX = 2

AR2_volleyRateKey = {
    Semiautomatic = "SemiFireRate",
    Automatic     = "AutoFireRate",
    Burst         = "BurstFireRate",
}

AR2_volleyFcSaved   = setmetatable({}, { __mode = "k" })
AR2_volleyModeSaved = setmetatable({}, { __mode = "k" })

function AR2_volleyOuterItem()
    local ok, pc = pcall(function()
        return require(AR2_ReplicatedFirst:WaitForChild("Framework", 30)).Classes.Players.get()
    end)
    if not ok or not pc or not pc.Character then return nil end
