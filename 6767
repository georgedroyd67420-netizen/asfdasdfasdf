AR2_hookLog = {}
local function AR2_logHook(name, ok, reason)
    AR2_hookLog[name] = { ok = ok, reason = reason or "" }
    if not ok then
        warn("[DROIDWARE] Hook skipped: " .. name .. " (" .. (reason or "unknown") .. ")")
    end
end

do
    local missing = {}
    for k, v in pairs(AR2_CAP) do
        if not v then table.insert(missing, k) end
    end
    if #missing > 0 then
        table.sort(missing)
        warn("[DROIDWARE] Unsupported on this executor: " .. table.concat(missing, ", "))
    end
end



