AR2_RunService.Heartbeat:Connect(function()
    if #AR2_impactParts == 0 then return end
    local now = os.clock()
    for i = #AR2_impactParts, 1, -1 do
        local e = AR2_impactParts[i]
        local age = now - e.born
        if age >= e.life or not e.part or not e.part.Parent then
            pcall(function() if e.part then e.part:Destroy() end end)
            table.remove(AR2_impactParts, i)
        else
            local t = age / e.life
            pcall(function()
                e.part.Transparency = 0.2 + 0.8 * t
                local g = e.size * (1 + t * 1.5)
                e.part.Size = Vector3.new(g, g, g)
