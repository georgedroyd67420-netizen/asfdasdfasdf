AR2_FIRE_RATE_FIELD = {
    Semiautomatic = "SemiFireRate",
    Automatic     = "AutoFireRate",
    Burst         = "BurstFireRate",
}

local function AR2_getFireInterval(wi, wd)
    local fc = nil
    if type(wd) == "table" then fc = wd.FireConfig or wd.fireConfig end
    if not fc and type(wi) == "table" then fc = wi.FireConfig or wi.fireConfig end
    if not fc and type(wi) == "table" and type(wi.Data) == "table" then fc = wi.Data.FireConfig end
    if type(fc) ~= "table" then return 0.1 end

    local mode = nil
    pcall(function() mode = wd and wd.FireMode end)

    local field = (mode and AR2_FIRE_RATE_FIELD[mode]) or "FireRate"
    local rate = tonumber(fc[field])
    if not rate or rate <= 0 then rate = tonumber(fc.FireRate) end
    if not rate or rate <= 0 then return 0.1 end

    local interval = 60 / math.clamp(rate, 55, 1100)

    if mode == "Burst" then
        interval = interval * (tonumber(fc.BurstFireRateModifier) or 0.6)
    end

    return math.max(0.01, interval)
end

