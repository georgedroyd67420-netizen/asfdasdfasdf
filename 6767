function AR2_ignorePathParts(origin, dest, maxParts)
    local list = AR2_resolveCastIgnoreList()
    if not list then return 0 end

    local added = 0
    pcall(function()
        local myChar = AR2_LocalPlayer.Character
        local feetY = nil
        pcall(function()
            local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if hrp then feetY = hrp.Position.Y - 3.5 end
        end)

        local ignore = { myChar }
        if AR2_hbeFolder then ignore[#ignore + 1] = AR2_hbeFolder end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = ignore

        local from = origin
        for _ = 1, math.clamp(maxParts or 8, 1, 16) do
            local seg = dest - from
            if seg.Magnitude <= 0.25 then return end
            local hit = AR2_Workspace:Raycast(from, seg, rp)
            if not hit then return end

            local part = hit.Instance
            if AR2_isDamageTarget(part) then return end

            local isFloor = feetY and (part.Position.Y + part.Size.Y * 0.5) <= feetY + 1.0
            if (not isFloor) and (not AR2_serverFilterSkips(part)) then
                table.insert(list, part)
                AR2_ignoreAdded[#AR2_ignoreAdded + 1] = part
                added = added + 1
                AR2_ignoreInjected = (AR2_ignoreInjected or 0) + 1
            end

            ignore[#ignore + 1] = part
            rp.FilterDescendantsInstances = ignore
            from = hit.Position + seg.Unit * 0.05
        end
    end)
    return added
end

function AR2_releaseIgnoredParts()
    local list = AR2_castIgnoreList
    if not list or #AR2_ignoreAdded == 0 then
        AR2_ignoreAdded = {}
        return
    end
    pcall(function()
        for _, part in ipairs(AR2_ignoreAdded) do
            for i = #list, 1, -1 do
                if list[i] == part then table.remove(list, i) break end
            end
        end
    end)
    AR2_ignoreAdded = {}
end

