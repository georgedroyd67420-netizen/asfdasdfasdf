AR2_noclipConn = nil
local noclipSaved   = {}
local noclipChar    = nil
local isSitting     = false

local function noclipSetCollision(char, enabled)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            if enabled == false then
                if noclipSaved[d] == nil then noclipSaved[d] = d.CanCollide end
                d.CanCollide = false
            elseif noclipSaved[d] ~= nil then
                d.CanCollide = noclipSaved[d]
            end
        end
    end
    if enabled ~= false then noclipSaved = {} end
end

function AR2_startNoclip()
    if AR2_noclipConn then return end
    local char = AR2_LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    noclipChar  = char
    noclipSaved = {}
    isSitting   = true

    hum.PlatformStand = true

    AR2_noclipConn = AR2_RunService.Heartbeat:Connect(function(dt)
        if not AR2_CFG.misc.noclip then AR2_stopNoclip() return end

        local ch = AR2_LocalPlayer.Character
        local r  = ch and ch:FindFirstChild("HumanoidRootPart")
        local h  = ch and ch:FindFirstChild("Humanoid")
        if not r or not h then AR2_stopNoclip() return end

        if ch ~= noclipChar then
            noclipSaved = {}
            noclipChar  = ch
        end

        h.PlatformStand = true
        isSitting = true
        noclipSetCollision(ch, false)

        local UIS  = AR2_UserInputService
        local cam  = AR2_Workspace.CurrentCamera
        local move = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
            or UIS:IsKeyDown(Enum.KeyCode.RightControl)
            or UIS:IsKeyDown(Enum.KeyCode.Q)
            or UIS:IsKeyDown(Enum.KeyCode.LeftShift)
            or UIS:IsKeyDown(Enum.KeyCode.RightShift)
        then
            move -= Vector3.new(0, 1, 0)
        end

        if move.Magnitude < 0.001 then
            r.AssemblyLinearVelocity = Vector3.zero
            return
        end

        local step  = (tonumber(AR2_CFG.misc.noclipSpeed) or 90) * math.min(dt, 0.1)
        local delta = move.Unit * step

        r.CFrame = r.CFrame + delta
        r.AssemblyLinearVelocity = (dt > 0) and (delta / dt) or Vector3.zero
    end)
end

function AR2_stopNoclip()
    AR2_CFG.misc.noclip = false
    if AR2_noclipConn then AR2_noclipConn:Disconnect() AR2_noclipConn = nil end

    noclipSetCollision(noclipChar or AR2_LocalPlayer.Character, true)
    noclipChar = nil
    isSitting  = false

    local char = AR2_LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.Sit = false
            hum.PlatformStand = false
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
end

function AR2_toggleNoclip(enabled)
    if enabled and not AR2_noclipConn then
        AR2_CFG.misc.noclip = true
        AR2_startNoclip()
    elseif not enabled and AR2_noclipConn then
        AR2_stopNoclip()
        if AR2_CFG.misc.autoResume then pcall(AR2_legalResume) end
    end
end



