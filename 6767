local function AR2_gcAlive(gc)
    if type(gc) ~= "table" then return false end
    local ok, alive = pcall(function()
        local rp = rawget(gc, "RootPart")
        return rp and rp.Parent ~= nil
    end)
    return ok and alive == true
end

function AR2_resolveGameCharacter()
    if AR2_gcAlive(AR2_gameChar) then return AR2_gameChar end
    if AR2_gcAlive(AR2_noFallCharCache) then return AR2_noFallCharCache end

    local ok, pc = pcall(function()
        return require(AR2_ReplicatedFirst:WaitForChild("Framework", 30)).Classes.Players.get()
    end)
    if ok and pc and AR2_gcAlive(pc.Character) then
        AR2_noFallCharCache = pc.Character
        return pc.Character
    end

    AR2_noFallCharCache = nil
    return nil
end

function AR2_flattenFallStart(gc, rootY)
    if type(gc) ~= "table" then return end
    if not pcall(function() gc.FallingStarted = rootY end) then
        pcall(function() rawset(gc, "FallingStarted", rootY) end)
    end
end

function AR2_setNoFallDamage(enabled)
    enabled = false
    AR2_CFG.misc.noFallDamage = false
    AR2_CFG.misc.fallSoftLand = false
    AR2_CFG.misc.fallBrake    = false
    AR2_noFallEnabled = AR2_CFG.misc.noFallDamage

    if AR2_noFallConn2 then AR2_noFallConn2:Disconnect() AR2_noFallConn2 = nil end
    if not AR2_noFallEnabled then return end

    AR2_noFallConn2 = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_noFallEnabled then return end

        local char = AR2_LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local gc = AR2_resolveGameCharacter()
        if type(gc) == "table" then
            local gr = rawget(gc, "RootPart") or root
            AR2_flattenFallStart(gc, gr.Position.Y)
            pcall(function()
                if rawget(gc, "FallImpacting") ~= nil then gc.FallImpacting = false end
            end)
        end

        local cap = math.clamp(tonumber(AR2_CFG.misc.fallClamp) or 80, 10, 400)
        local v   = root.AssemblyLinearVelocity

        if v.Y >= -2 then return end

        if AR2_CFG.misc.fallSoftLand then
            local dt = AR2_RunService.Heartbeat:Wait()
            local down = -cap
            local delta = Vector3.new(v.X * dt, down * dt, v.Z * dt)

            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { AR2_LocalPlayer.Character }
            params.IgnoreWater = true

            local reach = math.abs(delta.Y) + 3
            local hit = AR2_Workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), params)

            if hit then
                local clearance = root.Size and (root.Size.Y * 0.5 + 0.2) or 2.2
                local floorY    = hit.Position.Y + clearance
                local nextY     = root.Position.Y + delta.Y

                if nextY <= floorY then
                    root.CFrame = CFrame.new(
                        root.Position.X + delta.X, floorY, root.Position.Z + delta.Z
                    ) * (root.CFrame - root.CFrame.Position)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    local gc = AR2_resolveGameCharacter()
                    if gc then pcall(AR2_flattenFallStart, gc, root.Position.Y) end
                    AR2_softFrames = 0
                    return
                end
            end

            root.CFrame = root.CFrame + delta
            root.AssemblyLinearVelocity = (dt > 0) and (delta / dt)
                or Vector3.new(v.X, down, v.Z)

            AR2_softFrames = (AR2_softFrames or 0) + 1
            return
        end

        if not AR2_CFG.misc.fallBrake then
            if v.Y < -cap then
                root.AssemblyLinearVelocity = Vector3.new(v.X, -cap, v.Z)
            end
            return
        end

        local speed = math.abs(v.Y)
        local lead  = math.clamp(tonumber(AR2_CFG.misc.fallLookAhead) or 25, 5, 120)
        local look  = math.clamp(speed * 0.35, lead, 400)

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {
            char,
            AR2_Workspace:FindFirstChild("Characters"),
            AR2_Workspace:FindFirstChild("Zombies"),
            AR2_Workspace:FindFirstChild("Effects"),
        }

        local hit = AR2_Workspace:Raycast(root.Position, Vector3.new(0, -look, 0), rp)
        if not hit then return end

        if speed > cap then
            root.AssemblyLinearVelocity = Vector3.new(v.X, -cap, v.Z)
            AR2_fallBrakes = (AR2_fallBrakes or 0) + 1
        end
    end)
end



