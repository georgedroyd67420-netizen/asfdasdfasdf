function AR2_bagIsHelper(p)
    local l = string.lower(tostring(p.Name))
    for _, w in ipairs({ "hitbox", "collision", "collide",
                         "trigger", "prompt", "weldpart" }) do
        if string.find(l, w, 1, true) then return true end
    end
    if AR2_bagHasMesh
       and not p:IsA("MeshPart")
       and not p:FindFirstChildWhichIsA("SpecialMesh")
       and not p:FindFirstChildWhichIsA("BlockMesh")
       and not p:FindFirstChildWhichIsA("Decal") then
        return true
    end
    return false
end

function AR2_bagSpawn(name)
    AR2_bagClear()

    local char = AR2_LocalPlayer.Character
    if not char then return false, "no character" end

    local anchorName = AR2_CFG.misc.bagPart or "UpperTorso"
    local anchor = char:FindFirstChild(anchorName)
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
    if not anchor then return false, "no torso to weld to" end

    local src = AR2_bagFindSource(name)
    if not src then return false, "model not found: " .. tostring(name) end

    local clone = src:Clone()

    local keep = {}
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then keep[#keep+1] = d end
    end
    for _, pt in ipairs(keep) do
        pcall(function() pt.Parent = clone end)
    end
    for _, d in ipairs(clone:GetDescendants()) do
        if not d:IsA("BasePart")
           and not d:IsA("SpecialMesh") and not d:IsA("BlockMesh")
           and not d:IsA("CylinderMesh") and not d:IsA("Decal")
           and not d:IsA("Texture") and not d:IsA("SurfaceAppearance") then
            pcall(function() d:Destroy() end)
        end
    end

    local root, bestVol = nil, -1
    for _, pt in ipairs(keep) do
        if pt.Parent then
            local v = pt.Size.X * pt.Size.Y * pt.Size.Z
            if v > bestVol then bestVol, root = v, pt end
        end
    end
    if not root then clone:Destroy() return false, "model had no parts" end

    local scale = math.clamp(tonumber(AR2_CFG.misc.bagScale) or 1, 0.1, 3)
    if math.abs(scale - 1) > 0.001 then
        local rcf = root.CFrame
        for _, pt in ipairs(keep) do
            if pt.Parent then
                local rel = rcf:Inverse() * pt.CFrame
                local rot = rel - rel.Position
                pcall(function()
                    pt.Size = pt.Size * scale
                    if pt ~= root then
                        pt.CFrame = rcf * (CFrame.new(rel.Position * scale) * rot)
                    end
                end)
                local m = pt:FindFirstChildWhichIsA("SpecialMesh")
                if m then pcall(function() m.Scale = m.Scale * scale end) end
            end
        end
    end

    AR2_bagHasMesh = false
    for _, pt in ipairs(keep) do
        if pt.Parent and (pt:IsA("MeshPart") or pt:FindFirstChildWhichIsA("SpecialMesh")) then
            AR2_bagHasMesh = true break
        end
    end
    for _, pt in ipairs(keep) do
        if pt.Parent then
            pt.Anchored   = false
            pt.CanCollide = false
            pt.Massless   = true
            pt.CanTouch   = false
            pt.CanQuery   = false
            pt.CastShadow = false
            if pt ~= root and AR2_bagIsHelper(pt) then pt.Transparency = 1 end
        end
    end

    local CAP = 40
    if #keep > CAP then
        table.sort(keep, function(x, y)
            local vx = x.Size.X * x.Size.Y * x.Size.Z
            local vy = y.Size.X * y.Size.Y * y.Size.Z
            return vx > vy
        end)
        for i = #keep, CAP + 1, -1 do
            local pt = keep[i]
            if pt ~= root then
                pcall(function() pt:Destroy() end)
                table.remove(keep, i)
            end
        end
    end

    local offset = CFrame.new(
        tonumber(AR2_CFG.misc.bagOffX) or 0,
        tonumber(AR2_CFG.misc.bagOffY) or 0,
        tonumber(AR2_CFG.misc.bagOffZ) or 0
    ) * CFrame.Angles(
        math.rad(tonumber(AR2_CFG.misc.bagPitch) or 0),
        math.rad(tonumber(AR2_CFG.misc.bagYaw)   or 0),
        math.rad(tonumber(AR2_CFG.misc.bagRoll)  or 0)
    )

    local target  = anchor.CFrame * offset
    local rootOld = root.CFrame
    for _, pt in ipairs(keep) do
        if pt.Parent and pt ~= root then
            pcall(function() pt.CFrame = target * (rootOld:Inverse() * pt.CFrame) end)
        end
    end
    pcall(function() root.CFrame = target end)

    for _, pt in ipairs(keep) do
        if pt.Parent and pt ~= root then
            local w = Instance.new("Weld")
            w.Part0, w.Part1 = root, pt
            w.C0 = root.CFrame:Inverse() * pt.CFrame
            w.Parent = root
        end
    end

    local main = Instance.new("Weld")
    main.Name, main.Part0, main.Part1 = "DroidwareBagWeld", anchor, root
    main.C0 = anchor.CFrame:Inverse() * root.CFrame
    main.Parent = root

    clone.Name = "DroidwareFakeBag"
    pcall(function() clone.PrimaryPart = root end)
    clone.Parent = char

    AR2_bagModel = clone
    return true, ("%d parts on %s"):format(#keep, anchor.Name)
end

function AR2_bagApply()
    if not AR2_CFG.misc.fakeBag then
        AR2_bagClear()
        AR2_bagHideReal(false)
        return true, "off"
    end
    AR2_bagHideReal(AR2_CFG.misc.bagHideReal)
    local name = AR2_CFG.misc.bagName
    if not name or name == "" or string.find(name, "^%(") then
        return false, "pick a bag first"
    end
    return AR2_bagSpawn(name)
end

-- PERF: every bag offset/rotation/scale slider used to call AR2_bagApply on each
-- tick, and AR2_bagApply does a full Clone() + two GetDescendants() passes + a
-- re-weld. Dragging a slider respawned the entire bag model dozens of times a
-- second. This coalesces a drag into one rebuild after the user settles.
AR2_bagPendingApply = false
function AR2_bagApplyDebounced(delay)
    if not AR2_CFG.misc.fakeBag then return end
    if AR2_bagPendingApply then return end
    AR2_bagPendingApply = true
    task.spawn(function()
        task.wait(delay or 0.12)
        AR2_bagPendingApply = false
        if AR2_CFG.misc.fakeBag then pcall(AR2_bagApply) end
    end)
end

function AR2_setFakeBag(on)
    AR2_CFG.misc.fakeBag = on and true or false

    if AR2_bagConn then AR2_bagConn:Disconnect() AR2_bagConn = nil end

    if not AR2_CFG.misc.fakeBag then
        AR2_bagClear()
        AR2_bagHideReal(false)
        return true, "off"
    end

    AR2_bagConn = AR2_LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1.5)
        if AR2_CFG.misc.fakeBag then pcall(AR2_bagApply) end
    end)

    return AR2_bagApply()
end


